import class Value from '../../src/core/value';
import fnc value_array, value_bytes, encode_graph_shape_status from '../../src/core/value';
import fnc any_rule, default_validation_options, validate_value_checked from '../../src/validation/validation';
import fnc require_true from '../../tests/assert';

pub fnc main(): void {
  val Value root = value_array(new List<Value>());
  // Candidate ownership probe: the compiler may prohibit storing this borrow.
  root.array_value.add(rt borrow root);
  require_true(encode_graph_shape_status(rt borrow root, 64, 100000) != 0,
    "self cycle cannot enter encoder");
  require_true(validate_value_checked(root, any_rule(), default_validation_options()).is_err(),
    "self cycle cannot pass checked validation");
  stdio.stdout.println("graph ownership self-cycle runtime refusal");
  return;
}
