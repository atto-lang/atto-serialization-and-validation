import class Value from '../../src/core/value';
import fnc value_array, value_bytes, encode_graph_shape_status from '../../src/core/value';
import fnc any_rule, default_validation_options, validate_value_checked from '../../src/validation/validation';
import fnc require_true from '../../tests/assert';

pub fnc main(): void {
  val Value left = value_array(new List<Value>());
  val Value right = value_array(new List<Value>());
  // Candidate ownership probe: storing a borrowed reference may be illegal.
  left.array_value.add(rt borrow right);
  right.array_value.add(rt borrow left);
  require_true(encode_graph_shape_status(rt borrow left, 64, 100000) != 0,
    "mutual cycle cannot enter encoder");
  require_true(validate_value_checked(left, any_rule(), default_validation_options()).is_err(),
    "mutual cycle cannot pass checked validation");
  stdio.stdout.println("graph ownership mutual-cycle runtime refusal");
  return;
}
