import fnc byte_list_valid, byte_range_fits from '../core/bytes';

// Native Protocol Buffers wire codec.
//
// This layer intentionally operates on numbered wire fields rather than
// inventing JSON-like names without a descriptor. Generated typed codecs can
// dispatch these fields directly into Oreslang classes/structs. Unknown varints
// retain their exact raw bytes, including uint64 values above signed int max.

pub define class ProtoField as
  pub val int field_number;
  pub val int wire_type;

  // Wire type 0 may exceed Oreslang signed int. When varint_fits_int is false,
  // payload retains the exact raw varint bytes for unknown-field preservation.
  pub val bool varint_fits_int;
  pub val int varint_value;

  // Wire type 0: exact raw varint bytes when decoded.
  // Wire types 1/5: exact fixed-width little-endian bytes.
  // Wire type 2: exact content bytes without the length prefix.
  pub val List<int> payload;
end

pub define class ProtoMessage as
  pub val List<ProtoField> fields;
end

pub define class ProtoDecodeOptions as
  pub val int max_input_bytes;
  pub val int max_fields;
  pub val int max_length_delimited_bytes;
end

pub define class ProtoEncodeOptions as
  pub val int max_output_bytes;
end

pub define class ProtoError as
  pub val String code;
  pub val int offset;
  pub val String message;
end

define class ProtoCursor as
  pub val List<int> input;
  pub val ProtoDecodeOptions options;
  pub let int index;
  pub let bool failed;
  pub let ProtoError error;
end

define class ProtoWriter as
  pub let List<int> output;
  pub val ProtoEncodeOptions options;
  pub let bool failed;
  pub let ProtoError error;
end

define class VarintRead as
  pub val bool ok;
  pub val bool fits_int;
  pub val int value;
  pub val List<int> bytes;
end

pub fnc default_proto_decode_options(): ProtoDecodeOptions {
  return new ProtoDecodeOptions(
    16 * 1024 * 1024,
    65536,
    16 * 1024 * 1024
  );
}

pub fnc default_proto_encode_options(): ProtoEncodeOptions {
  return new ProtoEncodeOptions(16 * 1024 * 1024);
}

pub fnc proto_decode_options_valid(ProtoDecodeOptions options): bool {
  return options.max_input_bytes >= 0 &&
         options.max_input_bytes <= 256 * 1024 * 1024 &&
         options.max_fields >= 0 &&
         options.max_fields <= 1000000 &&
         options.max_length_delimited_bytes >= 0 &&
         options.max_length_delimited_bytes <= 256 * 1024 * 1024;
}

pub fnc proto_encode_options_valid(ProtoEncodeOptions options): bool {
  return options.max_output_bytes >= 0 &&
         options.max_output_bytes <= 256 * 1024 * 1024;
}

// Constructors snapshot primitive byte payloads. A pub val List<int> is not a
// deep-freeze guarantee: callers must still avoid mutation or sharing without
// the compiler's owned/frozen-value proof.
fnc snapshot_proto_bytes(List<int> bytes): List<int> {
  val List<int> snapshot = new List<int>();
  for const byte of bytes do
    snapshot.add(byte);
  done
  return snapshot;
}

// A descriptor/code generator must reject the Protobuf implementation-reserved
// tag range. The untyped wire reader intentionally accepts and preserves those
// numbers as unknown data (they are syntactically valid on the wire).
pub fnc proto_descriptor_field_number_valid(int field_number): bool {
  return field_number > 0 &&
         field_number <= 536870911 &&
         (field_number < 19000 || field_number > 19999);
}

pub fnc proto_varint(int field_number, int value): ProtoField {
  return new ProtoField(field_number, 0, true, value, new List<int>());
}

pub fnc proto_raw_varint(int field_number, List<int> bytes): ProtoField {
  return new ProtoField(field_number, 0, false, 0, snapshot_proto_bytes(bytes));
}

pub fnc proto_fixed64(int field_number, List<int> bytes): ProtoField {
  return new ProtoField(field_number, 1, false, 0, snapshot_proto_bytes(bytes));
}

pub fnc proto_bytes(int field_number, List<int> bytes): ProtoField {
  return new ProtoField(field_number, 2, false, 0, snapshot_proto_bytes(bytes));
}

pub fnc proto_fixed32(int field_number, List<int> bytes): ProtoField {
  return new ProtoField(field_number, 5, false, 0, snapshot_proto_bytes(bytes));
}

fnc empty_error(): ProtoError {
  return new ProtoError("", 0, "");
}

fnc cursor_fail(
  ProtoCursor mut cursor,
  String code,
  String message
): void {
  if cursor.failed then
    return;
  fi
  cursor.failed = true;
  cursor.error = new ProtoError(code, cursor.index, message);
  return;
}

fnc writer_fail(
  ProtoWriter mut writer,
  String code,
  String message
): void {
  if writer.failed then
    return;
  fi
  writer.failed = true;
  writer.error = new ProtoError(code, writer.output.length, message);
  return;
}

fnc read_u8(ProtoCursor mut cursor): int {
  if cursor.index >= cursor.input.length then
    cursor_fail(cursor, "unexpected_eof", "truncated Protobuf message");
    return 0;
  fi

  let int byte = cursor.input[cursor.index];
  if byte < 0 || byte > 255 then
    cursor_fail(cursor, "invalid_byte", "Protobuf input bytes must be 0..255");
    return 0;
  fi

  cursor.index = cursor.index + 1;
  return byte;
}

fnc read_varint(ProtoCursor mut cursor): VarintRead {
  val List<int> bytes = new List<int>();
  let int value = 0;
  let int multiplier = 1;
  let bool fits_int = true;
  let int count = 0;

  loop do
    if count >= 10 then
      cursor_fail(cursor, "varint_overflow", "Protobuf varint exceeds 10 bytes");
      return new VarintRead(false, false, 0, bytes);
    fi

    let int byte = read_u8(cursor);
    if cursor.failed then
      return new VarintRead(false, false, 0, bytes);
    fi

    bytes.add(byte);
    let int payload = byte - ((byte / 128) * 128);

    if count < 9 && fits_int then
      value = value + (payload * multiplier);
      if count < 8 then
        multiplier = multiplier * 128;
      fi
    else
      fits_int = false;
    fi

    count = count + 1;

    if byte < 128 then
      if count == 10 && byte > 1 then
        cursor_fail(cursor, "varint_overflow", "Protobuf uint64 varint overflow");
        return new VarintRead(false, false, 0, bytes);
      fi
      return new VarintRead(true, fits_int, value, bytes);
    fi

    if count == 10 then
      cursor_fail(cursor, "varint_overflow", "Protobuf varint continuation exceeds 10 bytes");
      return new VarintRead(false, false, 0, bytes);
    fi
  done

  return new VarintRead(false, false, 0, bytes);
}

fnc raw_varint_is_valid(List<int> bytes): bool {
  if bytes.length == 0 || bytes.length > 10 then
    return false;
  fi

  let int i = 0;
  loop do
    if i >= bytes.length then
      break;
    fi

    let int byte = bytes[i];
    if byte < 0 || byte > 255 then
      return false;
    fi

    let bool last = i == bytes.length - 1;
    if last then
      if byte >= 128 then
        return false;
      fi
      if bytes.length == 10 && byte > 1 then
        return false;
      fi
    else
      if byte < 128 then
        return false;
      fi
    fi

    i = i + 1;
  done

  return true;
}

// The public ProtoField constructor can supply BOTH a signed integer and raw
// bytes. Bind them before validation/encoding so consumers cannot observe one
// value while the wire carries another. raw_varint_is_valid must run first.
// A 10-byte raw encoding is opaque even when its numeric value is small:
// read_varint marks such input as not fitting the signed-int representation.
fnc raw_varint_matches_declared_int(ProtoField field): bool {
  if !field.varint_fits_int then
    return true;
  fi
  if field.varint_value < 0 || field.payload.length > 9 then
    return false;
  fi

  let int decoded = 0;
  let int multiplier = 1;
  let int index = 0;
  for const byte of field.payload do
    val int part = byte - ((byte / 128) * 128);
    decoded = decoded + part * multiplier;
    if index < 8 then
      multiplier = multiplier * 128;
    fi
    index = index + 1;
  done
  return decoded == field.varint_value;
}

fnc read_payload(
  ProtoCursor mut cursor,
  int length,
  int limit,
  String code
): List<int> {
  val List<int> output = new List<int>();

  if length < 0 then
    cursor_fail(cursor, "invalid_length", "negative Protobuf length");
    return output;
  fi

  if length > limit then
    cursor_fail(cursor, code, "Protobuf payload exceeds configured limit");
    return output;
  fi

  if !byte_range_fits(cursor.input.length, cursor.index, length) then
    cursor_fail(cursor, "unexpected_eof", "truncated Protobuf field payload");
    return output;
  fi

  let int i = 0;
  loop do
    if i >= length then
      break;
    fi
    output.add(cursor.input[cursor.index + i]);
    i = i + 1;
  done

  cursor.index = cursor.index + length;
  return output;
}

pub fnc decode_message(
  List<int> input,
  ProtoDecodeOptions options
): Result<ProtoMessage, ProtoError> {
  if !proto_decode_options_valid(options) then
    return Err(new ProtoError("invalid_options", 0, "invalid or unsafe Protobuf decode options"));
  fi

  if input.length > options.max_input_bytes then
    return Err(new ProtoError("input_limit", 0, "Protobuf input exceeds max_input_bytes"));
  fi

  if !byte_list_valid(input) then
    return Err(new ProtoError("invalid_byte", 0, "Protobuf input values must all be bytes 0..255"));
  fi

  let ProtoCursor cursor = new ProtoCursor(
    input,
    options,
    0,
    false,
    empty_error()
  );

  val List<ProtoField> fields = new List<ProtoField>();

  loop do
    if cursor.index >= input.length then
      break;
    fi

    if fields.length >= options.max_fields then
      return Err(new ProtoError("field_limit", cursor.index, "Protobuf message exceeds max_fields"));
    fi

    let VarintRead key = read_varint(cursor);
    if cursor.failed || !key.ok then
      return Err(cursor.error);
    fi
    if !key.fits_int then
      return Err(new ProtoError("field_key_range", cursor.index, "Protobuf field key exceeds signed int range"));
    fi

    let int field_number = key.value / 8;
    let int wire_type = key.value - (field_number * 8);

    if field_number <= 0 || field_number > 536870911 then
      return Err(new ProtoError("field_number", cursor.index, "invalid Protobuf field number"));
    fi

    if wire_type == 0 then
      let VarintRead value = read_varint(cursor);
      if cursor.failed || !value.ok then
        return Err(cursor.error);
      fi
      fields.add(
        new ProtoField(
          field_number,
          0,
          value.fits_int,
          value.value,
          value.bytes
        )
      );
    elseif wire_type == 1 then
      let List<int> payload = read_payload(cursor, 8, 8, "fixed64_length");
      if cursor.failed then
        return Err(cursor.error);
      fi
      fields.add(new ProtoField(field_number, 1, false, 0, payload));
    elseif wire_type == 2 then
      let VarintRead length = read_varint(cursor);
      if cursor.failed || !length.ok then
        return Err(cursor.error);
      fi
      if !length.fits_int then
        return Err(new ProtoError("length_range", cursor.index, "Protobuf length exceeds signed int range"));
      fi

      let List<int> payload = read_payload(
        cursor,
        length.value,
        options.max_length_delimited_bytes,
        "length_limit"
      );
      if cursor.failed then
        return Err(cursor.error);
      fi
      fields.add(new ProtoField(field_number, 2, false, 0, payload));
    elseif wire_type == 5 then
      let List<int> payload = read_payload(cursor, 4, 4, "fixed32_length");
      if cursor.failed then
        return Err(cursor.error);
      fi
      fields.add(new ProtoField(field_number, 5, false, 0, payload));
    else
      return Err(
        new ProtoError(
          "wire_type",
          cursor.index,
          "unsupported or invalid Protobuf wire type; groups are intentionally rejected"
        )
      );
    fi
  done

  return Ok(new ProtoMessage(fields));
}

fnc append_byte(
  ProtoWriter mut writer,
  int byte
): void {
  if writer.failed then
    return;
  fi

  if byte < 0 || byte > 255 then
    writer_fail(writer, "invalid_byte", "internal Protobuf byte outside 0..255");
    return;
  fi

  if writer.output.length >= writer.options.max_output_bytes then
    writer_fail(writer, "output_limit", "Protobuf output exceeds max_output_bytes");
    return;
  fi

  writer.output.add(byte);
  return;
}

fnc append_varint(
  ProtoWriter mut writer,
  int value
): void {
  if value < 0 then
    writer_fail(
      writer,
      "negative_varint",
      "baseline raw Protobuf varint encoder requires a non-negative value"
    );
    return;
  fi

  let int remaining = value;

  loop do
    if remaining < 128 then
      append_byte(writer, remaining);
      break;
    fi

    append_byte(writer, (remaining - ((remaining / 128) * 128)) + 128);
    remaining = remaining / 128;
  done

  return;
}

fnc append_payload(
  ProtoWriter mut writer,
  List<int> payload
): void {
  if writer.failed then
    return;
  fi

  // Refuse oversized or malformed buffers before copying *any* payload bytes.
  // The subtraction avoids an output-length addition overflow.
  if payload.length > writer.options.max_output_bytes - writer.output.length then
    writer_fail(writer, "output_limit", "Protobuf payload exceeds remaining output budget");
    return;
  fi
  if !byte_list_valid(payload) then
    writer_fail(writer, "invalid_byte", "Protobuf payload contains a non-byte value");
    return;
  fi

  for const byte of payload do
    append_byte(writer, byte);
    if writer.failed then
      return;
    fi
  done
  return;
}

fnc valid_field_number(int field_number): bool {
  return field_number > 0 && field_number <= 536870911;
}

// Report-only syntax check for descriptor-independent field envelopes. This
// does not validate a typed Protobuf schema or produce a Zorde Valid<T> proof.
pub fnc proto_wire_field_valid(ProtoField field): bool {
  if !valid_field_number(field.field_number) then
    return false;
  fi

  if field.wire_type == 0 then
    if field.payload.length > 0 then
      return raw_varint_is_valid(field.payload) &&
             raw_varint_matches_declared_int(field);
    fi
    return field.varint_fits_int && field.varint_value >= 0;
  fi

  if field.wire_type == 1 then
    return field.payload.length == 8 && byte_list_valid(field.payload);
  fi
  if field.wire_type == 2 then
    return byte_list_valid(field.payload);
  fi
  if field.wire_type == 5 then
    return field.payload.length == 4 && byte_list_valid(field.payload);
  fi

  return false;
}

// Exact size of an unsigned integer's canonical Protobuf varint form.
// This is a byte-count helper, not a lossy conversion to another number type.
pub fnc proto_unsigned_varint_size(int value): int {
  if value < 0 then
    return -1;
  fi

  let int remaining = value;
  let int count = 1;
  loop do
    if remaining < 128 then
      break;
    fi
    remaining = remaining / 128;
    count = count + 1;
  done
  return count;
}

// Count the actual wire-value payload bytes even for a constructed logical
// signed varint whose raw payload list is empty. Used by bounded Zorde checks.
pub fnc proto_field_payload_wire_bytes(ProtoField field): int {
  if field.wire_type != 0 || field.payload.length > 0 then
    return field.payload.length;
  fi
  if !field.varint_fits_int || field.varint_value < 0 then
    return -1;
  fi

  return proto_unsigned_varint_size(field.varint_value);
}

// Exact bytes produced when re-encoding this field: canonical key and type-2
// length prefixes, but preserved raw varint *values* (including nonminimal
// encodings) remain byte-for-byte as stored. The decoder discards the original
// key/length prefixes, so this cannot attest original input size or signatures.
pub fnc proto_field_reencoded_wire_bytes(ProtoField field): int {
  if !proto_wire_field_valid(field) then
    return -1;
  fi

  val int key_bytes = proto_unsigned_varint_size(
    field.field_number * 8 + field.wire_type
  );
  val int value_bytes = proto_field_payload_wire_bytes(field);
  if key_bytes < 0 || value_bytes < 0 then
    return -1;
  fi

  if field.wire_type == 2 then
    val int length_bytes = proto_unsigned_varint_size(value_bytes);
    return key_bytes + length_bytes + value_bytes;
  fi
  return key_bytes + value_bytes;
}

fnc encode_field(
  ProtoWriter mut writer,
  ProtoField field
): void {
  if !valid_field_number(field.field_number) then
    writer_fail(writer, "field_number", "invalid Protobuf field number");
    return;
  fi

  if field.wire_type != 0 &&
     field.wire_type != 1 &&
     field.wire_type != 2 &&
     field.wire_type != 5 then
    writer_fail(writer, "wire_type", "unsupported Protobuf wire type");
    return;
  fi

  append_varint(writer, (field.field_number * 8) + field.wire_type);
  if writer.failed then
    return;
  fi

  if field.wire_type == 0 then
    if field.payload.length > 0 then
      if !raw_varint_is_valid(field.payload) ||
         !raw_varint_matches_declared_int(field) then
        writer_fail(writer, "varint_payload", "raw Protobuf varint bytes or declared integer are inconsistent");
        return;
      fi
      append_payload(writer, field.payload);
      return;
    fi

    if !field.varint_fits_int then
      writer_fail(writer, "varint_range", "wire type 0 requires an int value or preserved raw bytes");
      return;
    fi

    append_varint(writer, field.varint_value);
    return;
  fi

  if field.wire_type == 1 then
    if field.payload.length != 8 then
      writer_fail(writer, "fixed64_length", "wire type 1 payload must contain exactly 8 bytes");
      return;
    fi
    append_payload(writer, field.payload);
    return;
  fi

  if field.wire_type == 2 then
    append_varint(writer, field.payload.length);
    append_payload(writer, field.payload);
    return;
  fi

  if field.payload.length != 4 then
    writer_fail(writer, "fixed32_length", "wire type 5 payload must contain exactly 4 bytes");
    return;
  fi
  append_payload(writer, field.payload);
  return;
}

pub fnc encode_message(
  ProtoMessage message,
  ProtoEncodeOptions options
): Result<List<int>, ProtoError> {
  if !proto_encode_options_valid(options) then
    return Err(new ProtoError("invalid_options", 0, "invalid or unsafe Protobuf encode options"));
  fi

  let ProtoWriter writer = new ProtoWriter(
    new List<int>(),
    options,
    false,
    empty_error()
  );

  for const field of message.fields do
    encode_field(writer, field);
    if writer.failed then
      return Err(writer.error);
    fi
  done

  return Ok(writer.output);
}

// Flat field snapshot for a caller-owned projection. It copies the payload
// byte list, not any transitive guest/actor state, and does NOT yield an
// immutable compiler-issued Valid<T> witness.
pub fnc proto_field_snapshot(ProtoField field): ProtoField {
  return new ProtoField(
    field.field_number,
    field.wire_type,
    field.varint_fits_int,
    field.varint_value,
    snapshot_proto_bytes(field.payload)
  );
}


// Bounded independent field-list/payload copy for a caller-owned projection.
// A copy is NOT an immutable, atomic, compiler-authenticated Zorde proof.
// Callers must hold exclusive access during the copy and must not re-use
// validation results after either mutable copy is subsequently changed.
pub fnc proto_message_copy_bounded(
  ProtoMessage message,
  ProtoDecodeOptions options
): Result<ProtoMessage, ProtoError> {
  if !proto_decode_options_valid(options) then
    return Err(new ProtoError("invalid_options", 0,
      "invalid options for Protobuf message copy"));
  fi
  if message.fields.length > options.max_fields ||
     message.fields.length > options.max_input_bytes then
    return Err(new ProtoError("field_limit", 0,
      "Protobuf field list exceeds copy limits"));
  fi

  val List<ProtoField> copy = new List<ProtoField>();
  let int used_bytes = 0;
  for const field of message.fields do
    val int remaining_bytes = options.max_input_bytes - used_bytes;
    // Check cheap lengths before any per-byte shape scan or allocation.
    // Even an otherwise-valid raw payload requires at least one tag byte.
    // Reject payload==remaining in O(1), before inspecting/copying bytes.
    if field.payload.length >= remaining_bytes then
      return Err(new ProtoError("input_limit", 0,
        "Protobuf field payload exceeds remaining copy byte budget"));
    fi
    if field.wire_type == 2 &&
       field.payload.length > options.max_length_delimited_bytes then
      return Err(new ProtoError("length_limit", 0,
        "Protobuf length-delimited field exceeds copy budget"));
    fi
    // Snapshot first, then validate the bytes that will actually be returned.
    // Source-only validation followed by a copy could accept mutated bytes.
    // A coherent multi-field snapshot still requires exclusive ownership.
    val ProtoField detached = proto_field_snapshot(field);
    if detached.payload.length >= remaining_bytes then
      return Err(new ProtoError("input_limit", 0,
        "Protobuf copied payload leaves no space for field key"));
    fi
    if detached.wire_type == 2 &&
       detached.payload.length > options.max_length_delimited_bytes then
      return Err(new ProtoError("length_limit", 0,
        "Protobuf copied length-delimited payload exceeds budget"));
    fi
    val int wire_bytes = proto_field_reencoded_wire_bytes(detached);
    if wire_bytes < 0 then
      return Err(new ProtoError("invalid_field", 0,
        "Protobuf detached message copy refuses malformed field"));
    fi
    if wire_bytes > remaining_bytes then
      return Err(new ProtoError("input_limit", 0,
        "Protobuf field tag or length prefix exceeds copy byte budget"));
    fi
    copy.add(detached);
    used_bytes = used_bytes + wire_bytes;
  done
  return Ok(new ProtoMessage(copy));
}

pub fnc fields_with_number(
  ProtoMessage message,
  int field_number
): List<ProtoField> {
  val List<ProtoField> fields = new List<ProtoField>();

  for const field of message.fields do
    if field.field_number == field_number then
      fields.add(proto_field_snapshot(field));
    fi
  done

  return fields;
}
