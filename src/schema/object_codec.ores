// Metadata-driven JSON object decode.
//
// This is the generic bridge between wire bytes and generated typed
// constructors. It resolves wire names, validates required/unknown fields, runs
// shared ValueRule validation, and returns an object Value keyed by source
// field names. Generated class/struct codecs can then construct concrete values
// with direct field writes and no reflection.

import class Value, Utf8Text, WireMember from '../core/value';
import fnc value_object from '../core/value';
import class DecodeOptions, DecodeError, DecodeAttempt from '../core/options';
import fnc decode_attempt from '../json/json';
import class ValidationOptions, ValidationReport, ValidationError, PathSegment, FieldRule, ObjectSchema from '../validation/validation';
import fnc field_rule, object_schema, validate_object, report_is_valid from '../validation/validation';
import class CodecFieldMeta, CodecTypeMeta, MetadataError, MetadataCheck from './metadata';
import fnc check_metadata, field_by_wire_name from './metadata';

pub define class ObjectCodecError as
  // kind: 0 metadata, 1 decode, 2 validation.
  pub val int kind;
  pub val MetadataError metadata_error;
  pub val DecodeError decode_error;
  pub val ValidationReport validation_report;
end

pub define class DecodedObject as
  pub val Value source_object;
  pub val Value wire_object;
  pub val Value unknown_object;
  pub val int consumed;
end

pub define class ObjectDecodeAttempt as
  // status: 0 ready, 1 metadata failure, 2 decode failure, 3 validation failure.
  pub val int status;
  pub val DecodedObject decoded;
  pub val ObjectCodecError error;
end

fnc empty_metadata_error(): MetadataError {
  return new MetadataError("", -1, "");
}

fnc empty_decode_error(): DecodeError {
  return new DecodeError("", 0, "");
}

fnc empty_validation_report(): ValidationReport {
  return new ValidationReport(new List<ValidationError>(), false);
}

fnc metadata_schema(CodecTypeMeta metadata): ObjectSchema {
  val List<FieldRule> fields = new List<FieldRule>();
  for const field of metadata.fields do
    fields.push(field_rule(
      field.wire_name,
      field.required,
      false,
      field.validation
    ));
  done
  return object_schema(fields, metadata.unknown_field_policy == 1);
}

fnc source_object(Value wire_object, CodecTypeMeta metadata): Value {
  val List<WireMember> output = new List<WireMember>();
  for const member of wire_object.object_value do
    let Result<CodecFieldMeta, MetadataError> selected = field_by_wire_name(
      rt borrow metadata,
      rt borrow member.key
    );
    if selected.is_err() then
      continue;
    fi
    let CodecFieldMeta field = selected.unwrap();
    output.push(new WireMember(field.source_name, member.value));
  done
  return value_object(output);
}

fnc unknown_object(Value wire_object, CodecTypeMeta metadata): Value {
  val List<WireMember> output = new List<WireMember>();
  if metadata.unknown_field_policy != 2 then
    return value_object(output);
  fi
  for const member of wire_object.object_value do
    let Result<CodecFieldMeta, MetadataError> selected = field_by_wire_name(
      rt borrow metadata,
      rt borrow member.key
    );
    if selected.is_err() then
      output.add(member);
    fi
  done
  return value_object(output);
}

fnc empty_decoded_object(): DecodedObject {
  return new DecodedObject(
    value_object(new List<WireMember>()),
    value_object(new List<WireMember>()),
    value_object(new List<WireMember>()),
    0
  );
}

fnc object_codec_error(
  int kind,
  MetadataError metadata_error,
  DecodeError decode_error,
  ValidationReport validation_report
): ObjectCodecError {
  return new ObjectCodecError(kind, metadata_error, decode_error, validation_report);
}

pub fnc decode_json_object_attempt(
  List<int> input,
  DecodeOptions decode_options,
  CodecTypeMeta metadata,
  ValidationOptions validation_options
): ObjectDecodeAttempt {
  let MetadataCheck checked = check_metadata(rt borrow metadata);

  if !checked.ok then
    let ObjectCodecError error = object_codec_error(
      0,
      checked.error,
      empty_decode_error(),
      empty_validation_report()
    );
    return new ObjectDecodeAttempt(1, empty_decoded_object(), error);
  fi

  // This is a schema-admission boundary, not a generic JSON decoder.
  // Duplicate-key first/last-wins discards conflicting input before field
  // validation; allowing trailing bytes admits a valid prefix as a message.
  // Keep these options for generic decoding, but fail closed for typed objects.
  if decode_options.duplicate_key_policy != 0 ||
     decode_options.allow_trailing_data then
    let ObjectCodecError error = object_codec_error(
      1,
      empty_metadata_error(),
      new DecodeError(
        "unsafe_decode_options",
        0,
        "metadata-driven object decode requires duplicate-key rejection and complete input"
      ),
      empty_validation_report()
    );
    return new ObjectDecodeAttempt(2, empty_decoded_object(), error);
  fi

  let DecodeAttempt attempt = decode_attempt(input, decode_options);
  if attempt.status != 0 then
    let ObjectCodecError error = object_codec_error(
      1,
      empty_metadata_error(),
      attempt.error,
      empty_validation_report()
    );
    return new ObjectDecodeAttempt(2, empty_decoded_object(), error);
  fi

  if attempt.value.kind != 6 then
    let ValidationReport report = new ValidationReport(
      new List<ValidationError>(
        new ValidationError(
          "type",
          new List<PathSegment>(),
          "metadata-driven JSON decode requires an object root",
          0
        )
      ),
      false
    );
    let ObjectCodecError error = object_codec_error(
      2,
      empty_metadata_error(),
      empty_decode_error(),
      report
    );
    return new ObjectDecodeAttempt(3, empty_decoded_object(), error);
  fi

  let ObjectSchema schema = metadata_schema(rt borrow metadata);
  let ValidationReport report = validate_object(
    rt borrow attempt.value,
    schema,
    validation_options
  );

  if !report_is_valid(rt borrow report) then
    let ObjectCodecError error = object_codec_error(
      2,
      empty_metadata_error(),
      empty_decode_error(),
      report
    );
    return new ObjectDecodeAttempt(3, empty_decoded_object(), error);
  fi

  // Projection helpers observe the decoded wire object and metadata. Build both
  // projections before transferring the wire object into the final carrier.
  let Value source = source_object(rt borrow attempt.value, rt borrow metadata);
  let Value unknown = unknown_object(rt borrow attempt.value, rt borrow metadata);
  let DecodedObject decoded = new DecodedObject(
    source,
    attempt.value,
    unknown,
    attempt.consumed
  );

  return new ObjectDecodeAttempt(
    0,
    decoded,
    object_codec_error(
      0,
      empty_metadata_error(),
      empty_decode_error(),
      empty_validation_report()
    )
  );
}

pub fnc decode_json_object(
  List<int> input,
  DecodeOptions decode_options,
  CodecTypeMeta metadata,
  ValidationOptions validation_options
): Result<DecodedObject, ObjectCodecError> {
  let ObjectDecodeAttempt attempt = decode_json_object_attempt(
    input,
    decode_options,
    metadata,
    validation_options
  );
  if attempt.status == 0 then
    return Ok(attempt.decoded);
  fi
  return Err(attempt.error);
}


// Closed, scalar JSON-record admission for deterministic AI-provider responses.
//
// This v1 profile deliberately supports only bool, JSON-number lexemes, and
// UTF-8 strings. It does not certify an AttoLang nominal type, an i64 numeric
// range, nested records, array element types, enums or Option/null semantics.
// The result is an ordinary diagnostic dynamic Value, NOT Valid<T>.
// Generated typed construction must remain a separate compiler-owned gate.
pub fnc ai_scalar_decode_options(): DecodeOptions {
  return new DecodeOptions(
    0, false, 16, 65536, 16384, 0, 1024, 256, 256
  );
}

fnc ai_schema_failure(String code, int index, String message): ObjectDecodeAttempt {
  return new ObjectDecodeAttempt(
    1,
    empty_decoded_object(),
    object_codec_error(
      0,
      new MetadataError(code, index, message),
      empty_decode_error(),
      empty_validation_report()
    )
  );
}

fnc ai_options_failure(String code, String message): ObjectDecodeAttempt {
  return new ObjectDecodeAttempt(
    2,
    empty_decoded_object(),
    object_codec_error(
      1,
      empty_metadata_error(),
      new DecodeError(code, 0, message),
      empty_validation_report()
    )
  );
}

pub fnc decode_ai_scalar_record_attempt(
  List<int> input,
  DecodeOptions decode_options,
  CodecTypeMeta metadata,
  ValidationOptions validation_options
): ObjectDecodeAttempt {
  // Reuse the bounded, duplicate-aware metadata validation. Do not iterate
  // untrusted fields until its name/field limits have been enforced.
  val MetadataCheck checked = check_metadata(rt borrow metadata);
  if !checked.ok then
    return ai_schema_failure(
      checked.error.code,
      checked.error.field_index,
      checked.error.message
    );
  fi

  // AI structured output is a closed-record contract. A metadata profile
  // that ignores or preserves unknown keys could discard model mistakes.
  if metadata.unknown_field_policy != 1 then
    return ai_schema_failure(
      "ai_open_schema", -1,
      "AI scalar output requires unknown-field rejection"
    );
  fi

  let int index = 0;
  for const field of metadata.fields do
    let int kind = field.validation.expected_kind;
    if kind != 1 && kind != 2 && kind != 3 then
      return ai_schema_failure(
        "ai_unsupported_kind", index,
        "v1 requires explicitly typed bool, number or string fields"
      );
    fi
    index = index + 1;
  done

  // Product-specific tight budgets, not the generic codec's 256 MiB ceiling.
  // Refuse invalid/overly permissive configurations before parsing input.
  if !decode_options_valid(rt borrow decode_options) ||
     decode_options.max_depth > 16 ||
     decode_options.max_input_bytes > 65536 ||
     decode_options.max_string_bytes > 16384 ||
     decode_options.max_binary_bytes > 65536 ||
     decode_options.max_number_bytes > 1024 ||
     decode_options.max_array_entries > 256 ||
     decode_options.max_map_entries > 256 then
    return ai_options_failure(
      "ai_limits",
      "AI scalar output exceeds the bounded decode profile"
    );
  fi

  // The shared schema-bound decoder already rejects duplicate-key
  // first/last-wins, trailing data, malformed UTF-8 and failed field rules.
  return decode_json_object_attempt(
    input,
    decode_options,
    metadata,
    validation_options
  );
}

pub fnc decode_ai_scalar_record(
  List<int> input,
  DecodeOptions decode_options,
  CodecTypeMeta metadata,
  ValidationOptions validation_options
): Result<DecodedObject, ObjectCodecError> {
  val ObjectDecodeAttempt attempt = decode_ai_scalar_record_attempt(
    input,
    decode_options,
    metadata,
    validation_options
  );
  if attempt.status == 0 then
    return Ok(attempt.decoded);
  fi
  return Err(attempt.error);
}
