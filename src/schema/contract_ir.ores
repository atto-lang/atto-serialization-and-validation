// Static, bounded schema Contract IR consumed by generated codec adapters.
//
// This is ordinary immutable-by-default AttoLang data, not a capability. The
// SHA-256 identifiers are generated by the pinned build-time TJSV Contract IR
// tool. This module validates their shape and binds the three peer/source lanes
// to the closed object codec; it does not authenticate an untrusted producer
// or recompute SHA-256. Only a trusted build/loader may publish this metadata.

import class Utf8Text from '../core/value';
import fnc utf8_is_valid from '../core/utf8';
import class CodecTypeMeta, MetadataError, MetadataCheck from './metadata';
import fnc check_metadata from './metadata';
import class DecodeOptions, DecodeError, ValidationOptions from '../core/options';
import class ValidationReport, ValidationError from '../validation/validation';
import class ObjectDecodeAttempt, ObjectCodecError, DecodedObject from './object_codec';
import fnc decode_json_object_attempt from './object_codec';
import class Value, WireMember from '../core/value';
import fnc value_object from '../core/value';

pub define class StaticContractIR as
  pub val int version;
  pub val Utf8Text schema_id;
  pub val Utf8Text ir_digest;
  pub val Utf8Text typespec_digest;
  pub val Utf8Text authored_schema_digest;
  pub val Utf8Text generated_schema_digest;
  pub val CodecTypeMeta codec;
end

pub define class ContractIRError as
  pub val String code;
  pub val int field_index;
  pub val String message;
end

pub fnc contract_ir_max_id_bytes(): int { return 128; }
pub fnc contract_ir_digest_bytes(): int { return 64; }

fnc is_lower_hex_digest(Utf8Text digest): bool {
  if digest.bytes.length != contract_ir_digest_bytes() then return false; fi
  for const byte of digest.bytes do
    if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) then
      return false;
    fi
  done
  return true;
}

fnc contract_id_valid(Utf8Text id): bool {
  if id.bytes.length < 1 || id.bytes.length > contract_ir_max_id_bytes() ||
     !utf8_is_valid(rt borrow id.bytes) then return false; fi
  for const byte of id.bytes do
    if byte < 33 || byte > 126 then return false; fi
  done
  return true;
}

pub fnc validate_static_contract_ir(
  StaticContractIR ir
): Result<StaticContractIR, ContractIRError> {
  if ir.version != 1 then
    return Err(new ContractIRError(
      "contract_ir_version", -1, "only static Contract IR version 1 is supported"
    ));
  fi
  if !contract_id_valid(rt borrow ir.schema_id) then
    return Err(new ContractIRError(
      "contract_ir_schema_id", -1, "schema identifier must be bounded printable UTF-8"
    ));
  fi
  if !is_lower_hex_digest(rt borrow ir.ir_digest) ||
     !is_lower_hex_digest(rt borrow ir.typespec_digest) ||
     !is_lower_hex_digest(rt borrow ir.authored_schema_digest) ||
     !is_lower_hex_digest(rt borrow ir.generated_schema_digest) then
    return Err(new ContractIRError(
      "contract_ir_digest", -1, "Contract IR and all three source lanes require lowercase SHA-256 digests"
    ));
  fi
  // The portable v1 runtime schema is a closed record. Ignore/preserve unknown
  // field modes are not admitted as a substitute for an open-record type.
  if ir.codec.unknown_field_policy != 1 then
    return Err(new ContractIRError(
      "contract_ir_open_record", -1, "Contract IR v1 requires reject-unknown closed-record metadata"
    ));
  fi
  let MetadataCheck checked = check_metadata(rt borrow ir.codec);
  if !checked.ok then
    return Err(new ContractIRError(
      "contract_ir_metadata",
      checked.error.field_index,
      checked.error.code
    ));
  fi
  return Ok(ir);
}

/// Result of admitting static Contract IR and decoding through the existing
/// bounded JSON/value validation pipeline. status: 0 success, 1 IR refusal,
/// 2 decoder/closed-record validation refusal.
pub define class ContractDecodeAttempt as
  pub val int status;
  pub val DecodedObject decoded;
  pub val ContractIRError contract_error;
  pub val ObjectCodecError codec_error;
end

fnc empty_contract_decode_object(): DecodedObject {
  return new DecodedObject(
    value_object(new List<WireMember>()),
    value_object(new List<WireMember>()),
    value_object(new List<WireMember>()),
    0
  );
}

fnc empty_contract_codec_error(): ObjectCodecError {
  return new ObjectCodecError(
    0,
    new MetadataError("", -1, ""),
    new DecodeError("", 0, ""),
    new ValidationReport(new List<ValidationError>(), false)
  );
}

/// Trusted build/loader metadata must be passed in as generated static data.
/// The runtime never parses JSON Schema or resolves remote refs at request time.
pub fnc decode_static_contract_json_attempt(
  List<int> input,
  DecodeOptions decode_options,
  StaticContractIR ir,
  ValidationOptions validation_options
): ContractDecodeAttempt {
  let Result<StaticContractIR, ContractIRError> checked =
    validate_static_contract_ir(rt borrow ir);
  if checked.is_err() then
    let ContractIRError error = checked.unwrap_err();
    return new ContractDecodeAttempt(
      1,
      empty_contract_decode_object(),
      error,
      empty_contract_codec_error()
    );
  fi
  let ObjectDecodeAttempt attempt = decode_json_object_attempt(
    input,
    decode_options,
    rt borrow ir.codec,
    validation_options
  );
  return new ContractDecodeAttempt(
    attempt.status == 0 ? 0 : 2,
    attempt.decoded,
    new ContractIRError("", -1, ""),
    attempt.error
  );
}
