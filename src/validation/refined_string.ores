// Zorde exact UTF-8 / Unicode-scalar-length refinement validator.
//
// v2 character policy codes:
//   0 any (v1-compatible length only)
//   1 ascii_letters [A-Za-z]
//   2 ascii_uppercase [A-Z]
//   3 ascii_lowercase [a-z]
//   4 uppercase (Unicode 18, reserved, NOT admitted without UCD tables)
//   5 lowercase (Unicode 18, reserved, NOT admitted without UCD tables)
//   6 han (Unicode 18 Script=Han, reserved, NOT admitted)
//
// ALL policies are compiler-owned descriptor metadata; callers with arbitrary
// integers cannot mint Valid<T,S> or forge schema identity.
import class Value, Utf8Text from '../core/value';
import fnc utf8_codepoint_count from '../core/utf8';
import class ValidationOptions, ValidationError, ValidationReport, PathSegment from './validation';
import fnc validation_options_valid, report_is_valid from './validation';

pub fnc refined_string_schema_valid(
  int minimum,
  int maximum,
  int policy
): bool {
  return minimum >= 0 && minimum <= maximum && policy >= 0 && policy <= 6;
}

fnc string_refinement_failure(
  String code,
  String message,
  ValidationOptions options
): ValidationReport {
  if options.max_errors == 0 then
    return new ValidationReport(new List<ValidationError>(), true);
  fi
  val List<ValidationError> errors = new List<ValidationError>();
  errors.add(new ValidationError(code, new List<PathSegment>(), message, -1));
  return new ValidationReport(errors, false);
}

pub fnc validate_refined_string(
  Value value,
  int minimum,
  int maximum,
  int policy,
  ValidationOptions options
): ValidationReport {
  if !validation_options_valid(options) then
    return string_refinement_failure(
      "invalid_options",
      "validation options are outside supported bounds",
      new ValidationOptions(true, 1)
    );
  fi
  if !refined_string_schema_valid(minimum, maximum, policy) then
    return string_refinement_failure(
      "invalid_refinement_schema",
      "invalid string length bounds or character policy",
      options
    );
  fi

  // Unicode 18 Script=Han and derived Unicode case classifications must
  // use the EXACT versioned UCD dataset; the host runtime's Unicode tables
  // are not a stable compiler ABI. Fail closed even for ASCII input.
  if policy >= 4 then
    return string_refinement_failure(
      "unverified_unicode_policy",
      "pinned Unicode 18 character tables are not installed",
      options
    );
  fi

  if value.kind != 3 then
    return string_refinement_failure(
      "string", "expected a UTF-8 string", options
    );
  fi

  val Utf8Text text = value.string_value;
  let int scalar_count = utf8_codepoint_count(text.bytes);
  if scalar_count < 0 then
    return string_refinement_failure(
      "utf8", "string contains invalid UTF-8", options
    );
  fi
  if scalar_count < minimum then
    return string_refinement_failure(
      "min_length", "string contains too few Unicode scalar values", options
    );
  fi
  if scalar_count > maximum then
    return string_refinement_failure(
      "max_length", "string contains too many Unicode scalar values", options
    );
  fi

  if policy == 1 || policy == 2 || policy == 3 then
    for const byte of text.bytes do
      let bool capital = byte >= 65 && byte <= 90;
      let bool small = byte >= 97 && byte <= 122;
      let bool allowed = policy == 1 ? (capital || small)
         : (policy == 2 ? capital : small);
      if !allowed then
        return string_refinement_failure(
          "chars", "string violates ASCII character policy", options
        );
      fi
    done
  fi

  return new ValidationReport(new List<ValidationError>(), false);
}

pub fnc refined_string_accepts(
  Value value,
  int minimum,
  int maximum,
  int policy
): bool {
  return report_is_valid(
    validate_refined_string(
      value, minimum, maximum, policy, new ValidationOptions(true, 1)
    )
  );
}
