// Reflection-free validation primitives over the shared dynamic Value model.
//
// Generated typed validators can lower annotations/contracts into the same rule
// records so standalone validation and decode-time validation share semantics.

import class Value, Utf8Text, WireMember from '../core/value';
import fnc bytes_equal, text_equal, text_hash, value_deep_equal, value_hash from '../core/value';
import fnc object_find_index from '../core/value';
import fnc utf8_is_valid, utf8_codepoint_count from '../core/utf8';

pub define class PathSegment as
  // kind: 0 root, 1 object key, 2 array index.
  pub val int kind;
  pub val Utf8Text key;
  pub val int index;
end

pub define class ValidationError as
  pub val String code;
  pub val List<PathSegment> path;
  pub val String message;
  pub val int source_offset;
end

pub define class ValidationOptions as
  pub val bool fail_fast;
  pub val int max_errors;
end

pub define class ValidationReport as
  pub let List<ValidationError> errors;
  pub let bool truncated;
end

// Dynamic validation never mints an authoritative, schema-bound typestate proof.
// Future Valid<T, SchemaId> must be compiler-issued and nonforgeable.

define class ParsedNumber as
  pub val bool ok;
  pub val float value;
end

pub define class ValueRule as
  // expected_kind < 0 means any kind.
  pub val int expected_kind;

  // Negative bounds disable the rule.
  pub val int min_length;
  pub val int max_length;
  pub val int min_items;
  pub val int max_items;

  pub val bool require_ascii;
  pub val bool require_email;
  pub val bool require_uuid;
  pub val bool require_url;
  pub val bool require_unique_items;

  pub val bool has_min_number;
  pub val float min_number;
  pub val bool min_exclusive;

  pub val bool has_max_number;
  pub val float max_number;
  pub val bool max_exclusive;
end

pub define class FieldRule as
  pub val Utf8Text key;
  pub val bool required;
  pub val bool forbidden;
  pub val ValueRule value_rule;
end

pub define class ObjectSchema as
  pub val List<FieldRule> fields;
  pub val bool reject_unknown_fields;
end

pub fnc default_validation_options(): ValidationOptions {
  return new ValidationOptions(false, 64);
}

pub fnc any_rule(): ValueRule {
  return new ValueRule(
    -1,
    -1,
    -1,
    -1,
    -1,
    false,
    false,
    false,
    false,
    false,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}


pub fnc kind_rule(int expected_kind): ValueRule {
  return new ValueRule(
    expected_kind,
    -1,
    -1,
    -1,
    -1,
    false,
    false,
    false,
    false,
    false,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}

pub fnc string_rule(
  int min_length,
  int max_length,
  bool require_ascii,
  bool require_email,
  bool require_uuid,
  bool require_url
): ValueRule {
  return new ValueRule(
    3,
    min_length,
    max_length,
    -1,
    -1,
    require_ascii,
    require_email,
    require_uuid,
    require_url,
    false,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}

pub fnc number_rule(
  bool has_min,
  float min_value,
  bool min_exclusive,
  bool has_max,
  float max_value,
  bool max_exclusive
): ValueRule {
  return new ValueRule(
    2,
    -1,
    -1,
    -1,
    -1,
    false,
    false,
    false,
    false,
    false,
    has_min,
    min_value,
    min_exclusive,
    has_max,
    max_value,
    max_exclusive
  );
}

pub fnc array_rule(
  int min_items,
  int max_items,
  bool unique_items
): ValueRule {
  return new ValueRule(
    5,
    -1,
    -1,
    min_items,
    max_items,
    false,
    false,
    false,
    false,
    unique_items,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}

pub fnc field_rule(
  Utf8Text key,
  bool required,
  bool forbidden,
  ValueRule value_rule
): FieldRule {
  return new FieldRule(key, required, forbidden, value_rule);
}

pub fnc object_schema(
  List<FieldRule> fields,
  bool reject_unknown_fields
): ObjectSchema {
  return new ObjectSchema(fields, reject_unknown_fields);
}


pub fnc validation_options_valid(ValidationOptions options): bool {
  return options.max_errors >= 0 && options.max_errors <= 4096;
}

pub fnc value_rule_valid(ValueRule rule): bool {
  if rule.expected_kind < -1 || rule.expected_kind > 8 then
    return false;
  fi

  if rule.min_length < -1 ||
     rule.max_length < -1 ||
     rule.min_items < -1 ||
     rule.max_items < -1 then
    return false;
  fi

  if rule.min_length >= 0 &&
     rule.max_length >= 0 &&
     rule.min_length > rule.max_length then
    return false;
  fi

  if rule.min_items >= 0 &&
     rule.max_items >= 0 &&
     rule.min_items > rule.max_items then
    return false;
  fi

  let bool has_length_constraint =
    rule.min_length >= 0 || rule.max_length >= 0;
  if has_length_constraint &&
     rule.expected_kind != 3 &&
     rule.expected_kind != 4 then
    return false;
  fi

  if (rule.require_ascii ||
      rule.require_email ||
      rule.require_uuid ||
      rule.require_url) &&
     rule.expected_kind != 3 then
    return false;
  fi

  if (rule.min_items >= 0 ||
      rule.max_items >= 0 ||
      rule.require_unique_items) &&
     rule.expected_kind != 5 then
    return false;
  fi

  if (rule.has_min_number || rule.has_max_number) &&
     rule.expected_kind != 2 then
    return false;
  fi

  // Reject nonfinite bounds, not just NaN. A zero bound is finite;
  // for every other finite IEEE float, x/x == 1.0. Infinity and NaN
  // both fail this check without depending on backend-specific intrinsics.
  if rule.has_min_number &&
     (rule.min_number != 0.0 && rule.min_number / rule.min_number != 1.0) then
    return false;
  fi

  if rule.has_max_number &&
     (rule.max_number != 0.0 && rule.max_number / rule.max_number != 1.0) then
    return false;
  fi

  if rule.has_min_number && rule.has_max_number then
    if rule.min_number > rule.max_number then
      return false;
    fi

    if rule.min_number == rule.max_number &&
       (rule.min_exclusive || rule.max_exclusive) then
      return false;
    fi
  fi

  return true;
}

fnc config_report(
  String code,
  String message
): ValidationReport {
  val List<ValidationError> errors = new List<ValidationError>();
  errors.add(
    new ValidationError(
      code,
      new List<PathSegment>(),
      message,
      -1
    )
  );
  return new ValidationReport(errors, false);
}

pub fnc max_schema_fields(): int {
  return 4096;
}

pub fnc max_schema_key_bytes(): int {
  return 65536;
}

fnc object_schema_valid(ObjectSchema schema): bool {
  if schema.fields.length > max_schema_fields() then
    return false;
  fi

  val Map<int, List<int>> buckets = new Map<int, List<int>>();
  let int i = 0;

  loop do
    if i >= schema.fields.length then
      break;
    fi

    let FieldRule field = schema.fields[i];

    if field.key.bytes.length > max_schema_key_bytes() ||
       !utf8_is_valid(field.key.bytes) then
      return false;
    fi

    if field.required && field.forbidden then
      return false;
    fi

    if !value_rule_valid(field.value_rule) then
      return false;
    fi

    let int hash = text_hash(field.key);
    if buckets.contains(hash) then
      val List<int> candidates = buckets.get(hash);
      for const index of candidates do
        if text_equal(schema.fields[index].key, field.key) then
          return false;
        fi
      done
      candidates.add(i);
    else
      val List<int> candidates = new List<int>();
      candidates.add(i);
      buckets.set(hash, candidates);
    fi

    i = i + 1;
  done

  return true;
}

fnc empty_key(): Utf8Text {
  return new Utf8Text(new List<int>());
}

fnc key_path(Utf8Text key): List<PathSegment> {
  val List<PathSegment> path = new List<PathSegment>();
  path.add(new PathSegment(1, key, -1));
  return path;
}

fnc index_path(int index): List<PathSegment> {
  val List<PathSegment> path = new List<PathSegment>();
  path.add(new PathSegment(2, empty_key(), index));
  return path;
}

fnc add_error(
  ValidationReport mut report,
  ValidationOptions options,
  String code,
  List<PathSegment> path,
  String message
): void {
  if options.max_errors <= 0 then
    report.truncated = true;
    return;
  fi

  if report.errors.length >= options.max_errors then
    report.truncated = true;
    return;
  fi

  report.errors.add(new ValidationError(code, path, message, -1));
  return;
}

fnc should_stop(ValidationReport report, ValidationOptions options): bool {
  if report.truncated then
    return true;
  fi
  return options.fail_fast && report.errors.length > 0;
}

pub fnc is_ascii(Utf8Text text): bool {
  for const byte of text.bytes do
    if byte < 0 || byte > 127 then
      return false;
    fi
  done
  return true;
}

fnc is_ascii_letter_or_digit(int byte): bool {
  if byte >= 48 && byte <= 57 then
    return true;
  fi
  if byte >= 65 && byte <= 90 then
    return true;
  fi
  return byte >= 97 && byte <= 122;
}

fnc is_hex(int byte): bool {
  if byte >= 48 && byte <= 57 then
    return true;
  fi
  if byte >= 65 && byte <= 70 then
    return true;
  fi
  return byte >= 97 && byte <= 102;
}

pub fnc is_uuid(Utf8Text text): bool {
  if text.bytes.length != 36 then
    return false;
  fi

  let int i = 0;
  loop do
    if i >= 36 then
      break;
    fi

    if i == 8 || i == 13 || i == 18 || i == 23 {
      if text.bytes[i] != 45 {
        return false;
      } fi
    } else {
      if !is_hex(text.bytes[i]) {
        return false;
      } fi
    } fi

    i = i + 1;
  done

  return true;
}

// Restricted ASCII dot-atom (not quoted-string or internationalized mailboxes).
fnc is_email_atext(int byte): bool {
  if is_ascii_letter_or_digit(byte) then return true; fi
  return byte == 33 || byte == 35 || byte == 36 || byte == 37 ||
         byte == 38 || byte == 39 || byte == 42 || byte == 43 ||
         byte == 45 || byte == 47 || byte == 61 || byte == 63 ||
         byte == 94 || byte == 95 || byte == 96 || byte == 123 ||
         byte == 124 || byte == 125 || byte == 126;
}

pub fnc is_email(Utf8Text text): bool {
  if !is_ascii(text) then
    return false;
  fi

  if text.bytes.length < 3 || text.bytes.length > 254 then
    return false;
  fi

  let int at = -1;
  let int i = 0;

  loop do
    if i >= text.bytes.length then
      break;
    fi

    let int byte = text.bytes[i];

    if byte == 64 then
      if at >= 0 then
        return false;
      fi
      at = i;
    elseif byte <= 32 || byte == 127 then
      return false;
    fi

    i = i + 1;
  done

  if at <= 0 || at >= text.bytes.length - 1 then
    return false;
  fi

  if at > 64 then
    return false;
  fi

  // Accept only an unquoted ASCII dot-atom: unsupported punctuation
  // must not acquire email shape validity.
  i = 0;
  loop do
    if i >= at then break; fi
    let int byte = text.bytes[i];
    if byte == 46 then
      if i == 0 || i == at - 1 || (i > 0 && text.bytes[i - 1] == 46) then
        return false;
      fi
    elseif !is_email_atext(byte) then
      return false;
    fi
    i = i + 1;
  done

  // Basic domain-name shape: at least two non-empty labels; labels use
  // letters/digits/hyphens and cannot begin/end with a hyphen.
  let bool saw_dot = false;
  let int label_start = at + 1;
  i = label_start;

  loop do
    if i > text.bytes.length then
      break;
    fi

    let bool at_end = i == text.bytes.length;
    let int byte = at_end ? 46 : text.bytes[i];

    if byte == 46 {
      if i == label_start || i - label_start > 63 {
        return false;
      } fi
      if text.bytes[label_start] == 45 || text.bytes[i - 1] == 45 {
        return false;
      } fi
      if !at_end {
        saw_dot = true;
      } fi
      label_start = i + 1;
    } else {
      if !is_ascii_letter_or_digit(byte) && byte != 45 {
        return false;
      } fi
    } fi

    if at_end then
      break;
    fi
    i = i + 1;
  done

  return saw_dot;
}

fnc starts_with_ascii(Utf8Text text, List<int> prefix): bool {
  if text.bytes.length < prefix.length then
    return false;
  fi

  let int i = 0;
  loop do
    if i >= prefix.length then
      break;
    fi
    if text.bytes[i] != prefix[i] then
      return false;
    fi
    i = i + 1;
  done
  return true;
}

pub fnc is_url(Utf8Text text): bool {
  // Restricted ASCII absolute HTTP(S) shape, NOT DNS, WHATWG normalization,
  // destination authorization or a general-purpose URL parser.
  if text.bytes.length > 8192 || !is_ascii(text) then
    return false;
  fi

  let int host_start = -1;
  if starts_with_ascii(
    text, new List<int>(104, 116, 116, 112, 58, 47, 47)
  ) then
    host_start = 7;
  elseif starts_with_ascii(
    text, new List<int>(104, 116, 116, 112, 115, 58, 47, 47)
  ) then
    host_start = 8;
  else
    return false;
  fi

  let int n = text.bytes.length;
  if host_start >= n then return false; fi

  // Authority terminates at the first / ? or #. Never reinterpret \
  // as a path separator. Userinfo is unsupported by this restricted API.
  let int authority_end = host_start;
  loop do
    if authority_end >= n then break; fi
    let int byte = text.bytes[authority_end];
    if byte == 47 || byte == 63 || byte == 35 then break; fi
    if byte <= 32 || byte >= 127 || byte == 64 || byte == 92 then
      return false;
    fi
    authority_end = authority_end + 1;
  done
  if authority_end == host_start then return false; fi

  let int port_start = -1;
  let int host_end = authority_end;

  if text.bytes[host_start] == 91 then
    // Explicitly support hexadecimal IPv6 literals only: no zone IDs,
    // IPv4-mapped dotted suffixes, or alternate host normalization.
    let int close = host_start + 1;
    loop do
      if close >= authority_end || text.bytes[close] == 93 then break; fi
      close = close + 1;
    done
    if close >= authority_end then return false; fi

    let int groups = 0;
    let int digits = 0;
    let bool compressed = false;
    let int i = host_start + 1;
    loop do
      if i >= close then break; fi
      let int byte = text.bytes[i];
      if is_hex(byte) then
        digits = digits + 1;
        if digits > 4 then return false; fi
        i = i + 1;
      elseif byte == 58 then
        if i + 1 < close && text.bytes[i + 1] == 58 then
          if compressed then return false; fi
          if digits > 0 then
            groups = groups + 1;
            digits = 0;
          elseif i != host_start + 1 then
            return false;
          fi
          compressed = true;
          i = i + 2;
          if i < close && text.bytes[i] == 58 then return false; fi
        else
          if digits == 0 || i + 1 >= close then return false; fi
          groups = groups + 1;
          digits = 0;
          i = i + 1;
        fi
      else
        return false;
      fi
    done
    if digits > 0 then groups = groups + 1; fi
    // A double colon must replace at least one omitted 16-bit group.
    if (compressed && groups >= 8) || (!compressed && groups != 8) then
      return false;
    fi

    host_end = close + 1;
    if host_end < authority_end then
      if text.bytes[host_end] != 58 then return false; fi
      port_start = host_end + 1;
    fi
  else
    // Conservative DNS / IPv4-like syntax: no raw IPv6, userinfo,
    // percent escapes, empty labels, underscores or deceptive host suffixes.
    let int i = host_start;
    let int label_start = host_start;
    loop do
      if i >= authority_end then break; fi
      let int byte = text.bytes[i];
      if byte == 58 then
        host_end = i;
        port_start = i + 1;
        break;
      fi
      if byte == 46 then
        if i == label_start || i - label_start > 63 ||
           text.bytes[i - 1] == 45 then return false; fi
        label_start = i + 1;
      elseif (byte >= 65 && byte <= 90) ||
             (byte >= 97 && byte <= 122) ||
             (byte >= 48 && byte <= 57) then
        // Valid conservative hostname character.
      elseif byte == 45 then
        if i == label_start then return false; fi
      else
        return false;
      fi
      i = i + 1;
    done
    if host_end == host_start || host_end == label_start ||
       host_end - label_start > 63 ||
       host_end - host_start > 253 ||
       text.bytes[host_end - 1] == 45 then return false; fi
  fi

  if port_start >= 0 then
    if port_start >= authority_end ||
       authority_end - port_start > 5 then return false; fi
    let int port = 0;
    let int i = port_start;
    loop do
      if i >= authority_end then break; fi
      let int byte = text.bytes[i];
      if byte < 48 || byte > 57 then return false; fi
      port = (port * 10) + (byte - 48);
      if port > 65535 then return false; fi
      i = i + 1;
    done
    if port == 0 then return false; fi
  fi

  // Reject ambiguous backslash/control bytes in path/query/fragment too.
  let int suffix = authority_end;
  loop do
    if suffix >= n then break; fi
    let int byte = text.bytes[suffix];
    if byte <= 32 || byte == 92 || byte == 127 then return false; fi
    suffix = suffix + 1;
  done
  return true;
}

// Validation is a boundary even for programmatically built Value lexemes.
// Bound work independently of JSON decoder settings, which callers may bypass.
pub fnc max_validated_number_bytes(): int { return 1024; }

// Lexical admission is independent of a float range comparison. Decoder
// callers cannot bypass JSON-number grammar by building Value directly.
// A valid unbounded JSON number need not fit IEEE double.
pub fnc number_lexeme_valid(Value value): bool {
  if value.kind != 2 then return false; fi
  val List<int> bytes = value.number_lexeme;
  if bytes.length == 0 || bytes.length > max_validated_number_bytes() then
    return false;
  fi

  let int i = 0;
  if bytes[i] == 45 then
    i = i + 1;
    if i >= bytes.length then return false; fi
  fi

  // Canonical integer: one zero, or a nonzero digit followed by digits.
  if bytes[i] == 48 then
    i = i + 1;
    if i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 then
      return false;
    fi
  else
    if bytes[i] < 49 || bytes[i] > 57 then return false; fi
    i = i + 1;
    loop do
      if i >= bytes.length || bytes[i] < 48 || bytes[i] > 57 then
        break;
      fi
      i = i + 1;
    done
  fi

  if i < bytes.length && bytes[i] == 46 then
    i = i + 1;
    if i >= bytes.length || bytes[i] < 48 || bytes[i] > 57 then
      return false;
    fi
    loop do
      if i >= bytes.length || bytes[i] < 48 || bytes[i] > 57 then
        break;
      fi
      i = i + 1;
    done
  fi

  if i < bytes.length && (bytes[i] == 101 || bytes[i] == 69) then
    i = i + 1;
    if i < bytes.length && (bytes[i] == 43 || bytes[i] == 45) then
      i = i + 1;
    fi
    if i >= bytes.length || bytes[i] < 48 || bytes[i] > 57 then
      return false;
    fi
    loop do
      if i >= bytes.length || bytes[i] < 48 || bytes[i] > 57 then
        break;
      fi
      i = i + 1;
    done
  fi

  return i == bytes.length;
}

pub fnc parse_number(Value value): ParsedNumber {
  if value.kind != 2 then
    return new ParsedNumber(false, 0.0);
  fi

  let List<int> bytes = value.number_lexeme;
  if bytes.length == 0 || bytes.length > max_validated_number_bytes() then
    return new ParsedNumber(false, 0.0);
  fi

  let int i = 0;
  let float sign = 1.0;

  if bytes[i] == 45 then
    sign = 0.0 - 1.0;
    i = i + 1;
  fi

  let float whole = 0.0;
  let bool saw_digit = false;
  let bool saw_nonzero_digit = false;

  loop do
    if i >= bytes.length then
      break;
    fi
    let int byte = bytes[i];
    if byte < 48 || byte > 57 then
      break;
    fi
    // JSON numbers cannot start their integer component with 00 or 01.
    if (i == 0 || (i == 1 && bytes[0] == 45)) && byte == 48 then
      if i + 1 < bytes.length && bytes[i + 1] >= 48 && bytes[i + 1] <= 57 then
        return new ParsedNumber(false, 0.0);
      fi
    fi
    if byte != 48 then
      saw_nonzero_digit = true;
    fi
    whole = (whole * 10.0) + (byte - 48);
    saw_digit = true;
    i = i + 1;
  done

  if !saw_digit then
    return new ParsedNumber(false, 0.0);
  fi

  let float fraction = 0.0;
  let float divisor = 1.0;

  if i < bytes.length && bytes[i] == 46 then
    i = i + 1;
    let bool saw_fraction = false;

    loop do
      if i >= bytes.length then
        break;
      fi
      let int byte = bytes[i];
      if byte < 48 || byte > 57 then
        break;
      fi
      if byte != 48 then
        saw_nonzero_digit = true;
      fi
      fraction = (fraction * 10.0) + (byte - 48);
      divisor = divisor * 10.0;
      saw_fraction = true;
      i = i + 1;
    done

    if !saw_fraction then
      return new ParsedNumber(false, 0.0);
    fi
  fi

  let int exponent = 0;
  let int exponent_sign = 1;

  if i < bytes.length && (bytes[i] == 101 || bytes[i] == 69) then
    i = i + 1;

    if i < bytes.length && bytes[i] == 43 then
      i = i + 1;
    elseif i < bytes.length && bytes[i] == 45 then
      exponent_sign = -1;
      i = i + 1;
    fi

    let bool saw_exponent = false;
    loop do
      if i >= bytes.length then
        break;
      fi
      let int byte = bytes[i];
      if byte < 48 || byte > 57 then
        return new ParsedNumber(false, 0.0);
      fi
      exponent = (exponent * 10) + (byte - 48);
      if exponent > 308 then
        return new ParsedNumber(false, 0.0);
      fi
      saw_exponent = true;
      i = i + 1;
    done

    if !saw_exponent then
      return new ParsedNumber(false, 0.0);
    fi
  fi

  if i != bytes.length then
    return new ParsedNumber(false, 0.0);
  fi

  let float result = sign * (whole + (fraction / divisor));
  let int steps = exponent;
  let int j = 0;

  loop do
    if j >= steps then
      break;
    fi
    if exponent_sign > 0 then
      result = result * 10.0;
    else
      result = result / 10.0;
    fi
    j = j + 1;
  done

  // NaN, +Infinity and -Infinity are never valid range-comparison inputs.
  // Reject nonzero decimals that silently underflowed to zero as well.
  if result != result ||
     (result != 0.0 && result / result != 1.0) ||
     (result == 0.0 && saw_nonzero_digit) then
    return new ParsedNumber(false, 0.0);
  fi

  return new ParsedNumber(true, result);
}

fnc validate_unique(
  Value value,
  ValidationReport mut report,
  ValidationOptions options,
  List<PathSegment> path
): void {
  val Map<int, List<Value>> buckets = new Map<int, List<Value>>();

  for const item of value.array_value do
    let int hash = value_hash(item);

    if buckets.contains(hash) then
      val List<Value> candidates = buckets.get(hash);
      for const candidate of candidates do
        if value_deep_equal(candidate, item) then
          add_error(
            report,
            options,
            "unique_items",
            path,
            "array contains duplicate values"
          );
          return;
        fi
      done
      candidates.add(item);
    else
      val List<Value> candidates = new List<Value>();
      candidates.add(item);
      buckets.set(hash, candidates);
    fi
  done

  return;
}

fnc validate_rule_at(
  Value value,
  ValueRule rule,
  ValidationReport mut report,
  ValidationOptions options,
  List<PathSegment> path
): void {
  if rule.expected_kind >= 0 && value.kind != rule.expected_kind then
    add_error(report, options, "type", path, "value has the wrong wire type");
    return;
  fi

  if should_stop(report, options) then
    return;
  fi

  if value.kind == 3 then
    if !utf8_is_valid(value.string_value.bytes) then
      add_error(report, options, "utf8", path, "string contains invalid UTF-8");
      return;
    fi

    let int length = utf8_codepoint_count(value.string_value.bytes);

    if rule.min_length >= 0 && length < rule.min_length then
      add_error(report, options, "min_length", path, "string is shorter than min_length");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.max_length >= 0 && length > rule.max_length then
      add_error(report, options, "max_length", path, "string is longer than max_length");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_ascii && !is_ascii(value.string_value) then
      add_error(report, options, "ascii", path, "string must contain only ASCII");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_email && !is_email(value.string_value) then
      add_error(report, options, "email", path, "string is not a valid basic email address");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_uuid && !is_uuid(value.string_value) then
      add_error(report, options, "uuid", path, "string is not a canonical UUID");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_url && !is_url(value.string_value) then
      add_error(report, options, "url", path, "string is not an http/https URL");
    fi
  fi

  if value.kind == 4 then
    if rule.min_length >= 0 && value.bytes_value.length < rule.min_length then
      add_error(report, options, "min_length", path, "byte string is shorter than min_length");
    fi
    if should_stop(report, options) then
      return;
    fi
    if rule.max_length >= 0 && value.bytes_value.length > rule.max_length then
      add_error(report, options, "max_length", path, "byte string is longer than max_length");
    fi
  fi

  if value.kind == 5 then
    if rule.min_items >= 0 && value.array_value.length < rule.min_items then
      add_error(report, options, "min_items", path, "array contains too few items");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.max_items >= 0 && value.array_value.length > rule.max_items then
      add_error(report, options, "max_items", path, "array contains too many items");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_unique_items then
      validate_unique(value, report, options, path);
    fi
  fi

  if value.kind == 2 then
    // Even type-only/any rules must not admit malformed number lexemes.
    // Do not float-convert JSON values when no numeric range is requested.
    if !number_lexeme_valid(rt borrow value) then
      add_error(report, options, "number", path, "number has an invalid JSON lexeme");
      return;
    fi
  fi

  if value.kind == 2 && (rule.has_min_number || rule.has_max_number) then
    let ParsedNumber parsed = parse_number(value);
    if !parsed.ok then
      add_error(report, options, "number", path, "number cannot be represented for range validation");
      return;
    fi

    if rule.has_min_number {
      if rule.min_exclusive {
        if parsed.value <= rule.min_number {
          add_error(report, options, "exclusive_min", path, "number must be greater than the minimum");
        } fi
      } else {
        if parsed.value < rule.min_number {
          add_error(report, options, "min", path, "number is below the minimum");
        } fi
      } fi
    } fi

    if should_stop(report, options) then
      return;
    fi

    if rule.has_max_number {
      if rule.max_exclusive {
        if parsed.value >= rule.max_number {
          add_error(report, options, "exclusive_max", path, "number must be less than the maximum");
        } fi
      } else {
        if parsed.value > rule.max_number {
          add_error(report, options, "max", path, "number is above the maximum");
        } fi
      } fi
    } fi
  fi

  return;
}

pub fnc validate_value(
  Value value,
  ValueRule rule,
  ValidationOptions options
): ValidationReport {
  if !validation_options_valid(options) then
    return config_report(
      "invalid_options",
      "validation options are outside supported bounds"
    );
  fi

  if !value_rule_valid(rule) then
    return config_report(
      "invalid_rule",
      "validation rule is contradictory or incompatible with its value kind"
    );
  fi

  let ValidationReport report = new ValidationReport(
    new List<ValidationError>(),
    false
  );
  validate_rule_at(value, rule, report, options, new List<PathSegment>());
  return report;
}

fnc remember_text_index(
  Map<int, List<int>> buckets,
  Utf8Text key,
  int index
): void {
  let int hash = text_hash(key);
  if buckets.contains(hash) then
    let List<int> candidates = buckets.get(hash);
    candidates.push(index);
    return;
  fi

  let List<int> candidates = new List<int>();
  candidates.push(index);
  buckets.set(hash, candidates);
  return;
}

fnc schema_field_index(
  ObjectSchema schema,
  Map<int, List<int>> buckets,
  Utf8Text key
): int {
  let int hash = text_hash(key);
  if !buckets.contains(hash) then
    return -1;
  fi

  let List<int> candidates = buckets.get(hash);
  for const index of candidates do
    if text_equal(schema.fields[index].key, key) then
      return index;
    fi
  done
  return -1;
}

fnc object_field_index(
  Value object,
  Map<int, List<int>> buckets,
  Utf8Text key
): int {
  let int hash = text_hash(key);
  if !buckets.contains(hash) then
    return -1;
  fi

  let List<int> candidates = buckets.get(hash);
  for const index of candidates do
    if text_equal(object.object_value[index].key, key) then
      return index;
    fi
  done
  return -1;
}

fnc object_keys_unique(Value object): bool {
  let Map<int, List<int>> buckets = new Map<int, List<int>>();
  let int i = 0;

  for const member of object.object_value do
    if object_field_index(object, buckets, member.key) >= 0 then
      return false;
    fi
    remember_text_index(buckets, member.key, i);
    i = i + 1;
  done

  return true;
}

pub fnc validate_object(
  Value value,
  ObjectSchema schema,
  ValidationOptions options
): ValidationReport {
  if !validation_options_valid(options) then
    return config_report(
      "invalid_options",
      "validation options are outside supported bounds"
    );
  fi

  if !object_schema_valid(schema) then
    return config_report(
      "invalid_schema",
      "object schema contains duplicate, contradictory, or invalid field rules"
    );
  fi

  let ValidationReport report = new ValidationReport(
    new List<ValidationError>(),
    false
  );

  if value.kind != 6 then
    add_error(
      report,
      options,
      "type",
      new List<PathSegment>(),
      "object schema requires an object/map value"
    );
    return report;
  fi

  // The dynamic Value model can be constructed without a JSON decoder.
  // Refuse oversized input before building hash buckets or walking all fields.
  // Reuse the schema's conservative member/key limits on this trust boundary.
  if value.object_value.length > max_schema_fields() then
    add_error(report, options, "object_capacity", new List<PathSegment>(),
      "input object member count exceeds the bounded validation domain");
    return report;
  fi

  // Do not permit malformed bytes in object keys, even when unknown fields
  // are allowed. Unknown-schema keys would otherwise evade field rules.
  for const member of value.object_value do
    if member.key.bytes.length > max_schema_key_bytes() ||
       !utf8_is_valid(member.key.bytes) then
      add_error(report, options, "invalid_object_key", new List<PathSegment>(),
        "input object key is oversized or is not valid UTF-8");
      return report;
    fi
  done

  if !object_keys_unique(value) then
    add_error(
      report,
      options,
      "duplicate_key",
      new List<PathSegment>(),
      "object contains duplicate field names"
    );
    return report;
  fi

  let Map<int, List<int>> schema_buckets = new Map<int, List<int>>();
  let int schema_index = 0;
  for const field of schema.fields do
    remember_text_index(schema_buckets, field.key, schema_index);
    schema_index = schema_index + 1;
  done

  let Map<int, List<int>> object_buckets = new Map<int, List<int>>();
  let int object_index = 0;
  for const member of value.object_value do
    remember_text_index(object_buckets, member.key, object_index);
    object_index = object_index + 1;
  done

  for const field of schema.fields do
    let int index = object_field_index(value, object_buckets, field.key);

    if index < 0 then
      if field.required then
        add_error(
          report,
          options,
          "required",
          key_path(field.key),
          "required field is missing"
        );
      fi

      if should_stop(report, options) then
        return report;
      fi
      continue;
    fi

    if field.forbidden then
      add_error(
        report,
        options,
        "forbidden",
        key_path(field.key),
        "field is forbidden"
      );
      if should_stop(report, options) then
        return report;
      fi
      continue;
    fi

    validate_rule_at(
      value.object_value[index].value,
      field.value_rule,
      report,
      options,
      key_path(field.key)
    );

    if should_stop(report, options) then
      return report;
    fi
  done

  if schema.reject_unknown_fields then
    for const member of value.object_value do
      if schema_field_index(schema, schema_buckets, member.key) < 0 then
        add_error(
          report,
          options,
          "unknown_field",
          key_path(member.key),
          "unknown field is not allowed"
        );
        if should_stop(report, options) then
          return report;
        fi
      fi
    done
  fi

  return report;
}

pub fnc report_is_valid(ValidationReport report): bool {
  return report.errors.length == 0 && !report.truncated;
}


pub fnc validate_value_checked(
  Value value,
  ValueRule rule,
  ValidationOptions options
): Result<Value, ValidationReport> {
  let ValidationReport report = validate_value(value, rule, options);
  if report_is_valid(report) then
    return Ok(value);
  fi
  return Err(report);
}

pub fnc validate_object_checked(
  Value value,
  ObjectSchema schema,
  ValidationOptions options
): Result<Value, ValidationReport> {
  let ValidationReport report = validate_object(value, schema, options);
  if report_is_valid(report) then
    return Ok(value);
  fi
  return Err(report);
}
