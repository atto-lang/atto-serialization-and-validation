// Bare-metal-safe Unicode scalar scanner for compiler/Zorde refinements.
// UTF-8 input is a borrowed sequence of bytes; no OS, float, reflection,
// locale, Unicode normalization, or user callback is involved.
//
// Returns the number of Unicode scalar values; -1 for malformed input.
// Rejects overlong sequences, illegal lead/continuation bytes, surrogates
// and codepoints past U+10FFFF.
pub fnc utf8_scalar_count(List<int> bytes): int {
  let int index = 0;
  let int count = 0;
  loop do
    if index >= bytes.length then break; fi

    val int first = bytes[index];
    let int width = -1;
    if first >= 0 && first < 128 then width = 1; fi
    if first >= 194 && first <= 223 then width = 2; fi
    if first >= 224 && first <= 239 then width = 3; fi
    if first >= 240 && first <= 244 then width = 4; fi
    if width < 1 || width > bytes.length - index then return -1; fi

    let int next_index = 1;
    loop do
      if next_index >= width then break; fi
      val int next = bytes[index + next_index];
      if next < 128 || next > 191 then return -1; fi
      if next_index == 1 then
        if first == 224 && next < 160 then return -1; fi
        if first == 237 && next > 159 then return -1; fi
        if first == 240 && next < 144 then return -1; fi
        if first == 244 && next > 143 then return -1; fi
      fi
      next_index = next_index + 1;
    done

    count = count + 1;
    index = index + width;
  done
  return count;
}
