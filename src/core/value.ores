// Shared dynamic wire-value model for JSON, MessagePack, CBOR, and schema-aware adapters.
//
// Oreslang userland is pointer-free: ordinary object arguments are references.
// No address-of, dereference, or pointer arithmetic is used in this library.

pub define class Utf8Text as
  pub val List<int> bytes;
end

pub define class WireMember as
  pub val Utf8Text key;
  pub val Value value;
end

pub define class MapEntry as
  pub val Value key;
  pub val Value value;
end

pub define class IntParse as
  pub val bool ok;
  pub val int value;
end

pub define class Value as
  // kind:
  // 0 null, 1 bool, 2 number, 3 utf8 string, 4 bytes,
  // 5 array, 6 string-key object, 7 extension, 8 general map.
  pub val int kind;
  pub val bool bool_value;
  pub val List<int> number_lexeme;
  pub val Utf8Text string_value;
  pub val List<int> bytes_value;
  pub val List<Value> array_value;
  pub val List<WireMember> object_value;
  pub val List<MapEntry> map_value;
  pub val int extension_type;
end

pub fnc null_kind(): int { return 0; }
pub fnc bool_kind(): int { return 1; }
pub fnc number_kind(): int { return 2; }
pub fnc string_kind(): int { return 3; }
pub fnc bytes_kind(): int { return 4; }
pub fnc array_kind(): int { return 5; }
pub fnc object_kind(): int { return 6; }
pub fnc extension_kind(): int { return 7; }
pub fnc map_kind(): int { return 8; }

fnc empty_text(): Utf8Text {
  return new Utf8Text(new List<int>());
}

fnc empty_value_list(): List<Value> {
  return new List<Value>();
}

fnc empty_member_list(): List<WireMember> {
  return new List<WireMember>();
}

fnc empty_map_entries(): List<MapEntry> {
  return new List<MapEntry>();
}

fnc empty_bytes(): List<int> {
  return new List<int>();
}

pub fnc utf8_text(List<int> bytes): Utf8Text {
  return new Utf8Text(bytes);
}

pub fnc value_null(): Value {
  return new Value(
    0,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_bool(bool value): Value {
  return new Value(
    1,
    value,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_number_lexeme(List<int> lexeme): Value {
  return new Value(
    2,
    false,
    lexeme,
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc int_to_decimal_bytes(int value): List<int> {
  // Keep the remainder non-positive: negating INT64_MIN would overflow.
  // Decimal subtraction avoids the backend's floating-point `/` operator.
  val List<int> output = new List<int>();
  let int remaining = value > 0 ? 0 - value : value;
  if value < 0 then output.add(45); fi
  val List<int> powers = arr[-1000000000000000000, -100000000000000000,
    -10000000000000000, -1000000000000000, -100000000000000,
    -10000000000000, -1000000000000, -100000000000, -10000000000,
    -1000000000, -100000000, -10000000, -1000000, -100000,
    -10000, -1000, -100, -10, -1];
  let bool emitted = false;
  for const power of powers do
    let int digit = 0;
    loop do
      if remaining > power then break; fi
      remaining = remaining - power;
      digit = digit + 1;
    done
    if emitted || digit != 0 || power == -1 then
      output.add(48 + digit);
      emitted = true;
    fi
  done
  return output;
}

pub fnc value_int(int value): Value {
  return value_number_lexeme(int_to_decimal_bytes(value));
}

pub fnc value_string(Utf8Text value): Value {
  return new Value(
    3,
    false,
    empty_bytes(),
    value,
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_bytes(List<int> value): Value {
  return new Value(
    4,
    false,
    empty_bytes(),
    empty_text(),
    value,
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_array(List<Value> values): Value {
  return new Value(
    5,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    values,
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_object(List<WireMember> members): Value {
  return new Value(
    6,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    members,
    empty_map_entries(),
    0
  );
}

pub fnc value_extension(int extension_type, List<int> payload): Value {
  return new Value(
    7,
    false,
    empty_bytes(),
    empty_text(),
    payload,
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    extension_type
  );
}

pub fnc value_map(List<MapEntry> entries): Value {
  return new Value(
    8,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    entries,
    0
  );
}

pub fnc bytes_equal(List<int> left, List<int> right): bool {
  return bytes_equal_borrow(rt borrow left, rt borrow right);
}

fnc bytes_equal_borrow(borrow List<int> left, borrow List<int> right): bool {
  if left.size != right.size then
    return false;
  fi

  let int i = 0;
  loop do
    if i >= left.size then
      break;
    fi
    if left[i] != right[i] then
      return false;
    fi
    i = i + 1;
  done

  return true;
}

pub fnc text_equal(Utf8Text left, Utf8Text right): bool {
  return text_equal_borrow(rt borrow left, rt borrow right);
}

fnc text_equal_borrow(borrow Utf8Text left, borrow Utf8Text right): bool {
  val projection_0 = left.bytes;
  val projection_1 = right.bytes;
  return bytes_equal_borrow(rt borrow projection_0, rt borrow projection_1);
}

fnc object_find_index_borrow(borrow Value object, borrow Utf8Text key): int {
  if object.kind != 6 then
    return -1;
  fi

  // The lookup key is borrowed by this function: never transfer it repeatedly
  // to a by-value equality callable from inside a loop.
  val List<int> search_bytes = key.bytes;
  let int i = 0;
  loop do
    if i >= object.object_value.size then
      break;
    fi
    val List<int> current_bytes = object.object_value[i].key.bytes;
    if current_bytes.size == search_bytes.size then
      let bool equal = true;
      let int j = 0;
      loop do
        if j >= search_bytes.size then
          break;
        fi
        if current_bytes[j] != search_bytes[j] then
          equal = false;
          break;
        fi
        j = j + 1;
      done
      if equal then
        return i;
      fi
    fi
    i = i + 1;
  done

  return -1;
}

pub fnc object_find_index(Value object, Utf8Text key): int {
  return object_find_index_borrow(rt borrow object, rt borrow key);
}

pub fnc object_has(Value object, Utf8Text key): bool {
  return object_find_index(object, key) >= 0;
}

pub fnc object_get(Value object, Utf8Text key): Result<Value, String> {
  let int index = object_find_index_borrow(rt borrow object, rt borrow key);
  if index < 0 then
    return Err("object key not found");
  fi
  return Ok(object.object_value[index].value);
}

fnc hash_mix(int hash, int value): int {
  // Deliberate wrapping integer arithmetic: hashes are bucket selectors only;
  // collisions are always resolved with semantic equality.
  return (hash * 1099511628211) ^ value;
}

pub fnc bytes_hash(List<int> bytes): int {
  return bytes_hash_borrow(rt borrow bytes);
}

fnc bytes_hash_borrow(borrow List<int> bytes): int {
  let int hash = 1469598103934665603;
  let int i = 0;
  loop do
    if i >= bytes.size then break; fi
    hash = hash_mix(hash, bytes[i]);
    i = i + 1;
  done
  return hash;
}

pub fnc text_hash(Utf8Text text): int {
  return text_hash_borrow(rt borrow text);
}

fnc text_hash_borrow(borrow Utf8Text text): int {
  val projection_2 = text.bytes;
  return bytes_hash_borrow(rt borrow projection_2);
}

pub fnc value_hash(Value value): int {
  return value_hash_bounded(rt borrow value, 0, 128);
}

fnc value_hash_bounded(
  borrow Value value,
  int depth,
  int max_depth
): int {
  let int hash = hash_mix(1469598103934665603, value.kind);

  if depth > max_depth then
    return hash_mix(hash, 127);
  fi

  if value.kind == 0 then
    return hash;
  fi

  if value.kind == 1 then
    return hash_mix(hash, value.bool_value ? 1 : 0);
  fi

  if value.kind == 2 then
    val projection_3 = value.number_lexeme;
    return hash_mix(hash, bytes_hash_borrow(rt borrow projection_3));
  fi

  if value.kind == 3 then
    val projection_4 = value.string_value;
    return hash_mix(hash, text_hash_borrow(rt borrow projection_4));
  fi

  if value.kind == 4 then
    val projection_5 = value.bytes_value;
    return hash_mix(hash, bytes_hash_borrow(rt borrow projection_5));
  fi

  if value.kind == 5 then
    let int i = 0;
    loop do
      if i >= value.array_value.size then break; fi
      val projection_6 = value.array_value[i];
      hash = hash_mix(hash, value_hash_bounded(rt borrow projection_6, depth + 1, max_depth));
      i = i + 1;
    done
    return hash_mix(hash, value.array_value.size);
  fi

  if value.kind == 6 then
    let int aggregate_xor = 0;
    let int aggregate_sum = 0;

    let int i = 0;
    loop do
      if i >= value.object_value.size then break; fi
      val projection_7 = value.object_value[i].key;
      val projection_8 = value.object_value[i].value;
      let int pair_hash = hash_mix(
        text_hash_borrow(rt borrow projection_7),
        value_hash_bounded(rt borrow projection_8, depth + 1, max_depth)
      );
      aggregate_xor = aggregate_xor ^ pair_hash;
      aggregate_sum = aggregate_sum + pair_hash;
      i = i + 1;
    done

    hash = hash_mix(hash, aggregate_xor);
    hash = hash_mix(hash, aggregate_sum);
    return hash_mix(hash, value.object_value.size);
  fi

  if value.kind == 7 then
    hash = hash_mix(hash, value.extension_type);
    val projection_9 = value.bytes_value;
    return hash_mix(hash, bytes_hash_borrow(rt borrow projection_9));
  fi

  if value.kind == 8 then
    let int aggregate_xor = 0;
    let int aggregate_sum = 0;

    let int i = 0;
    loop do
      if i >= value.map_value.size then break; fi
      val projection_10 = value.map_value[i].key;
      val projection_11 = value.map_value[i].value;
      let int pair_hash = hash_mix(
        value_hash_bounded(rt borrow projection_10, depth + 1, max_depth),
        value_hash_bounded(rt borrow projection_11, depth + 1, max_depth)
      );
      aggregate_xor = aggregate_xor ^ pair_hash;
      aggregate_sum = aggregate_sum + pair_hash;
      i = i + 1;
    done

    hash = hash_mix(hash, aggregate_xor);
    hash = hash_mix(hash, aggregate_sum);
    return hash_mix(hash, value.map_value.size);
  fi

  return hash;
}

pub fnc value_deep_equal(Value left, Value right): bool {
  return value_deep_equal_bounded(rt borrow left, rt borrow right, 0, 128);
}

fnc value_deep_equal_bounded(
  borrow Value left,
  borrow Value right,
  int depth,
  int max_depth
): bool {
  if left == right then
    return true;
  fi

  if depth > max_depth then
    return false;
  fi

  if left.kind != right.kind then
    return false;
  fi

  if left.kind == 0 then
    return true;
  fi

  if left.kind == 1 then
    return left.bool_value == right.bool_value;
  fi

  if left.kind == 2 then
    val projection_12 = left.number_lexeme;
    val projection_13 = right.number_lexeme;
    return bytes_equal_borrow(rt borrow projection_12, rt borrow projection_13);
  fi

  if left.kind == 3 then
    val projection_14 = left.string_value;
    val projection_15 = right.string_value;
    return text_equal_borrow(rt borrow projection_14, rt borrow projection_15);
  fi

  if left.kind == 4 then
    val projection_16 = left.bytes_value;
    val projection_17 = right.bytes_value;
    return bytes_equal_borrow(rt borrow projection_16, rt borrow projection_17);
  fi

  if left.kind == 5 then
    if left.array_value.size != right.array_value.size then
      return false;
    fi

    let int i = 0;
    loop do
      if i >= left.array_value.size then
        break;
      fi
      val projection_18 = left.array_value[i];
      val projection_19 = right.array_value[i];
      if !value_deep_equal_bounded(
        rt borrow projection_18,
        rt borrow projection_19,
        depth + 1,
        max_depth
      ) then
        return false;
      fi
      i = i + 1;
    done
    return true;
  fi

  if left.kind == 6 then
    if left.object_value.size != right.object_value.size then
      return false;
    fi

    val Map<int, List<int>> buckets = new Map<int, List<int>>();
    val List<bool> used = new List<bool>();
    let int i = 0;

    loop do
      if i >= right.object_value.size then
        break;
      fi

      used.add(false);
      val projection_20 = right.object_value[i].key;

      let int hash = text_hash_borrow(rt borrow projection_20);
      if buckets.contains(hash) then
        val List<int> indices = buckets.get(hash);
        indices.add(i);
      else
        val List<int> indices = new List<int>();
        indices.add(i);
        buckets.set(hash, indices);
      fi
      i = i + 1;
    done

    let int outer = 0;
    loop do
      if outer >= left.object_value.size then break; fi
      val projection_21 = left.object_value[outer].key;
      let int hash = text_hash_borrow(rt borrow projection_21);
      if !buckets.contains(hash) then
        return false;
      fi

      let bool matched = false;
      val List<int> indices = buckets.get(hash);
      for const index of indices do
        if used[index] then
          continue;
        fi
        val projection_22 = left.object_value[outer].key;
        val projection_23 = right.object_value[index].key;
        val projection_24 = left.object_value[outer].value;
        val projection_25 = right.object_value[index].value;

        if text_equal_borrow(rt borrow projection_22, rt borrow projection_23) &&
           value_deep_equal_bounded(
             rt borrow projection_24,
             rt borrow projection_25,
             depth + 1, max_depth
           ) then
          used[index] = true;
          matched = true;
          break;
        fi
      done

      if !matched then
        return false;
      fi
      outer = outer + 1;
    done

    return true;
  fi

  if left.kind == 7 then
    if left.extension_type != right.extension_type then
      return false;
    fi
    val projection_26 = left.bytes_value;
    val projection_27 = right.bytes_value;
    return bytes_equal_borrow(rt borrow projection_26, rt borrow projection_27);
  fi

  if left.kind == 8 then
    if left.map_value.size != right.map_value.size then
      return false;
    fi

    val Map<int, List<int>> buckets = new Map<int, List<int>>();
    val List<bool> used = new List<bool>();
    let int i = 0;

    loop do
      if i >= right.map_value.size then
        break;
      fi

      used.add(false);
      val projection_28 = right.map_value[i].key;

      let int hash = value_hash_bounded(
        rt borrow projection_28,
        depth + 1,
        max_depth
      );

      if buckets.contains(hash) then
        val List<int> indices = buckets.get(hash);
        indices.add(i);
      else
        val List<int> indices = new List<int>();
        indices.add(i);
        buckets.set(hash, indices);
      fi
      i = i + 1;
    done

    let int outer = 0;
    loop do
      if outer >= left.map_value.size then break; fi
      val projection_29 = left.map_value[outer].key;
      let int hash = value_hash_bounded(rt borrow projection_29, depth + 1, max_depth);
      if !buckets.contains(hash) then
        return false;
      fi

      let bool matched = false;
      val List<int> indices = buckets.get(hash);
      for const index of indices do
        if used[index] then
          continue;
        fi
        val projection_30 = left.map_value[outer].key;
        val projection_31 = right.map_value[index].key;
        val projection_32 = left.map_value[outer].value;
        val projection_33 = right.map_value[index].value;

        if value_deep_equal_bounded(
             rt borrow projection_30,
             rt borrow projection_31,
             depth + 1, max_depth
           ) &&
           value_deep_equal_bounded(
             rt borrow projection_32,
             rt borrow projection_33,
             depth + 1, max_depth
           ) then
          used[index] = true;
          matched = true;
          break;
        fi
      done

      if !matched then
        return false;
      fi
      outer = outer + 1;
    done

    return true;
  fi

  return false;
}


pub fnc parse_int(Value value): IntParse {
  if value.kind != 2 then
    return new IntParse(false, 0);
  fi

  let List<int> bytes = value.number_lexeme;
  if bytes.size == 0 then
    return new IntParse(false, 0);
  fi

  let int i = 0;
  let bool negative = false;

  if bytes[0] == 45 then
    negative = true;
    i = 1;
    if i >= bytes.size then
      return new IntParse(false, 0);
    fi
  fi

  // Accumulate positive values positively and negative values negatively so
  // the signed minimum does not require a positive 2^63 intermediate.
  let int result = 0;

  loop do
    if i >= bytes.size then
      break;
    fi

    let int byte = bytes[i];
    if byte < 48 || byte > 57 then
      return new IntParse(false, 0);
    fi

    let int digit = byte - 48;

    if negative then
      // min int64 is (-9223372036854775807 - 1)
      if result < -922337203685477580 || (result == -922337203685477580 && digit > 8) then
        return new IntParse(false, 0);
      fi
      result = (result * 10) - digit;
    else
      if result > 922337203685477580 || (result == 922337203685477580 && digit > 7) then
        return new IntParse(false, 0);
      fi
      result = (result * 10) + digit;
    fi

    i = i + 1;
  done

  return new IntParse(true, result);
}


// Reflection-free traversal of values decoded from unknown wire schemas.
// String-key objects, arbitrary-key binary maps, and array indices all use
// the same closed Value key. This never materializes Java/JVM objects.
pub fnc value_lookup(Value container, Value key): Result<Value, String> {
  // The branches must be exclusive in the ownership checker: a successful
  // object lookup transfers container to object_get. Never inspect the moved
  // binding in a separate, subsequently checked if-expression.
  if container.kind == 6 then
    if key.kind != 3 then
      return Err("string-key object requires a UTF-8 string key");
    fi
    return object_get(container, key.string_value);
  elseif container.kind == 8 then
    for const entry of container.map_value do
      val projection_34 = entry.key;
      if value_deep_equal_bounded(rt borrow projection_34, rt borrow key, 0, 128) then
        return Ok(entry.value);
      fi
    done
    return Err("general map key not found");
  elseif container.kind == 5 then
    let IntParse index = parse_int(key);
    if !index.ok || index.value < 0 ||
       index.value >= container.array_value.size then
      return Err("array index must be an in-bounds integer");
    fi
    return Ok(container.array_value[index.value]);
  else
    return Err("dynamic lookup requires an object, map, or array");
  fi
}

// Path segments are Value strings for JSON/object keys, Value numbers for
// array indices, and arbitrary Values for MessagePack/CBOR map keys.
// Empty path denotes the root. Bounded iteration avoids unbounded paths.
pub fnc value_lookup_path(
  Value root,
  List<Value> segments
): Result<Value, String> {
  if segments.size > 128 then
    return Err("dynamic path exceeds maximum length of 128");
  fi

  return value_lookup_path_at(root, rt borrow segments, 0);
}

fnc value_lookup_path_at(Value current, borrow List<Value> segments, int offset): Result<Value, String> {
  if offset == segments.size then
    return Ok(current);
  else
    val Value segment = segments[offset];
    val Result<Value, String> next = value_lookup(current, segment);
    if next.is_err() then
      return Err("dynamic path segment not found or has wrong type");
    else
      return value_lookup_path_at(next.unwrap(), segments, offset + 1);
    fi
  fi
}
