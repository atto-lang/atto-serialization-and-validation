// Zorde's dynamic Value adapter to the compiler/core scalar constraint IR.
//
// The authoritative acceptance kernel is scalar_core.ores. This adapter
// ONLY extracts exact int64 or valid UTF-8 scalar metrics from wire Value;
// it does not reimplement bounds/holes and does not manufacture typed T.

import class Value, IntParse from '../core/value';
import fnc parse_int from '../core/value';
import fnc utf8_scalar_count from '../core/utf8_scalar';
import class ZordeCoreInterval from './scalar_core';
import fnc zorde_core_interval, zorde_core_interval_valid, zorde_core_interval_contains from './scalar_core';

// Shared request-bound byte budgets for ALL dynamic scalar adapters.
// The compiled registry and direct APIs must never diverge on work limits.
pub fnc zorde_scalar_max_number_bytes(): int { return 20; }
pub fnc zorde_scalar_max_string_bytes(): int { return 65536; }

pub fnc zorde_scalar_input_over_budget(Value value): bool {
  if value.kind == 2 then
    return value.number_lexeme.length > zorde_scalar_max_number_bytes();
  fi
  if value.kind == 3 then
    return value.string_value.bytes.length > zorde_scalar_max_string_bytes();
  fi
  return false;
}

pub define class ZordeScalarRule as
  // 2 = exact int64, 3 = UTF-8 string whose length uses Unicode scalars.
  pub val int kind;
  pub val ZordeCoreInterval interval;
end

pub fnc zorde_scalar_int(int minimum, int maximum, List<int> excluded): ZordeScalarRule {
  return new ZordeScalarRule(2, zorde_core_interval(minimum, maximum, excluded));
}

pub fnc zorde_scalar_string(int minimum, int maximum, List<int> excluded): ZordeScalarRule {
  return new ZordeScalarRule(3, zorde_core_interval(minimum, maximum, excluded));
}

pub fnc zorde_scalar_rule_valid(ZordeScalarRule rule): bool {
  if rule.kind != 2 && rule.kind != 3 then return false; fi
  return zorde_core_interval_valid(rt borrow rule.interval, rule.kind == 3);
}

pub fnc zorde_scalar_contains(ZordeScalarRule rule, int metric): bool {
  if !zorde_scalar_rule_valid(rt borrow rule) then return false; fi
  return zorde_core_interval_contains(
    rt borrow rule.interval, rule.kind == 3, metric);
}

pub fnc zorde_scalar_metric(Value value, ZordeScalarRule rule): IntParse {
  if !zorde_scalar_rule_valid(rt borrow rule) then return new IntParse(false, 0); fi
  if value.kind != rule.kind then return new IntParse(false, 0); fi
  // Direct scalar checks (including refinement and boolean acceptance)
  // must not bypass the same limits enforced by registry-based admission.
  if zorde_scalar_input_over_budget(rt borrow value) then
    return new IntParse(false, 0);
  fi
  if rule.kind == 2 then return parse_int(value); fi

  // Unicode scalar length is shared with compiler refinements and codecs.
  val int count = utf8_scalar_count(value.string_value.bytes);
  if count < 0 then return new IntParse(false, 0); fi
  return new IntParse(true, count);
}

pub fnc zorde_scalar_accepts(Value value, ZordeScalarRule rule): bool {
  val IntParse metric = zorde_scalar_metric(rt borrow value, rt borrow rule);
  if !metric.ok then return false; fi
  return zorde_scalar_contains(rt borrow rule, metric.value);
}
