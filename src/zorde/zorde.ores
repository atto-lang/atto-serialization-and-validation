// Zorde: ergonomic runtime schema validation over Oreslang's native
// reflection-free validation engine.
//
// Compiler refinement types should lower to the same semantic rule model.
// This module intentionally wraps the existing validation primitives rather
// than introducing a second validator.

import class Value, Utf8Text, IntParse from '../core/value';
import fnc parse_int from '../core/value';
import class ValidationOptions, ValidationReport, ValidationError, PathSegment, ValidValue, ValueRule, FieldRule, ObjectSchema from '../validation/validation';
import fnc default_validation_options, string_rule, number_rule, array_rule, field_rule, object_schema from '../validation/validation';
import fnc validate_value_checked, validate_object_checked from '../validation/validation';

pub define class ZordeValueSchema as
  pub val ValueRule rule;
end

pub define class ZordeObjectSchema as
  pub val ObjectSchema schema;
end

pub fnc zorde_string(
  int min_length,
  int max_length
): ZordeValueSchema {
  return new ZordeValueSchema(
    string_rule(
      min_length,
      max_length,
      false,
      false,
      false,
      false
    )
  );
}

pub fnc zorde_nonempty_string(): ZordeValueSchema {
  return zorde_string(1, -1);
}

pub fnc zorde_exact_string(int length): ZordeValueSchema {
  if length < 0 then
    // -1 means UNBOUNDED in the underlying ValueRule engine. Never allow
    // a negative exact-length request to silently become "any string".
    // -2 is an invalid rule sentinel: every checked parse returns invalid_rule.
    return zorde_string(-2, -2);
  fi
  return zorde_string(length, length);
}

pub fnc zorde_ascii_string(
  int min_length,
  int max_length
): ZordeValueSchema {
  return new ZordeValueSchema(
    string_rule(
      min_length,
      max_length,
      true,
      false,
      false,
      false
    )
  );
}

pub fnc zorde_email(): ZordeValueSchema {
  return new ZordeValueSchema(
    string_rule(
      3,
      254,
      true,
      true,
      false,
      false
    )
  );
}

pub fnc zorde_uuid(): ZordeValueSchema {
  return new ZordeValueSchema(
    string_rule(
      36,
      36,
      true,
      false,
      true,
      false
    )
  );
}

pub fnc zorde_url(): ZordeValueSchema {
  return new ZordeValueSchema(
    string_rule(
      1,
      -1,
      true,
      false,
      false,
      true
    )
  );
}

pub fnc zorde_number(
  bool has_min,
  float min_value,
  bool min_exclusive,
  bool has_max,
  float max_value,
  bool max_exclusive
): ZordeValueSchema {
  return new ZordeValueSchema(
    number_rule(
      has_min,
      min_value,
      min_exclusive,
      has_max,
      max_value,
      max_exclusive
    )
  );
}

pub fnc zorde_array(
  int min_items,
  int max_items,
  bool unique_items
): ZordeValueSchema {
  return new ZordeValueSchema(
    array_rule(
      min_items,
      max_items,
      unique_items
    )
  );
}

pub fnc zorde_field(
  Utf8Text key,
  bool required,
  bool forbidden,
  ZordeValueSchema schema
): FieldRule {
  return field_rule(
    key,
    required,
    forbidden,
    schema.rule
  );
}

pub fnc zorde_object(
  List<FieldRule> fields,
  bool reject_unknown_fields
): ZordeObjectSchema {
  return new ZordeObjectSchema(
    object_schema(
      fields,
      reject_unknown_fields
    )
  );
}

pub fnc zorde_parse(
  Value value,
  ZordeValueSchema schema
): Result<ValidValue, ValidationReport> {
  return validate_value_checked(
    value,
    schema.rule,
    default_validation_options()
  );
}

pub fnc zorde_parse_with(
  Value value,
  ZordeValueSchema schema,
  ValidationOptions options
): Result<ValidValue, ValidationReport> {
  return validate_value_checked(
    value,
    schema.rule,
    options
  );
}

pub fnc zorde_parse_object(
  Value value,
  ZordeObjectSchema schema
): Result<ValidValue, ValidationReport> {
  return validate_object_checked(
    value,
    schema.schema,
    default_validation_options()
  );
}

pub fnc zorde_parse_object_with(
  Value value,
  ZordeObjectSchema schema,
  ValidationOptions options
): Result<ValidValue, ValidationReport> {
  return validate_object_checked(
    value,
    schema.schema,
    options
  );
}


// Integer-exact schema and checked construction for compiler @Min/@Max/@Range
// lowering. Unlike generic ValueRule numbers, this never converts int64 to
// floating point. The result is an owned int, not a mutable ValidValue wrapper.
pub define class ZordeIntSchema as
  pub val bool has_min;
  pub val int min_value;
  pub val bool has_max;
  pub val int max_value;
end

pub fnc zorde_int_min(int minimum): ZordeIntSchema {
  return new ZordeIntSchema(true, minimum, false, 0);
}

pub fnc zorde_int_max(int maximum): ZordeIntSchema {
  return new ZordeIntSchema(false, 0, true, maximum);
}

pub fnc zorde_int_range(int minimum, int maximum): ZordeIntSchema {
  return new ZordeIntSchema(true, minimum, true, maximum);
}

fnc zorde_int_error(String code, String message): ValidationReport {
  val List<ValidationError> errors = new List<ValidationError>();
  errors.add(new ValidationError(
    code,
    new List<PathSegment>(),
    message,
    -1
  ));
  return new ValidationReport(errors, false);
}

pub fnc zorde_parse_int(
  Value value,
  ZordeIntSchema schema
): Result<int, ValidationReport> {
  if schema.has_min && schema.has_max &&
     schema.min_value > schema.max_value then
    return Err(zorde_int_error("invalid_rule", "numeric range is contradictory"));
  fi

  val IntParse parsed = parse_int(value);
  if !parsed.ok then
    return Err(zorde_int_error("type", "expected an exact signed integer"));
  fi

  if schema.has_min && parsed.value < schema.min_value then
    return Err(zorde_int_error("min", "integer is below the required minimum"));
  fi
  if schema.has_max && parsed.value > schema.max_value then
    return Err(zorde_int_error("max", "integer exceeds the permitted maximum"));
  fi
  return Ok(parsed.value);
}
