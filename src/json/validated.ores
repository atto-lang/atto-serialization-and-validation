// JSON decode + validation trust-boundary helper.
//
// Generated typed decoders will eventually fuse these checks into field
// construction. This dynamic path already gives callers one explicit operation
// that never returns an invalid Value as a successful result.

import class Value from '../core/value';
import class DecodeOptions, DecodeError, DecodeAttempt from '../core/options';
import class ValidationOptions, ValidationReport, ValidationError, ObjectSchema from '../validation/validation';
import fnc decode_attempt from './json';
import fnc validate_object, report_is_valid from '../validation/validation';

pub define class JsonPayloadError as
  // kind: 0 decode failure, 1 validation failure.
  pub val int kind;
  pub val DecodeError decode_error;
  pub val ValidationReport validation_report;
end

pub define class ValidatedDecodedValue as
  // Diagnostic-only dynamic Value, not an opaque proof.
  pub val Value value;
  pub val int consumed;
end

fnc empty_decode_error(): DecodeError {
  return new DecodeError("", 0, "");
}

fnc empty_validation_report(): ValidationReport {
  return new ValidationReport(new List<ValidationError>(), false);
}

pub fnc decode_and_validate_object(
  List<int> input,
  DecodeOptions decode_options,
  ObjectSchema schema,
  ValidationOptions validation_options
): Result<ValidatedDecodedValue, JsonPayloadError> {
  // A schema-bound trust boundary must not erase ambiguity *before* checking.
  // first_wins / last_wins drop duplicate evidence; trailing-data acceptance
  // lets a valid prefix masquerade as an admitted complete message.
  // Keep those policies available to generic decoders, but refuse them here.
  if decode_options.duplicate_key_policy != 0 ||
     decode_options.allow_trailing_data then
    return Err(new JsonPayloadError(
      0,
      new DecodeError("unsafe_decode_options", 0,
        "schema-bound JSON admission requires duplicate rejection and full input"),
      empty_validation_report()
    ));
  fi

  let DecodeAttempt attempt = imports::decode_attempt(input, decode_options);

  if attempt.status != 0 then
    return Err(new JsonPayloadError(0, attempt.error, empty_validation_report()));
  fi

  // Borrow checking requires a named owner, not a field projection.
  // Preserve the consumed-byte count separately before moving the value.
  val Value decoded_payload = attempt.value;
  val int consumed = attempt.consumed;
  let ValidationReport report = imports::validate_object(
    rt borrow decoded_payload,
    schema,
    validation_options
  );

  if !imports::report_is_valid(rt borrow report) then
    return Err(new JsonPayloadError(1, empty_decode_error(), report));
  fi

  return Ok(new ValidatedDecodedValue(
    decoded_payload,
    consumed
  ));
}
