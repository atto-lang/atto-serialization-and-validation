// Native MessagePack dynamic codec.
//
// Supports signed int64, uint64 values that fit Oreslang signed int, UTF-8
// strings, binary, arrays, string-key maps, boolean/null, and extensions.
// Float32/float64 remain explicit errors until exact portable float-bit
// primitives are available.

import class Value, Utf8Text, WireMember, MapEntry, IntParse, ValueWorkFuel, ValueHashAttempt from '../core/value';
import fnc value_null, value_bool, value_int, value_string, value_bytes, value_array, value_object, value_map, value_extension, value_hash_with_fuel, parse_int from '../core/value';
import fnc bytes_equal, encode_graph_shape_status, max_codec_key_work, metered_map_entry_index, remember_metered_map_entry, metered_map_keys_status from '../core/value';
import class DecodeOptions, EncodeOptions, DecodeError, EncodeError, DecodedValue, DecodeMaterializationBudget from '../core/options';
import fnc empty_decode_error, decode_error, encode_error, decode_options_valid, encode_options_valid, new_decode_materialization_budget, charge_decode_nodes, charge_decode_bytes, actor_decode_profile_valid from '../core/options';
import fnc utf8_is_valid from '../core/utf8';
import fnc byte_list_valid, byte_range_fits from '../core/bytes';

define class MsgpackCursor as
  pub val List<int> input;
  pub val DecodeOptions options;
  pub let int index;
  pub let bool failed;
  pub let DecodeError error;
  pub let ValueWorkFuel key_fuel;
  pub let DecodeMaterializationBudget materialization;
  pub val bool actor_bounded;
  pub let int actor_bytes_remaining;
  pub let int actor_work_remaining;
end

define class MsgpackWriter as
  pub let List<int> output;
  pub val EncodeOptions options;
  pub let bool failed;
  pub let EncodeError error;
  pub let ValueWorkFuel key_fuel;
end

fnc cursor_fail(
  borrow mut MsgpackCursor cursor,
  String code,
  String message
): void {
  if cursor.failed then
    return;
  fi
  cursor.failed = true;
  cursor.error = decode_error(code, cursor.index, message);
  return;
}

fnc writer_fail(
  borrow mut MsgpackWriter writer,
  String code,
  String message
): void {
  if writer.failed then
    return;
  fi
  writer.failed = true;
  writer.error = encode_error(code, message);
  return;
}

fnc read_u8(borrow mut MsgpackCursor cursor): int {
  if cursor.index >= cursor.input.length then
    cursor_fail(rt mut borrow cursor, "unexpected_eof", "truncated MessagePack value");
    return 0;
  fi

  let int value = cursor.input[cursor.index];
  if value < 0 || value > 255 then
    cursor_fail(rt mut borrow cursor, "invalid_byte", "MessagePack input bytes must be 0..255");
    return 0;
  fi

  cursor.index = cursor.index + 1;
  return value;
}

fnc read_uint_be(borrow mut MsgpackCursor cursor, int width): int {
  let int value = 0;
  let int i = 0;

  loop do
    if i >= width then
      break;
    fi

    let int byte = read_u8(rt mut borrow cursor);
    if cursor.failed then
      return 0;
    fi

    value = (value * 256) + byte;
    i = i + 1;
  done

  return value;
}

fnc read_signed(borrow mut MsgpackCursor cursor, int width): int {
  if width == 8 then
    let int first = read_u8(rt mut borrow cursor);
    if cursor.failed then
      return 0;
    fi

    let int value = first >= 128 ? first - 256 : first;
    let int i = 1;
    loop do
      if i >= 8 then
        break;
      fi
      value = (value * 256) + read_u8(rt mut borrow cursor);
      if cursor.failed then
        return 0;
      fi
      i = i + 1;
    done
    return value;
  fi

  let int raw = read_uint_be(rt mut borrow cursor, width);
  if cursor.failed then
    return 0;
  fi

  if width == 1 then
    return raw >= 128 ? raw - 256 : raw;
  fi

  if width == 2 then
    return raw >= 32768 ? raw - 65536 : raw;
  fi

  return raw >= 2147483648 ? raw - 4294967296 : raw;
}

fnc read_uint64_checked(borrow mut MsgpackCursor cursor): int {
  let int first = read_u8(rt mut borrow cursor);
  if cursor.failed then
    return 0;
  fi

  if first >= 128 then
    cursor_fail(
      rt mut borrow cursor,
      "uint64_range",
      "MessagePack uint64 exceeds Oreslang signed int range"
    );
    return 0;
  fi

  let int value = first;
  let int i = 1;
  loop do
    if i >= 8 then
      break;
    fi
    value = (value * 256) + read_u8(rt mut borrow cursor);
    if cursor.failed then
      return 0;
    fi
    i = i + 1;
  done
  return value;
}

fnc read_bytes(
  borrow mut MsgpackCursor cursor,
  int length,
  int limit,
  String limit_code
): List<int> {
  val List<int> output = new List<int>();

  if length < 0 then
    cursor_fail(rt mut borrow cursor, "invalid_length", "negative MessagePack length");
    return output;
  fi

  if length > limit then
    cursor_fail(rt mut borrow cursor, limit_code, "MessagePack payload exceeds configured limit");
    return output;
  fi

  if !byte_range_fits(cursor.input.length, cursor.index, length) then
    cursor_fail(rt mut borrow cursor, "unexpected_eof", "truncated MessagePack payload");
    return output;
  fi

  if !charge_decode_bytes(cursor.materialization, length) then
    cursor_fail(rt mut borrow cursor, "materialization_limit", "MessagePack cumulative decoded byte limit exhausted");
    return output;
  fi
  let int i = 0;
  loop do
    if i >= length then
      break;
    fi
    output.add(cursor.input[cursor.index + i]);
    i = i + 1;
  done

  cursor.index = cursor.index + length;
  return output;
}

fnc decode_string(
  borrow mut MsgpackCursor cursor,
  int length
): Value {
  let List<int> bytes = read_bytes(
    rt mut borrow cursor,
    length,
    cursor.options.max_string_bytes,
    "string_limit"
  );

  if cursor.failed then
    return value_null();
  fi

  if !utf8_is_valid(bytes) then
    cursor_fail(rt mut borrow cursor, "invalid_utf8", "MessagePack string contains invalid UTF-8");
    return value_null();
  fi

  return value_string(new Utf8Text(bytes));
}

fnc decode_array(
  borrow mut MsgpackCursor cursor,
  int count,
  int depth
): Value {
  val List<Value> values = new List<Value>();

  if count > cursor.options.max_array_entries then
    cursor_fail(rt mut borrow cursor, "array_limit", "MessagePack array exceeds max_array_entries");
    return value_array(values);
  fi

  // Reject impossible declared child counts before materializing children.
  if cursor.actor_bounded then
    if count > cursor.actor_work_remaining || count > (cursor.actor_bytes_remaining >> 7) then
      cursor_fail(rt mut borrow cursor, "actor_budget", "declared array children exceed remaining actor budget");
      return value_array(values);
    fi
  fi
  val int slots = cursor.materialization.nodes_remaining;
  if count < 0 || count > slots then
    cursor_fail(rt mut borrow cursor, "node_limit", "MessagePack cumulative child node limit exhausted");
    return value_array(values);
  fi

  let int i = 0;
  loop do
    if i >= count then
      break;
    fi

    let Value value = decode_value(rt mut borrow cursor, depth + 1);
    if cursor.failed then
      return value_array(values);
    fi

    values.add(value);
    i = i + 1;
  done

  return value_array(values);
}

fnc decode_map(
  borrow mut MsgpackCursor cursor,
  int count,
  int depth
): Value {
  val List<MapEntry> entries = new List<MapEntry>();
  val Map<int, List<int>> buckets = new Map<int, List<int>>();
  let bool all_text_keys = true;

  if count > cursor.options.max_map_entries then
    cursor_fail(rt mut borrow cursor, "map_limit", "MessagePack map exceeds max_map_entries");
    return value_map(entries);
  fi

  // Reject impossible declared child counts before materializing children.
  val int slots = cursor.materialization.nodes_remaining;
  if count < 0 || count > slots then
    cursor_fail(rt mut borrow cursor, "node_limit", "MessagePack cumulative child node limit exhausted");
    return value_map(entries);
  fi
  if count > slots - count then
    cursor_fail(rt mut borrow cursor, "node_limit", "MessagePack cumulative key/value node limit exhausted");
    return value_map(entries);
  fi

  let int i = 0;
  loop do
    if i >= count then
      break;
    fi

    let Value key = decode_value(rt mut borrow cursor, depth + 1);
    if cursor.failed then
      return value_map(entries);
    fi

    let Value member_value = decode_value(rt mut borrow cursor, depth + 1);
    if cursor.failed then
      return value_map(entries);
    fi

    if key.kind != 3 then
      all_text_keys = false;
    fi

    val ValueHashAttempt key_hash = value_hash_with_fuel(rt borrow key, cursor.key_fuel);
    if !key_hash.completed then
      cursor_fail(rt mut borrow cursor, "key_work_limit", "MessagePack map key hash work exhausted");
      return value_map(entries);
    fi
    let int existing = metered_map_entry_index(rt borrow entries, buckets,
      rt borrow key, key_hash.hash, cursor.key_fuel);
    if existing == -2 then
      cursor_fail(rt mut borrow cursor, "key_work_limit", "MessagePack map key comparison work exhausted");
      return value_map(entries);
    fi
    if existing >= 0 then
      if cursor.options.duplicate_key_policy == 0 then
        cursor_fail(rt mut borrow cursor, "duplicate_key", "duplicate MessagePack map key");
        return value_map(entries);
      elseif cursor.options.duplicate_key_policy == 2 then
        entries[existing] = new MapEntry(key, member_value);
      fi
    else
      let int index = entries.length;
      entries.add(new MapEntry(key, member_value));
      remember_metered_map_entry(buckets, key_hash.hash, index);
    fi

    i = i + 1;
  done

  if all_text_keys then
    val List<WireMember> members = new List<WireMember>();
    for const entry of entries do
      members.add(new WireMember(entry.key.string_value, entry.value));
    done
    return value_object(members);
  fi

  return value_map(entries);
}

fnc decode_extension(
  borrow mut MsgpackCursor cursor,
  int length
): Value {
  if length > cursor.options.max_binary_bytes then
    cursor_fail(rt mut borrow cursor, "binary_limit", "MessagePack extension exceeds max_binary_bytes");
    return value_null();
  fi

  let int raw_type = read_u8(rt mut borrow cursor);
  if cursor.failed then
    return value_null();
  fi

  let int extension_type = raw_type >= 128 ? raw_type - 256 : raw_type;
  let List<int> payload = read_bytes(
    rt mut borrow cursor,
    length,
    cursor.options.max_binary_bytes,
    "binary_limit"
  );

  if cursor.failed then
    return value_null();
  fi

  return value_extension(extension_type, payload);
}

// Binary integer conversion creates at most 20 decimal bytes. Reserve
// the worst case before allocating its lexical representation.
fnc decode_integer(borrow mut MsgpackCursor cursor, int number): Value {
  if cursor.failed then return value_null(); fi
  if !charge_decode_bytes(cursor.materialization, 20) then
    cursor_fail(rt mut borrow cursor, "materialization_limit", "MessagePack cumulative integer storage budget exhausted");
    return value_null();
  fi
  return value_int(number);
}

fnc decode_value(
  borrow mut MsgpackCursor cursor,
  int depth
): Value {
  if depth > cursor.options.max_depth then
    cursor_fail(rt mut borrow cursor, "depth_limit", "MessagePack nesting exceeds max_depth");
    return value_null();
  fi

  if cursor.actor_bounded then
    if cursor.actor_bytes_remaining < 128 || cursor.actor_work_remaining < 1 then
      cursor_fail(rt mut borrow cursor, "actor_budget", "cumulative actor decode budget exhausted");
      return value_null();
    fi
    cursor.actor_bytes_remaining = cursor.actor_bytes_remaining - 128;
    cursor.actor_work_remaining = cursor.actor_work_remaining - 1;
  fi
  if !charge_decode_nodes(cursor.materialization, 1) then
    cursor_fail(rt mut borrow cursor, "node_limit", "MessagePack cumulative materialized node limit exhausted");
    return value_null();
  fi
  let int marker = read_u8(rt mut borrow cursor);
  if cursor.failed then
    return value_null();
  fi

  // Restricted profile: no maps or extension dispatch at any depth.
  if cursor.actor_bounded && ((marker >= 128 && marker <= 143) ||
     marker == 222 || marker == 223 || (marker >= 199 && marker <= 201) ||
     (marker >= 212 && marker <= 216)) then
    cursor_fail(rt mut borrow cursor, "actor_profile", "actor profile does not admit maps or extensions");
    return value_null();
  fi

  // Positive fixint.
  if marker <= 127 then
    return decode_integer(rt mut borrow cursor, marker);
  fi

  // Fixmap.
  if marker >= 128 && marker <= 143 then
    return decode_map(rt mut borrow cursor, marker - 128, depth);
  fi

  // Fixarray.
  if marker >= 144 && marker <= 159 then
    return decode_array(rt mut borrow cursor, marker - 144, depth);
  fi

  // Fixstr.
  if marker >= 160 && marker <= 191 then
    return decode_string(rt mut borrow cursor, marker - 160);
  fi

  // Negative fixint.
  if marker >= 224 then
    return decode_integer(rt mut borrow cursor, marker - 256);
  fi

  if marker == 192 then
    return value_null();
  fi
  if marker == 194 then
    return value_bool(false);
  fi
  if marker == 195 then
    return value_bool(true);
  fi

  // Binary.
  if marker == 196 then
    let int length = read_u8(rt mut borrow cursor);
    return value_bytes(read_bytes(rt mut borrow cursor, length, cursor.options.max_binary_bytes, "binary_limit"));
  fi
  if marker == 197 then
    let int length = read_uint_be(rt mut borrow cursor, 2);
    return value_bytes(read_bytes(rt mut borrow cursor, length, cursor.options.max_binary_bytes, "binary_limit"));
  fi
  if marker == 198 then
    let int length = read_uint_be(rt mut borrow cursor, 4);
    return value_bytes(read_bytes(rt mut borrow cursor, length, cursor.options.max_binary_bytes, "binary_limit"));
  fi

  // Ext.
  if marker == 199 then
    val int argument = read_u8(rt mut borrow cursor);
    if cursor.failed then return value_null(); fi
    return decode_extension(rt mut borrow cursor, argument);
  fi
  if marker == 200 then
    val int argument = read_uint_be(rt mut borrow cursor, 2);
    if cursor.failed then return value_null(); fi
    return decode_extension(rt mut borrow cursor, argument);
  fi
  if marker == 201 then
    val int argument = read_uint_be(rt mut borrow cursor, 4);
    if cursor.failed then return value_null(); fi
    return decode_extension(rt mut borrow cursor, argument);
  fi

  // Float32 / Float64 are intentionally explicit unsupported markers.
  if marker == 202 || marker == 203 then
    cursor_fail(
      rt mut borrow cursor,
      "unsupported_float",
      "MessagePack float32/float64 require exact float-bit primitives"
    );
    return value_null();
  fi

  // Unsigned integer widths supported by an Oreslang signed int.
  if marker == 204 then
    val int argument = read_u8(rt mut borrow cursor);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi
  if marker == 205 then
    val int argument = read_uint_be(rt mut borrow cursor, 2);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi
  if marker == 206 then
    val int argument = read_uint_be(rt mut borrow cursor, 4);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi
  if marker == 207 then
    val int argument = read_uint64_checked(rt mut borrow cursor);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi

  // Signed integer widths.
  if marker == 208 then
    val int argument = read_signed(rt mut borrow cursor, 1);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi
  if marker == 209 then
    val int argument = read_signed(rt mut borrow cursor, 2);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi
  if marker == 210 then
    val int argument = read_signed(rt mut borrow cursor, 4);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi
  if marker == 211 then
    val int argument = read_signed(rt mut borrow cursor, 8);
    if cursor.failed then return value_null(); fi
    return decode_integer(rt mut borrow cursor, argument);
  fi

  // Fixed extension widths.
  if marker == 212 then
    return decode_extension(rt mut borrow cursor, 1);
  fi
  if marker == 213 then
    return decode_extension(rt mut borrow cursor, 2);
  fi
  if marker == 214 then
    return decode_extension(rt mut borrow cursor, 4);
  fi
  if marker == 215 then
    return decode_extension(rt mut borrow cursor, 8);
  fi
  if marker == 216 then
    return decode_extension(rt mut borrow cursor, 16);
  fi

  // Strings.
  if marker == 217 then
    val int argument = read_u8(rt mut borrow cursor);
    if cursor.failed then return value_null(); fi
    return decode_string(rt mut borrow cursor, argument);
  fi
  if marker == 218 then
    val int argument = read_uint_be(rt mut borrow cursor, 2);
    if cursor.failed then return value_null(); fi
    return decode_string(rt mut borrow cursor, argument);
  fi
  if marker == 219 then
    val int argument = read_uint_be(rt mut borrow cursor, 4);
    if cursor.failed then return value_null(); fi
    return decode_string(rt mut borrow cursor, argument);
  fi

  // Arrays and maps.
  if marker == 220 then
    val int argument = read_uint_be(rt mut borrow cursor, 2);
    if cursor.failed then return value_null(); fi
    return decode_array(rt mut borrow cursor, argument, depth);
  fi
  if marker == 221 then
    val int argument = read_uint_be(rt mut borrow cursor, 4);
    if cursor.failed then return value_null(); fi
    return decode_array(rt mut borrow cursor, argument, depth);
  fi
  if marker == 222 then
    val int argument = read_uint_be(rt mut borrow cursor, 2);
    if cursor.failed then return value_null(); fi
    return decode_map(rt mut borrow cursor, argument, depth);
  fi
  if marker == 223 then
    val int argument = read_uint_be(rt mut borrow cursor, 4);
    if cursor.failed then return value_null(); fi
    return decode_map(rt mut borrow cursor, argument, depth);
  fi

  cursor_fail(rt mut borrow cursor, "reserved_marker", "reserved or unsupported MessagePack marker");
  return value_null();
}

pub fnc decode(
  List<int> input,
  DecodeOptions options
): Result<DecodedValue, DecodeError> {
  return decode_with_budget(input, options, false, 0, 0);
}

// Logical credits, not actual allocator bytes or CPU instructions.
// Preserve the restricted actor profile from legacy PR #27.
pub fnc decode_actor_bounded(
  List<int> input,
  DecodeOptions options,
  int max_logical_bytes,
  int max_work
): Result<DecodedValue, DecodeError> {
  if !actor_decode_profile_valid(rt borrow options, input.length, max_logical_bytes, max_work) then
    return Err(decode_error("actor_budget", 0, "invalid actor decode profile or budget"));
  fi
  // Bound length before multiplication. Reserve wire costs once, before
  // the generic decoder validates/copies any bytes.
  val int wire_bytes = input.length * 16;
  val int wire_work = input.length * 3;
  if wire_bytes > max_logical_bytes - 128 || wire_work > max_work then
    return Err(decode_error("actor_budget", 0, "actor input budget exhausted"));
  fi
  return decode_with_budget(input, options, true,
    max_logical_bytes - 128 - wire_bytes, max_work - wire_work);
}

fnc decode_with_budget(
  List<int> input,
  DecodeOptions options,
  bool actor_bounded,
  int actor_bytes_remaining,
  int actor_work_remaining
): Result<DecodedValue, DecodeError> {
  if !decode_options_valid(rt borrow options) then
    return Err(decode_error("invalid_options", 0, "invalid or unsafe decode options"));
  fi

  if input.length > options.max_input_bytes then
    return Err(decode_error("input_limit", 0, "MessagePack input exceeds max_input_bytes"));
  fi

  if !byte_list_valid(input) then
    return Err(decode_error("invalid_byte", 0, "MessagePack input values must all be bytes 0..255"));
  fi

  val int input_length = input.length;
  val bool allow_trailing_data = options.allow_trailing_data;
  let mut MsgpackCursor cursor = new MsgpackCursor(
    input,
    options,
    0,
    false,
    empty_decode_error(),
    new ValueWorkFuel(max_codec_key_work()),
    new_decode_materialization_budget(),
    actor_bounded,
    actor_bytes_remaining,
    actor_work_remaining
  );

  let Value value = decode_value(rt mut borrow cursor, 0);

  if cursor.failed then
    return Err(cursor.error);
  fi

  if !allow_trailing_data && cursor.index != input_length then
    return Err(decode_error("trailing_data", cursor.index, "trailing bytes after MessagePack value"));
  fi

  return Ok(new DecodedValue(value, cursor.index));
}

fnc append_byte(borrow mut MsgpackWriter writer, int byte): void {
  if writer.failed then
    return;
  fi

  if byte < 0 || byte > 255 then
    writer_fail(rt mut borrow writer, "invalid_byte", "internal MessagePack byte outside 0..255");
    return;
  fi

  if writer.output.length >= writer.options.max_output_bytes then
    writer_fail(rt mut borrow writer, "output_limit", "MessagePack output exceeds max_output_bytes");
    return;
  fi

  writer.output.add(byte);
  return;
}

fnc append_uint_be(
  borrow mut MsgpackWriter writer,
  int value,
  int width
): void {
  let int divisor = 1;
  let int i = 1;

  loop do
    if i >= width then
      break;
    fi
    divisor = divisor * 256;
    i = i + 1;
  done

  let int remaining = value;
  let int j = 0;

  loop do
    if j >= width then
      break;
    fi

    let int byte = remaining / divisor;
    append_byte(rt mut borrow writer, byte);
    remaining = remaining % divisor;

    if divisor > 1 then
      divisor = divisor / 256;
    fi

    j = j + 1;
  done

  return;
}

fnc append_signed64(
  borrow mut MsgpackWriter writer,
  int value
): void {
  val List<int> reversed = new List<int>();
  let int current = value;
  let int i = 0;

  loop do
    if i >= 8 then
      break;
    fi

    let int byte = current % 256;
    if byte < 0 then
      byte = byte + 256;
    fi

    reversed.add(byte);
    current = (current - byte) / 256;
    i = i + 1;
  done

  let int j = 7;
  loop do
    if j < 0 then
      break;
    fi
    append_byte(rt mut borrow writer, reversed[j]);
    j = j - 1;
  done
  return;
}

fnc append_bytes(
  borrow mut MsgpackWriter writer,
  List<int> bytes
): void {
  for const byte of bytes do
    append_byte(rt mut borrow writer, byte);
    if writer.failed then
      return;
    fi
  done
  return;
}

fnc encode_integer(
  borrow mut MsgpackWriter writer,
  int value
): void {
  if value >= 0 && value <= 127 then
    append_byte(rt mut borrow writer, value);
    return;
  fi

  if value >= -32 && value < 0 then
    append_byte(rt mut borrow writer, 256 + value);
    return;
  fi

  if value >= 0 && value <= 255 then
    append_byte(rt mut borrow writer, 204);
    append_byte(rt mut borrow writer, value);
    return;
  fi

  if value >= 0 && value <= 65535 then
    append_byte(rt mut borrow writer, 205);
    append_uint_be(rt mut borrow writer, value, 2);
    return;
  fi

  if value >= 0 && value <= 4294967295 then
    append_byte(rt mut borrow writer, 206);
    append_uint_be(rt mut borrow writer, value, 4);
    return;
  fi

  if value >= 0 then
    append_byte(rt mut borrow writer, 207);
    append_uint_be(rt mut borrow writer, value, 8);
    return;
  fi

  if value >= -128 then
    append_byte(rt mut borrow writer, 208);
    append_byte(rt mut borrow writer, value < 0 ? 256 + value : value);
    return;
  fi

  if value >= -32768 then
    append_byte(rt mut borrow writer, 209);
    append_uint_be(rt mut borrow writer, value < 0 ? 65536 + value : value, 2);
    return;
  fi

  if value >= -2147483648 then
    append_byte(rt mut borrow writer, 210);
    append_uint_be(rt mut borrow writer, 4294967296 + value, 4);
    return;
  fi

  append_byte(rt mut borrow writer, 211);
  append_signed64(rt mut borrow writer, value);
  return;
}

fnc encode_string(
  borrow mut MsgpackWriter writer,
  Utf8Text text
): void {
  if !utf8_is_valid(text.bytes) then
    writer_fail(rt mut borrow writer, "invalid_utf8", "cannot encode invalid UTF-8 as MessagePack string");
    return;
  fi

  let int length = text.bytes.length;

  if length <= 31 then
    append_byte(rt mut borrow writer, 160 + length);
  elseif length <= 255 then
    append_byte(rt mut borrow writer, 217);
    append_byte(rt mut borrow writer, length);
  elseif length <= 65535 then
    append_byte(rt mut borrow writer, 218);
    append_uint_be(rt mut borrow writer, length, 2);
  else
    append_byte(rt mut borrow writer, 219);
    append_uint_be(rt mut borrow writer, length, 4);
  fi

  append_bytes(rt mut borrow writer, text.bytes);
  return;
}

fnc encode_binary(
  borrow mut MsgpackWriter writer,
  List<int> bytes
): void {
  let int length = bytes.length;

  if length <= 255 then
    append_byte(rt mut borrow writer, 196);
    append_byte(rt mut borrow writer, length);
  elseif length <= 65535 then
    append_byte(rt mut borrow writer, 197);
    append_uint_be(rt mut borrow writer, length, 2);
  else
    append_byte(rt mut borrow writer, 198);
    append_uint_be(rt mut borrow writer, length, 4);
  fi

  append_bytes(rt mut borrow writer, bytes);
  return;
}

fnc encode_extension(
  borrow mut MsgpackWriter writer,
  Value value
): void {
  if value.extension_type < -128 || value.extension_type > 127 then
    writer_fail(rt mut borrow writer, "extension_type", "MessagePack extension type must fit signed byte");
    return;
  fi

  let int length = value.bytes_value.length;

  if length == 1 then
    append_byte(rt mut borrow writer, 212);
  elseif length == 2 then
    append_byte(rt mut borrow writer, 213);
  elseif length == 4 then
    append_byte(rt mut borrow writer, 214);
  elseif length == 8 then
    append_byte(rt mut borrow writer, 215);
  elseif length == 16 then
    append_byte(rt mut borrow writer, 216);
  elseif length <= 255 then
    append_byte(rt mut borrow writer, 199);
    append_byte(rt mut borrow writer, length);
  elseif length <= 65535 then
    append_byte(rt mut borrow writer, 200);
    append_uint_be(rt mut borrow writer, length, 2);
  else
    append_byte(rt mut borrow writer, 201);
    append_uint_be(rt mut borrow writer, length, 4);
  fi

  append_byte(
    rt mut borrow writer,
    value.extension_type < 0 ? 256 + value.extension_type : value.extension_type
  );
  append_bytes(rt mut borrow writer, value.bytes_value);
  return;
}

fnc encode_value(
  borrow mut MsgpackWriter writer,
  Value value,
  int depth
): void {
  if writer.failed then
    return;
  fi

  if depth > writer.options.max_depth then
    writer_fail(rt mut borrow writer, "depth_limit", "MessagePack encoding exceeds max_depth");
    return;
  fi

  if value.kind == 0 then
    append_byte(rt mut borrow writer, 192);
    return;
  fi

  if value.kind == 1 then
    append_byte(rt mut borrow writer, value.bool_value ? 195 : 194);
    return;
  fi

  if value.kind == 2 then
    let IntParse parsed = parse_int(value);
    if !parsed.ok then
      writer_fail(
        rt mut borrow writer,
        "unsupported_number",
        "MessagePack encoder accepts exact integer number Values on this path"
      );
      return;
    fi
    encode_integer(rt mut borrow writer, parsed.value);
    return;
  fi

  if value.kind == 3 then
    encode_string(rt mut borrow writer, value.string_value);
    return;
  fi

  if value.kind == 4 then
    encode_binary(rt mut borrow writer, value.bytes_value);
    return;
  fi

  if value.kind == 5 then
    let int count = value.array_value.length;

    if count <= 15 then
      append_byte(rt mut borrow writer, 144 + count);
    elseif count <= 65535 then
      append_byte(rt mut borrow writer, 220);
      append_uint_be(rt mut borrow writer, count, 2);
    else
      append_byte(rt mut borrow writer, 221);
      append_uint_be(rt mut borrow writer, count, 4);
    fi

    for const item of value.array_value do
      encode_value(rt mut borrow writer, item, depth + 1);
      if writer.failed then
        return;
      fi
    done
    return;
  fi

  if value.kind == 6 then
    val List<MapEntry> object_entries = new List<MapEntry>();
    for const member of value.object_value do
      object_entries.add(new MapEntry(value_string(member.key), member.value));
    done
    val int key_status = metered_map_keys_status(rt borrow object_entries, writer.key_fuel);
    if key_status == 2 then
      writer_fail(rt mut borrow writer, "key_work_limit", "MessagePack object key work exhausted");
      return;
    fi
    if key_status == 1 then
      writer_fail(rt mut borrow writer, "duplicate_key", "cannot encode MessagePack object with duplicate keys");
      return;
    fi

    let int count = value.object_value.length;

    if count <= 15 then
      append_byte(rt mut borrow writer, 128 + count);
    elseif count <= 65535 then
      append_byte(rt mut borrow writer, 222);
      append_uint_be(rt mut borrow writer, count, 2);
    else
      append_byte(rt mut borrow writer, 223);
      append_uint_be(rt mut borrow writer, count, 4);
    fi

    for const member of value.object_value do
      encode_string(rt mut borrow writer, member.key);
      encode_value(rt mut borrow writer, member.value, depth + 1);
      if writer.failed then
        return;
      fi
    done
    return;
  fi

  if value.kind == 8 then
    val int key_status = metered_map_keys_status(rt borrow value.map_value, writer.key_fuel);
    if key_status == 2 then
      writer_fail(rt mut borrow writer, "key_work_limit", "MessagePack map key work exhausted");
      return;
    fi
    if key_status == 1 then
      writer_fail(rt mut borrow writer, "duplicate_key", "cannot encode MessagePack map with duplicate keys");
      return;
    fi

    let int count = value.map_value.length;

    if count <= 15 then
      append_byte(rt mut borrow writer, 128 + count);
    elseif count <= 65535 then
      append_byte(rt mut borrow writer, 222);
      append_uint_be(rt mut borrow writer, count, 2);
    else
      append_byte(rt mut borrow writer, 223);
      append_uint_be(rt mut borrow writer, count, 4);
    fi

    for const entry of value.map_value do
      encode_value(rt mut borrow writer, entry.key, depth + 1);
      encode_value(rt mut borrow writer, entry.value, depth + 1);
      if writer.failed then
        return;
      fi
    done
    return;
  fi


  if value.kind == 7 then
    encode_extension(rt mut borrow writer, value);
    return;
  fi

  writer_fail(rt mut borrow writer, "unsupported_value", "unknown dynamic Value kind");
  return;
}

pub fnc encode(
  Value value,
  EncodeOptions options
): Result<List<int>, EncodeError> {
  if !encode_options_valid(options) then
    return Err(encode_error("invalid_options", "invalid or unsafe encode options"));
  fi

  // A recursive key must not reach a hash before graph admission.
  val int graph_status = encode_graph_shape_status(rt borrow value,
    options.max_depth, options.max_output_bytes);
  if graph_status == 1 then
    return Err(encode_error("depth_limit", "encoding graph exceeds max_depth"));
  fi
  if graph_status == 2 then
    return Err(encode_error("output_limit", "graph cannot fit output byte limit"));
  fi
  if graph_status == 3 then
    return Err(encode_error("graph_limit", "expanded encoding graph exceeds node ceiling"));
  fi
  if graph_status != 0 then
    return Err(encode_error("unsupported_value", "unknown dynamic Value kind"));
  fi

  let mut MsgpackWriter writer = new MsgpackWriter(
    new List<int>(),
    options,
    false,
    new EncodeError("", ""),
    new ValueWorkFuel(max_codec_key_work())
  );

  encode_value(rt mut borrow writer, value, 0);

  if writer.failed then
    return Err(writer.error);
  fi

  return Ok(writer.output);
}
