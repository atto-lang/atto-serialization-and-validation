import fnc require_true, require_int from './assert';
import class ProtoField, ProtoMessage, ProtoDecodeOptions from '../src/protobuf/wire';
import fnc proto_varint, proto_bytes, proto_raw_varint, default_proto_decode_options from '../src/protobuf/wire';
import class ProtoZordeFieldRule from '../src/protobuf/zorde';
import fnc zorde_validate_protobuf_wire, zorde_validate_protobuf_input from '../src/protobuf/zorde';
import class ValidationReport from '../src/validation/validation';

pub fnc run_protobuf_zorde_tests(): void {
  val List<ProtoZordeFieldRule> rules = new List<ProtoZordeFieldRule>();
  rules.add(new ProtoZordeFieldRule(1, 0, true, 1, 10));
  rules.add(new ProtoZordeFieldRule(2, 2, false, 1, 4));

  val List<ProtoField> good_fields = new List<ProtoField>();
  good_fields.add(proto_varint(1, 17));
  good_fields.add(proto_bytes(2, new List<int>(65, 66)));
  val ValidationReport good = zorde_validate_protobuf_wire(
    new ProtoMessage(good_fields), rules, default_proto_decode_options(), true
  );
  require_int(good.errors.length, 0, "known Protobuf fields should satisfy rules");
  require_true(!good.truncated, "valid Protobuf report must not be truncated");

  val List<ProtoField> missing_fields = new List<ProtoField>();
  val ValidationReport missing = zorde_validate_protobuf_wire(
    new ProtoMessage(missing_fields), rules, default_proto_decode_options(), true
  );
  require_int(missing.errors.length, 1, "missing required field must reject");
  require_true(missing.errors[0].code == "missing-required", "missing field diagnostic");

  val List<ProtoField> unknown_fields = new List<ProtoField>();
  unknown_fields.add(proto_varint(19000, 9));
  unknown_fields.add(proto_varint(1, 1));
  val ValidationReport preserved = zorde_validate_protobuf_wire(
    new ProtoMessage(unknown_fields), rules, default_proto_decode_options(), false
  );
  require_int(preserved.errors.length, 0, "untyped reserved field can remain unknown");
  val ValidationReport strict = zorde_validate_protobuf_wire(
    new ProtoMessage(unknown_fields), rules, default_proto_decode_options(), true
  );
  require_int(strict.errors.length, 1, "strict descriptor must reject unknown field");
  require_true(strict.errors[0].code == "unknown-field", "unknown field diagnostic");
  require_int(strict.errors[0].path[0].index, 0, "unknown field reports field index");

  val List<ProtoZordeFieldRule> bad_rules = new List<ProtoZordeFieldRule>();
  bad_rules.add(new ProtoZordeFieldRule(19000, 0, false, 1, 10));
  val ValidationReport reserved_rule = zorde_validate_protobuf_wire(
    new ProtoMessage(good_fields), bad_rules, default_proto_decode_options(), true
  );
  require_true(reserved_rule.errors[0].code == "invalid_rule",
    "reserved field number must never enter trusted schema");

  val List<ProtoZordeFieldRule> impossible_rules = new List<ProtoZordeFieldRule>();
  impossible_rules.add(new ProtoZordeFieldRule(1, 0, true, 0, 10));
  val ValidationReport impossible = zorde_validate_protobuf_wire(
    new ProtoMessage(good_fields), impossible_rules, default_proto_decode_options(), true
  );
  require_true(impossible.errors[0].code == "invalid_rule",
    "required field with zero occurrences must be invalid descriptor");

  val List<ProtoZordeFieldRule> impossible_fixed = new List<ProtoZordeFieldRule>();
  impossible_fixed.add(new ProtoZordeFieldRule(2, 5, false, 1, 3));
  val ValidationReport too_short_fixed = zorde_validate_protobuf_wire(
    new ProtoMessage(good_fields), impossible_fixed, default_proto_decode_options(), true
  );
  require_true(too_short_fixed.errors[0].code == "invalid_rule",
    "fixed32 field budget less than four bytes must reject as rule");

  // A logical proto_varint has no raw payload bytes yet. Its encoded size
  // still counts toward the Zorde budget (e.g., 128 needs two bytes).
  val List<ProtoZordeFieldRule> tiny_varint_rules = new List<ProtoZordeFieldRule>();
  tiny_varint_rules.add(new ProtoZordeFieldRule(1, 0, true, 1, 1));
  val List<ProtoField> big_varint_fields = new List<ProtoField>();
  big_varint_fields.add(proto_varint(1, 128));
  val ValidationReport big_varint = zorde_validate_protobuf_wire(
    new ProtoMessage(big_varint_fields), tiny_varint_rules,
    default_proto_decode_options(), true
  );
  require_true(big_varint.errors[0].code == "out-of-range",
    "logical varint encoded size must count against field budget");

  val List<ProtoField> repeated = new List<ProtoField>();
  repeated.add(proto_varint(1, 1));
  repeated.add(proto_varint(1, 2));
  val ValidationReport repeat_report = zorde_validate_protobuf_wire(
    new ProtoMessage(repeated), rules, default_proto_decode_options(), true
  );
  require_true(repeat_report.errors[0].code == "out-of-range",
    "duplicate singular field must reject");

  val List<ProtoField> wrong_wire = new List<ProtoField>();
  wrong_wire.add(proto_bytes(1, new List<int>(1)));
  val ValidationReport wrong_type = zorde_validate_protobuf_wire(
    new ProtoMessage(wrong_wire), rules, default_proto_decode_options(), true
  );
  require_true(wrong_type.errors[0].code == "wrong-type",
    "descriptor must not coerce wire types");

  val List<ProtoField> bad_shape = new List<ProtoField>();
  bad_shape.add(proto_raw_varint(1, new List<int>(128)));
  val ValidationReport malformed = zorde_validate_protobuf_wire(
    new ProtoMessage(bad_shape), rules, default_proto_decode_options(), true
  );
  require_true(malformed.errors[0].code == "wrong-type",
    "syntactically malformed raw varint must reject");

  // A payload-only calculation could admit this one-byte varint at a
  // max_input_bytes=1 boundary. The on-wire field key adds another byte.
  val List<ProtoField> tiny_field = new List<ProtoField>();
  tiny_field.add(proto_varint(1, 1));
  val ValidationReport encoded_budget = zorde_validate_protobuf_wire(
    new ProtoMessage(tiny_field), new List<ProtoZordeFieldRule>(),
    new ProtoDecodeOptions(1, 1, 1), false
  );
  require_true(encoded_budget.errors[0].code == "out-of-range",
    "wire budget must count field key, not just payload");

  val ValidationReport encoded_budget_exact = zorde_validate_protobuf_wire(
    new ProtoMessage(tiny_field), new List<ProtoZordeFieldRule>(),
    new ProtoDecodeOptions(2, 1, 2), false
  );
  require_int(encoded_budget_exact.errors.length, 0,
    "canonical two-byte field should fit exact message budget");

  // The extra length varint also consumes a wire byte.
  val List<ProtoField> tiny_delimited = new List<ProtoField>();
  tiny_delimited.add(proto_bytes(1, new List<int>(77)));
  val ValidationReport length_budget = zorde_validate_protobuf_wire(
    new ProtoMessage(tiny_delimited), new List<ProtoZordeFieldRule>(),
    new ProtoDecodeOptions(2, 1, 1), false
  );
  require_true(length_budget.errors[0].code == "out-of-range",
    "length-delimited field budget must include length prefix");

  val ValidationReport length_budget_exact = zorde_validate_protobuf_wire(
    new ProtoMessage(tiny_delimited), new List<ProtoZordeFieldRule>(),
    new ProtoDecodeOptions(3, 1, 1), false
  );
  require_int(length_budget_exact.errors.length, 0,
    "three-byte field with one-byte payload should fit exact budget");

  // Full byte accounting must accumulate across fields rather than reset.
  val List<ProtoField> two_fields = new List<ProtoField>();
  two_fields.add(proto_varint(1, 1));
  two_fields.add(proto_varint(2, 2));
  val ValidationReport aggregate_budget = zorde_validate_protobuf_wire(
    new ProtoMessage(two_fields), new List<ProtoZordeFieldRule>(),
    new ProtoDecodeOptions(3, 2, 3), false
  );
  require_true(aggregate_budget.errors[0].code == "out-of-range",
    "multi-field canonical total must respect max_input_bytes");

  // Original-wire admission counts every input byte. Nonminimal field keys
  // and length prefixes get normalized when decoded into ProtoMessage;
  // validation of an already parsed envelope alone cannot prove their size.
  val List<ProtoZordeFieldRule> raw_field_rules = new List<ProtoZordeFieldRule>();
  raw_field_rules.add(new ProtoZordeFieldRule(1, 0, true, 1, 1));
  val List<int> overlong_key = new List<int>(136, 0, 1);
  val ValidationReport key_over_original_limit = zorde_validate_protobuf_input(
    overlong_key, raw_field_rules, new ProtoDecodeOptions(2, 1, 2), true
  );
  require_int(key_over_original_limit.errors.length, 1,
    "original overlong key must exceed two-byte input budget");
  require_true(key_over_original_limit.errors[0].code == "wire-decode",
    "bounded original-wire decode must fail before Zorde field admission");

  val ValidationReport key_at_original_limit = zorde_validate_protobuf_input(
    overlong_key, raw_field_rules, new ProtoDecodeOptions(3, 1, 3), true
  );
  require_int(key_at_original_limit.errors.length, 0,
    "original three-byte key and value must pass an exact three-byte limit");

  val List<ProtoZordeFieldRule> raw_bytes_rules = new List<ProtoZordeFieldRule>();
  raw_bytes_rules.add(new ProtoZordeFieldRule(1, 2, true, 1, 1));
  val List<int> overlong_length = new List<int>(10, 129, 0, 65);
  val ValidationReport length_over_original_limit = zorde_validate_protobuf_input(
    overlong_length, raw_bytes_rules, new ProtoDecodeOptions(3, 1, 1), true
  );
  require_int(length_over_original_limit.errors.length, 1,
    "original overlong length prefix must exceed three-byte budget");
  require_true(length_over_original_limit.errors[0].code == "wire-decode",
    "original length-prefix budget failure must be a wire decode diagnostic");

  val ValidationReport length_at_original_limit = zorde_validate_protobuf_input(
    overlong_length, raw_bytes_rules, new ProtoDecodeOptions(4, 1, 1), true
  );
  require_int(length_at_original_limit.errors.length, 0,
    "four original wire bytes must fit a four-byte input budget");

  val ValidationReport malformed_input = zorde_validate_protobuf_input(
    new List<int>(10, 5, 65), raw_bytes_rules,
    new ProtoDecodeOptions(16, 1, 16), true
  );
  require_int(malformed_input.errors.length, 1,
    "truncated raw length-delimited input must refuse");
  require_true(malformed_input.errors[0].code == "wire-decode",
    "malformed original bytes must not yield a typed Zorde field report");

  val ValidationReport rejected_unknown_input = zorde_validate_protobuf_input(
    new List<int>(8, 1), new List<ProtoZordeFieldRule>(),
    new ProtoDecodeOptions(2, 1, 2), true
  );
  require_int(rejected_unknown_input.errors.length, 1,
    "original input admission must preserve unknown-field policy");
  require_true(rejected_unknown_input.errors[0].code == "unknown-field",
    "raw-input path must still apply Zorde unknown policy");

  // Report budgets are explicit; do not allow adversarial repeated errors to
  // allocate an unbounded ValidationReport.
  val List<ProtoField> many_unknown = new List<ProtoField>();
  let int i = 0;
  loop do
    if i >= 70 then
      break;
    fi
    many_unknown.add(proto_varint(100, i));
    i = i + 1;
  done
  val ValidationReport capped = zorde_validate_protobuf_wire(
    new ProtoMessage(many_unknown), rules, default_proto_decode_options(), true
  );
  require_int(capped.errors.length, 64, "Zorde Protobuf issue budget");
  require_true(capped.truncated, "Zorde report indicates excess diagnostics");
  return;
}
