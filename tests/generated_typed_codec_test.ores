import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember, IntParse from '../src/core/value';
import fnc value_string, value_int, value_object, object_get, parse_int from '../src/core/value';
import class DecodeOptions, EncodeOptions, EncodeError from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import class CodecFieldMeta, CodecTypeMeta from '../src/schema/metadata';
import fnc codec_field, codec_type from '../src/schema/metadata';
import class DecodedObject, ObjectCodecError, ObjectDecodeAttempt from '../src/schema/object_codec';
import class MetadataError from '../src/schema/metadata';
import class DecodeError from '../src/core/options';
import class ValidationReport, ValidationError, PathSegment from '../src/validation/validation';
import fnc decode_json_object, decode_json_object_attempt, decode_messagepack_object_attempt from '../src/schema/object_codec';
import fnc kind_rule, string_rule, default_validation_options from '../src/validation/validation';
import fnc encode from '../src/json/json';

define class User as
  pub val Utf8Text display_name;
  pub val int age;
end

fnc user_metadata(): CodecTypeMeta {
  val List<CodecFieldMeta> fields = new List<CodecFieldMeta>();
  fields.push(codec_field(
    new Utf8Text(new List<int>(100, 105, 115, 112, 108, 97, 121, 95, 110, 97, 109, 101)),
    new Utf8Text(new List<int>(100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101)),
    1, true, string_rule(1, 120, false, false, false, false)
  ));
  fields.push(codec_field(
    new Utf8Text(new List<int>(97, 103, 101)),
    new Utf8Text(new List<int>(97, 103, 101)),
    2, true, kind_rule(2)
  ));
  return codec_type(new Utf8Text(new List<int>(85, 115, 101, 114)), fields, 1);
}

fnc decode_user(List<int> input): Result<User, ObjectCodecError> {
  let ObjectDecodeAttempt attempt = decode_json_object_attempt(
    input,
    default_decode_options(),
    user_metadata(),
    default_validation_options()
  );
  return construct_user(attempt);
}

fnc decode_user_messagepack(List<int> input): Result<User, ObjectCodecError> {
  let ObjectDecodeAttempt attempt = decode_messagepack_object_attempt(
    input, default_decode_options(), user_metadata(), default_validation_options()
  );
  return construct_user(attempt);
}

fnc user_conversion_error(): ObjectCodecError {
  let List<ValidationError> errors = new List<ValidationError>();
  errors.push(new ValidationError(
    "typed_conversion",
    new List<PathSegment>(),
    "generated User codec could not convert a validated field",
    -1
  ));
  return new ObjectCodecError(
    2, new MetadataError("", -1, ""), new DecodeError("", 0, ""),
    new ValidationReport(errors, false)
  );
}

fnc construct_user(ObjectDecodeAttempt attempt): Result<User, ObjectCodecError> {
  if attempt.status != 0 then
    return Err(attempt.error);
  fi

  let Value source = attempt.decoded.source_object;
  let Result<Value, String> name_value = object_get(
    rt borrow source,
    new Utf8Text(new List<int>(100, 105, 115, 112, 108, 97, 121, 95, 110, 97, 109, 101))
  );
  let Result<Value, String> age_value = object_get(
    rt borrow source,
    new Utf8Text(new List<int>(97, 103, 101))
  );

  if name_value.is_err() || age_value.is_err() then
    return Err(user_conversion_error());
  fi
  let Value name = name_value.unwrap();
  let Value age_wire = age_value.unwrap();
  let IntParse age = parse_int(age_wire);

  if name.kind != 3 || !age.ok then
    return Err(user_conversion_error());
  fi
  return Ok(new User(name.string_value, age.value));
}

fnc encode_user(User user): Result<List<int>, EncodeError> {
  val List<WireMember> members = new List<WireMember>();
  members.push(new WireMember(
    new Utf8Text(new List<int>(100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101)),
    value_string(user.display_name)
  ));
  members.push(new WireMember(new Utf8Text(new List<int>(97, 103, 101)), value_int(user.age)));
  return encode(value_object(members), default_encode_options());
}

fnc user_json_bytes(): List<int> {
  return new List<int>(
    123,
    34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34,
    58,
    34, 65, 108, 101, 120, 34,
    44,
    34, 97, 103, 101, 34,
    58,
    52, 50,
    125
  );
}

fnc require_user_codec_bytes(List<int> actual, List<int> expected): void {
  require_int(actual.length, expected.length, "generated typed JSON byte count");
  let int i = 0;
  loop do
    if i >= expected.length then
      break;
    fi
    require_int(actual[i], expected[i], "generated typed JSON byte mismatch");
    i = i + 1;
  done
  return;
}

fnc user_messagepack_bytes(): List<int> {
  return new List<int>(130, 171, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 164, 65, 108, 101, 120, 163, 97, 103, 101, 42);
}

fnc require_unsafe_policy_denied(ObjectDecodeAttempt attempt): void {
  require_int(attempt.status, 2, "unsafe typed policy must be a decode failure");
  require_int(attempt.error.kind, 1, "unsafe typed policy error kind");
  require_true(attempt.error.decode_error.code == "unsafe_decode_options", "unsafe typed policy diagnostic");
  require_int(attempt.decoded.consumed, 0, "unsafe typed policy must publish no consumed bytes");
  require_int(attempt.decoded.source_object.object_value.length, 0, "unsafe typed policy must publish no source fields");
  require_int(attempt.decoded.wire_object.object_value.length, 0, "unsafe typed policy must publish no wire fields");
  return;
}

fnc unsafe_policy(int duplicate, bool trailing): DecodeOptions {
  return new DecodeOptions(duplicate, trailing, 128, 512, 512, 512, 512, 16, 16);
}

fnc check_typed_policy_gate(int duplicate, bool trailing): void {
  require_unsafe_policy_denied(decode_json_object_attempt(
    user_json_bytes(), unsafe_policy(duplicate, trailing), user_metadata(), default_validation_options()
  ));
  require_unsafe_policy_denied(decode_messagepack_object_attempt(
    user_messagepack_bytes(), unsafe_policy(duplicate, trailing), user_metadata(), default_validation_options()
  ));
  return;
}

pub fnc run_generated_typed_codec_tests(): void {
  // Refuse unsafe policy even for clean, otherwise valid full frames.
  check_typed_policy_gate(1, false);
  check_typed_policy_gate(2, false);
  check_typed_policy_gate(0, true);

  val List<int> input = user_json_bytes();
  val int expected_length = input.length;

  let Result<User, ObjectCodecError> typed = decode_user(user_json_bytes());
  require_true(typed.is_err() == false, "generated typed decoder must succeed");
  val User typed_user = typed.unwrap();
  require_int(typed_user.age, 42, "generated typed decoder age");
  require_user_codec_bytes(typed_user.display_name.bytes, new List<int>(65, 108, 101, 120));

  let Result<DecodedObject, ObjectCodecError> projected = decode_json_object(
    input,
    default_decode_options(),
    user_metadata(),
    default_validation_options()
  );
  require_true(projected.is_err() == false, "typed codec projection must succeed");

  let Value source = projected.unwrap().source_object;
  let Result<Value, String> age_value = object_get(
    source,
    new Utf8Text(new List<int>(97, 103, 101))
  );
  require_true(age_value.is_err() == false, "typed age field must exist");
  let IntParse age = parse_int(age_value.unwrap());
  require_true(age.ok, "typed age must parse as int");
  require_int(age.value, 42, "typed integer extraction");

  val List<int> wrong_age_type = new List<int>(
    123,
    34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34,
    58,
    34, 65, 108, 101, 120, 34,
    44,
    34, 97, 103, 101, 34,
    58,
    34, 52, 50, 34,
    125
  );
  val Result<User, ObjectCodecError> wrong_age = decode_user(wrong_age_type);
  require_true(wrong_age.is_err(), "generated int field must reject a JSON string before construction");

  val User user = new User(new Utf8Text(new List<int>(65, 108, 101, 120)), age.value);
  val Result<List<int>, EncodeError> encoded = encode_user(user);
  require_true(encoded.is_err() == false, "generated typed encoder must succeed");
  val List<int> encoded_bytes = encoded.unwrap();
  require_int(encoded_bytes.length, expected_length, "generated typed JSON output length");
  require_user_codec_bytes(encoded_bytes, user_json_bytes());

  let Result<User, ObjectCodecError> roundtrip = decode_user(encoded_bytes);
  require_true(roundtrip.is_err() == false, "typed encode/decode roundtrip must succeed");
  val User restored = roundtrip.unwrap();
  require_int(restored.age, 42, "typed roundtrip age");
  require_user_codec_bytes(restored.display_name.bytes, new List<int>(65, 108, 101, 120));

  // {"age":42} omits the required displayName field.
  let Result<User, ObjectCodecError> missing = decode_user(new List<int>(123, 34, 97, 103, 101, 34, 58, 52, 50, 125));
  require_true(missing.is_err(), "typed decoder must reject missing required field");

  // {"displayName":"Alex","age":42,"x":0} violates unknown-field policy 1.
  let Result<User, ObjectCodecError> extra = decode_user(new List<int>(
    123, 34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34,
    58, 34, 65, 108, 101, 120, 34, 44, 34, 97, 103, 101, 34,
    58, 52, 50, 44, 34, 120, 34, 58, 48, 125
  ));
  require_true(extra.is_err(), "typed decoder must reject unknown field");
  let Result<User, ObjectCodecError> duplicate = decode_user(new List<int>(123, 34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34, 58, 34, 65, 108, 101, 120, 34, 44, 34, 97, 103, 101, 34, 58, 52, 50, 44, 34, 97, 103, 101, 34, 58, 52, 51, 125));
  require_true(duplicate.is_err(), "typed decoder must reject duplicate field");

  let Result<User, ObjectCodecError> trailing = decode_user(new List<int>(123, 34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34, 58, 34, 65, 108, 101, 120, 34, 44, 34, 97, 103, 101, 34, 58, 52, 50, 125, 123, 125));
  require_true(trailing.is_err(), "typed decoder must reject trailing data");

  let Result<User, ObjectCodecError> overflow = decode_user(new List<int>(123, 34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34, 58, 34, 65, 108, 101, 120, 34, 44, 34, 97, 103, 101, 34, 58, 57, 50, 50, 51, 51, 55, 50, 48, 51, 54, 56, 53, 52, 55, 55, 53, 56, 48, 56, 125));
  require_true(overflow.is_err(), "typed decoder must reject signed integer overflow");

  let Result<User, ObjectCodecError> fraction = decode_user(new List<int>(123, 34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34, 58, 34, 65, 108, 101, 120, 34, 44, 34, 97, 103, 101, 34, 58, 52, 50, 46, 53, 125));
  require_true(fraction.is_err(), "typed decoder must reject fractional integer field");

  // Same nominal value as JSON, with the shared fixed MessagePack wire vector.
  let Result<User, ObjectCodecError> packed = decode_user_messagepack(new List<int>(130, 171, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 164, 65, 108, 101, 120, 163, 97, 103, 101, 42));
  require_true(!packed.is_err(), "typed MessagePack construction must succeed");
  val User unpacked = packed.unwrap();
  require_int(unpacked.age, 42, "typed MessagePack age");
  require_user_codec_bytes(unpacked.display_name.bytes, new List<int>(65, 108, 101, 120));
  let Result<User, ObjectCodecError> packed_missing = decode_user_messagepack(new List<int>(129, 163, 97, 103, 101, 42));
  require_true(packed_missing.is_err(), "typed MessagePack missing required field must reject");
  let Result<User, ObjectCodecError> packed_wrong = decode_user_messagepack(new List<int>(130, 171, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 164, 65, 108, 101, 120, 163, 97, 103, 101, 162, 52, 50));
  require_true(packed_wrong.is_err(), "typed MessagePack wrong age type must reject");
  let Result<User, ObjectCodecError> packed_duplicate = decode_user_messagepack(new List<int>(131, 171, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 164, 65, 108, 101, 120, 163, 97, 103, 101, 42, 163, 97, 103, 101, 43));
  require_true(packed_duplicate.is_err(), "typed MessagePack duplicate age must reject");
  let Result<User, ObjectCodecError> packed_suffix = decode_user_messagepack(new List<int>(130, 171, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 164, 65, 108, 101, 120, 163, 97, 103, 101, 42, 0));
  require_true(packed_suffix.is_err(), "typed MessagePack trailing byte must reject");
  let Result<User, ObjectCodecError> packed_scalar = decode_user_messagepack(new List<int>(42));
  require_true(packed_scalar.is_err(), "typed MessagePack scalar root must reject");
  let Result<User, ObjectCodecError> packed_extra = decode_user_messagepack(new List<int>(131, 171, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 164, 65, 108, 101, 120, 163, 97, 103, 101, 42, 161, 120, 0));
  require_true(packed_extra.is_err(), "typed MessagePack unknown field must reject");
  let Result<User, ObjectCodecError> packed_truncated = decode_user_messagepack(new List<int>(130, 171, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 164, 65, 108, 101, 120, 163, 97, 103, 101));
  require_true(packed_truncated.is_err(), "typed MessagePack truncated value must reject");
  let Result<User, ObjectCodecError> packed_nonstring = decode_user_messagepack(new List<int>(129, 1, 42));
  require_true(packed_nonstring.is_err(), "typed MessagePack non-string key must reject");
  return;
}
