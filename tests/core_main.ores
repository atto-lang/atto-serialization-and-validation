import fnc run_int64_decimal_codec_tests from './int64_decimal_codec_test';
import fnc run_json_tests from './json_test';
import fnc run_messagepack_tests from './messagepack_test';
import fnc run_cbor_tests from './cbor_test';
import fnc run_protobuf_tests from './protobuf_test';
import fnc run_validation_tests from './validation_test';
import fnc run_refined_int_zorde_tests from './refined_int_zorde_test';
import fnc run_refined_string_zorde_tests from './refined_string_zorde_test';
import fnc run_metadata_tests from './metadata_test';
import fnc run_object_codec_tests from './object_codec_test';
import fnc run_generated_typed_codec_tests from './generated_typed_codec_test';

pub fnc main(): void {
  imports::run_json_tests();
  imports::run_messagepack_tests();
  imports::run_cbor_tests();
  imports::run_protobuf_tests();
  imports::run_validation_tests();
  imports::run_refined_int_zorde_tests();
  imports::run_refined_string_zorde_tests();
  imports::run_int64_decimal_codec_tests();
  imports::run_metadata_tests();
  imports::run_object_codec_tests();
  imports::run_generated_typed_codec_tests();

  stdio.stdout.println("serialization/validation core tests passed");
  return;
}
