import class WireHashIndex from '../src/core/wire_hash_index';
import fnc require_int from './assert';

pub fnc main(): void {
  val WireHashIndex index = new WireHashIndex(4, 8);
  imports::require_int(index.insert(7), 0, "first index");
  imports::require_int(index.insert(11), 1, "same slot different hash");
  imports::require_int(index.insert(7), 2, "same hash candidate");
  imports::require_int(index.insert(-1), 3, "negative hash");
  imports::require_int(index.insert(99), -1, "capacity refusal");
  imports::require_int(index.find(7, -1), 2, "latest matching hash");
  imports::require_int(index.find(7, 2), 0, "collision candidate after previous");
  imports::require_int(index.find(7, 0), -1, "chain exhausted");
  imports::require_int(index.find(-1, -1), 3, "negative hash lookup");
  imports::require_int(index.find(7, 1), -2, "wrong hash cursor rejected");
  imports::require_int(index.find(7, 4), -2, "invalid cursor rejected");
  val WireHashIndex limited = new WireHashIndex(2, 1);
  imports::require_int(limited.insert(1), 0, "budget test first");
  imports::require_int(limited.insert(3), 1, "budget test collision");
  imports::require_int(limited.find(1, -1), -2, "collision budget exhausted");
  imports::require_int(limited.find(3, -1), -2, "budget cannot reset");
  val WireHashIndex disabled = new WireHashIndex(1000001, 1);
  imports::require_int(disabled.insert(0), -1, "invalid capacity disabled");
  stdio.stdout.println("isolated wire hash index guest passed");
  return;
}
