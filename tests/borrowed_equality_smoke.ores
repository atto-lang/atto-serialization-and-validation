// Focused native regression for the existing legacy .ores Zorde fixture
// suite. Does not import the codec front ends or synthetic test stubs.
import fnc require_true from './assert';
import class Value, Utf8Text, WireMember, MapEntry from '../src/core/value';
import fnc value_int, value_array, value_object, value_map, value_lookup, value_deep_equal_borrow from '../src/core/value';

// Use the compiler-supported empty List constructor followed by add().
fnc single_byte_key(int byte): Utf8Text {
  val List<int> bytes = new List<int>();
  bytes.add(byte);
  return new Utf8Text(bytes);
}

pub fnc main(): void {
  stdio.stdout.println("zorde borrow smoke stage 0 entry");
  val List<MapEntry> entries = new List<MapEntry>();
  entries.add(new MapEntry(value_int(10), value_int(90)));
  entries.add(new MapEntry(value_int(20), value_int(91)));
  entries.add(new MapEntry(value_int(30), value_int(92)));
  stdio.stdout.println("zorde borrow smoke stage 1 map-created");
  val Result<Value, String> found = value_lookup(
    value_map(entries), value_int(30)
  );
  require_true(!found.is_err(), "borrowed map lookup must reach third key");
  require_true(found.unwrap().number_lexeme[0] == 57,
    "borrowed lookup must return matching value");

  stdio.stdout.println("zorde borrow smoke stage 2 lookup-matched");
  val List<MapEntry> absent_entries = new List<MapEntry>();
  absent_entries.add(new MapEntry(value_int(10), value_int(90)));
  absent_entries.add(new MapEntry(value_int(20), value_int(91)));
  val Result<Value, String> absent = value_lookup(
    value_map(absent_entries), value_int(99)
  );
  require_true(absent.is_err(), "borrowed map lookup must reject absent key");

  stdio.stdout.println("zorde borrow smoke stage 3 lookup-absent");
  val List<Value> left_array = new List<Value>();
  left_array.add(value_int(7));
  left_array.add(value_int(8));
  val List<Value> right_array = new List<Value>();
  right_array.add(value_int(7));
  right_array.add(value_int(8));
  val Value left = value_array(left_array);
  val Value right = value_array(right_array);
  require_true(value_deep_equal_borrow(rt borrow left, rt borrow right),
    "borrowed deep array equality must match");
  require_true(value_deep_equal_borrow(rt borrow left, rt borrow right),
    "borrowed deep array equality must be repeatable");

  stdio.stdout.println("zorde borrow smoke stage 4 arrays-compared");
  val List<WireMember> lhs = new List<WireMember>();
  lhs.add(new WireMember(single_byte_key(97), value_int(1)));
  lhs.add(new WireMember(single_byte_key(98), value_int(2)));
  val List<WireMember> rhs = new List<WireMember>();
  rhs.add(new WireMember(single_byte_key(98), value_int(2)));
  rhs.add(new WireMember(single_byte_key(97), value_int(1)));
  val Value left_object = value_object(lhs);
  val Value right_object = value_object(rhs);
  require_true(value_deep_equal_borrow(
    rt borrow left_object, rt borrow right_object
  ), "borrowed object equality ignores member ordering");

  stdio.stdout.println("zorde borrow smoke stage 5 objects-compared");
  stdio.stdout.println("native Zorde borrowed equality smoke passed");
  return;
}
