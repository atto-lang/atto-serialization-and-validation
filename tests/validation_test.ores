import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember, MapEntry from '../src/core/value';
import fnc value_int, value_number_lexeme, value_string, value_array, value_object, value_map, value_deep_equal, int_to_decimal_bytes from '../src/core/value';
import class ValidationOptions, ValidationReport, ValueRule, FieldRule, ObjectSchema from '../src/validation/validation';
import class DecodeOptions from '../src/core/options';
import fnc default_decode_options from '../src/core/options';
import class JsonPayloadError, ValidatedDecodedValue from '../src/json/validated';
import fnc decode_and_validate_object from '../src/json/validated';
import fnc default_validation_options, any_rule, string_rule, number_rule, array_rule, field_rule, object_schema, max_schema_fields, max_schema_key_bytes from '../src/validation/validation';
import fnc validate_value, validate_object, validate_value_checked, validate_object_checked, report_is_valid, is_uuid, is_email, is_url from '../src/validation/validation';

pub fnc run_validation_tests(): void {
  val Utf8Text username_key = new Utf8Text(new List<int>(117, 115, 101, 114, 110, 97, 109, 101));
  val Utf8Text age_key = new Utf8Text(new List<int>(97, 103, 101));

  let List<WireMember> members = new List<WireMember>();
  members.push(new WireMember(rt borrow username_key, value_string(new Utf8Text(new List<int>(97, 98)))));
  members.push(new WireMember(rt borrow age_key, value_int(151)));

  let List<FieldRule> fields = new List<FieldRule>();
  fields.push(field_rule(rt borrow username_key, true, false, string_rule(3, 64, false, false, false, false)));
  fields.push(field_rule(rt borrow age_key, true, false, number_rule(true, 0.0, false, true, 150.0, false)));
  val ObjectSchema schema = object_schema(fields, true);

  val List<int> valid_json = new List<int>(
    123,
    34, 117, 115, 101, 114, 110, 97, 109, 101, 34, 58, 34, 97, 98, 99, 100, 34,
    44, 34, 97, 103, 101, 34, 58, 51, 48, 125
  );

  val Result<ValidatedDecodedValue, JsonPayloadError> checked_json = decode_and_validate_object(
    valid_json,
    default_decode_options(),
    rt borrow schema,
    default_validation_options()
  );
  require_true(checked_json.is_err() == false, "valid JSON payload must cross decode+validation boundary");

  // Schema-bound entry points cannot silently normalize duplicate wire keys.
  // Ordinary JSON decode may offer these policies for non-security callers.
  val DecodeOptions first_wins_options = new DecodeOptions(
    1, false, 128, 64, 64, 64, 64, 16, 16);
  val DecodeOptions last_wins_options = new DecodeOptions(
    2, false, 128, 64, 64, 64, 64, 16, 16);
  val DecodeOptions trailing_options = new DecodeOptions(
    0, true, 128, 64, 64, 64, 64, 16, 16);
  require_true(decode_and_validate_object(
    rt borrow valid_json, rt borrow first_wins_options,
    rt borrow schema, default_validation_options()
  ).is_err(), "schema-bound JSON must refuse first-wins admission");
  require_true(decode_and_validate_object(
    rt borrow valid_json, rt borrow last_wins_options,
    rt borrow schema, default_validation_options()
  ).is_err(), "schema-bound JSON must refuse last-wins admission");
  require_true(decode_and_validate_object(
    rt borrow valid_json, rt borrow trailing_options,
    rt borrow schema, default_validation_options()
  ).is_err(), "schema-bound JSON must refuse trailing-data policy");

  val List<int> duplicate_wire = new List<int>(
    123, 34, 97, 34, 58, 49, 44, 34, 97, 34, 58, 50, 125
  );
  val ObjectSchema open_schema_for_wire = object_schema(new List<FieldRule>(), false);
  require_true(decode_and_validate_object(
    rt borrow duplicate_wire, default_decode_options(),
    rt borrow open_schema_for_wire, default_validation_options()
  ).is_err(), "strict schema-bound JSON must reject duplicate keys on the wire");

  val ValidationReport invalid = validate_object(
    value_object(members),
    rt borrow schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow invalid), "invalid object must fail validation");
  require_int(invalid.errors.length, 2, "validation must collect both field errors");

  require_true(
    is_uuid(new Utf8Text(new List<int>(
      53, 53, 48, 101, 56, 52, 48, 48, 45, 101, 50, 57, 98, 45, 52, 49, 100, 52,
      45, 97, 55, 49, 54, 45, 52, 52, 54, 54, 53, 53, 52, 52, 48, 48, 48, 48
    ))),
    "canonical UUID must validate"
  );

  let List<WireMember> object_a_members = new List<WireMember>();
  object_a_members.push(new WireMember(new Utf8Text(new List<int>(97)), value_int(1)));
  object_a_members.push(new WireMember(new Utf8Text(new List<int>(98)), value_int(2)));
  let List<WireMember> object_b_members = new List<WireMember>();
  object_b_members.push(new WireMember(new Utf8Text(new List<int>(98)), value_int(2)));
  object_b_members.push(new WireMember(new Utf8Text(new List<int>(97)), value_int(1)));
  val Value object_a = value_object(object_a_members);
  val Value object_b = value_object(object_b_members);
  require_true(
    value_deep_equal(rt borrow object_a, rt borrow object_b),
    "object equality must ignore member order"
  );

  val List<MapEntry> map_a_entries = new List<MapEntry>();
  map_a_entries.add(new MapEntry(value_int(1), value_int(10)));
  map_a_entries.add(new MapEntry(value_int(2), value_int(20)));
  val List<MapEntry> map_b_entries = new List<MapEntry>();
  map_b_entries.add(new MapEntry(value_int(2), value_int(20)));
  map_b_entries.add(new MapEntry(value_int(1), value_int(10)));
  require_true(
    value_deep_equal(value_map(map_a_entries), value_map(map_b_entries)),
    "general map equality must ignore entry order"
  );

  val List<Value> duplicate_objects = new List<Value>();
  duplicate_objects.add(object_a);
  duplicate_objects.add(object_b);
  val ValidationReport unique_report = validate_value(
    value_array(duplicate_objects),
    array_rule(-1, -1, true),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unique_report), "unique_items must reject reordered-equivalent objects");

  require_true(
    is_email(new Utf8Text(new List<int>(97, 64, 98, 46, 99, 111, 109))),
    "basic email must validate"
  );
  require_true(is_email(new Utf8Text(new List<int>(
    97,46,98,43,99,95,100,64,101,120,97,109,112,108,101,46,99,111,109))),
    "ASCII dot-atom plus and underscore are accepted");
  require_true(!is_email(new Utf8Text(new List<int>(97,40,41,64,98,46,99,111,109))),
    "unsupported parentheses in local part must be refused");
  require_true(!is_email(new Utf8Text(new List<int>(97,92,98,64,98,46,99,111,109))),
    "unsupported backslash in local part must be refused");
  require_true(!is_email(new Utf8Text(new List<int>(97,34,98,64,98,46,99,111,109))),
    "quoted-string local part is not supported");
  require_true(!is_email(new Utf8Text(new List<int>(97,46,46,98,64,98,46,99,111,109))),
    "consecutive local dots must be refused");
  val List<int> domain_label_63 = new List<int>(97,64);
  let int email_index = 0;
  loop do
    if email_index >= 63 then break; fi
    domain_label_63.add(97);
    email_index = email_index + 1;
  done
  for const byte of new List<int>(46,99,111,109) do
    domain_label_63.add(byte);
  done
  require_true(is_email(new Utf8Text(domain_label_63)),
    "63-byte DNS-like label is valid");
  val List<int> domain_label_64 = new List<int>(97,64);
  email_index = 0;
  loop do
    if email_index >= 64 then break; fi
    domain_label_64.add(97);
    email_index = email_index + 1;
  done
  for const byte of new List<int>(46,99,111,109) do
    domain_label_64.add(byte);
  done
  require_true(!is_email(new Utf8Text(domain_label_64)),
    "64-byte DNS-like label is rejected");

  // Direct API work budgets: reject oversized buffers before any ASCII scan.
  val List<int> over_email = new List<int>(97,64,98,46,99,111,109);
  email_index = 0;
  loop do
    if email_index >= 248 then break; fi
    over_email.add(97);
    email_index = email_index + 1;
  done
  require_true(!is_email(new Utf8Text(over_email)),
    "255-byte direct email input must fail the pre-scan byte gate");
  over_email.add(255);
  require_true(!is_email(new Utf8Text(over_email)),
    "oversized non-ASCII email input cannot bypass the byte gate");

  let List<WireMember> duplicate_members = new List<WireMember>();
  duplicate_members.push(new WireMember(rt borrow username_key, value_int(1)));
  duplicate_members.push(new WireMember(rt borrow username_key, value_int(2)));
  val ValidationReport duplicate_object = validate_object(
    value_object(duplicate_members),
    rt borrow schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow duplicate_object), "direct object validation must reject duplicate field names");

  let List<FieldRule> oversized_schema_fields = new List<FieldRule>();
  let int schema_index = 0;
  loop do
    if schema_index > max_schema_fields() then break; fi
    oversized_schema_fields.push(field_rule(rt borrow username_key, false, false, any_rule()));
    schema_index = schema_index + 1;
  done
  val ValidationReport oversized_schema = validate_object(
    value_object(new List<WireMember>()),
    object_schema(oversized_schema_fields, false),
    default_validation_options()
  );
  require_true(
    !report_is_valid(rt borrow oversized_schema),
    "object schema field ceiling must fail closed before expensive validation"
  );

  let List<int> huge_fraction = new List<int>(48, 46);
  let int fraction_digit = 0;
  loop do
    if fraction_digit >= 400 then break; fi
    huge_fraction.push(57);
    fraction_digit = fraction_digit + 1;
  done
  val ValidationReport non_finite_conversion = validate_value(
    value_number_lexeme(huge_fraction),
    number_rule(false, 0.0, false, true, 1.0, false),
    default_validation_options()
  );
  require_true(
    !report_is_valid(rt borrow non_finite_conversion),
    "numeric range validation must reject NaN-producing decimal conversion"
  );

  // Direct Value construction must not bypass JSON-number lexical rules.
  val ValidationReport leading_zero = validate_value(
    value_number_lexeme(new List<int>(48, 49)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow leading_zero), "01 must fail numeric range validation");

  val ValidationReport negative_leading_zero = validate_value(
    value_number_lexeme(new List<int>(45, 48, 49)),
    number_rule(false, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow negative_leading_zero), "-01 must fail numeric range validation");

  // 9e308 and -9e308 convert to infinities on IEEE double. Infinity must
  // not bypass a one-sided minimum or maximum numeric constraint.
  val ValidationReport positive_infinity = validate_value(
    value_number_lexeme(new List<int>(57, 101, 51, 48, 56)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow positive_infinity), "overflowed +Infinity must not pass a minimum-only bound");

  val ValidationReport negative_infinity = validate_value(
    value_number_lexeme(new List<int>(45, 57, 101, 51, 48, 56)),
    number_rule(false, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow negative_infinity), "overflowed -Infinity must not pass a maximum-only bound");

  // Nonzero decimal underflow to zero would otherwise satisfy an inclusive
  // minimum of zero. Preserve exact nonzero/zero distinction at admission.
  let List<int> underflow_lexeme = new List<int>(48, 46);
  let int tiny_index = 0;
  loop do
    if tiny_index >= 400 then break; fi
    underflow_lexeme.push(48);
    tiny_index = tiny_index + 1;
  done
  underflow_lexeme.push(49);
  val ValidationReport positive_underflow = validate_value(
    value_number_lexeme(underflow_lexeme),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow positive_underflow), "nonzero decimal rounded to zero must fail numeric range admission");

  // The validation boundary must bound work even when bypassing the decoder.
  let List<int> oversized_number = new List<int>();
  let int lexeme_index = 0;
  loop do
    if lexeme_index >= 1025 then break; fi
    oversized_number.push(49);
    lexeme_index = lexeme_index + 1;
  done
  val ValidationReport oversized_lexeme = validate_value(
    value_number_lexeme(oversized_number),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow oversized_lexeme), "number lexeme size ceiling must fail closed");

  // Valid canonical zeros and finite exponents must continue to work.
  val ValidationReport zero_lexeme = validate_value(
    value_number_lexeme(new List<int>(48, 46, 48)),
    number_rule(true, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow zero_lexeme), "canonical decimal zero must remain accepted");

  val ValidationReport finite_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 101, 51)),
    number_rule(true, 999.0, false, true, 1001.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow finite_exponent), "finite canonical exponent must remain accepted");


  // Direct lexeme constructors must obey the same strict JSON number grammar
  // even if only one numeric bound is configured.
  val ValidationReport no_integer_part = validate_value(
    value_number_lexeme(new List<int>(46, 49)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow no_integer_part), ".1 must fail closed");

  val ValidationReport missing_fraction = validate_value(
    value_number_lexeme(new List<int>(49, 46)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow missing_fraction), "1. must fail closed");

  val ValidationReport missing_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 101, 43)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow missing_exponent), "1e+ must fail closed");

  val ValidationReport leading_plus = validate_value(
    value_number_lexeme(new List<int>(43, 49)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow leading_plus), "+1 must fail closed");

  val ValidationReport non_ascii_lexeme = validate_value(
    value_number_lexeme(new List<int>(49, 194, 160)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow non_ascii_lexeme), "numeric lexemes are ASCII-only");

  val ValidationReport signed_zero = validate_value(
    value_number_lexeme(new List<int>(45, 48)),
    number_rule(true, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow signed_zero), "canonical negative zero remains valid");

  val ValidationReport finite_exponent_with_plus = validate_value(
    value_number_lexeme(new List<int>(49, 101, 43, 51)),
    number_rule(true, 999.0, false, true, 1001.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow finite_exponent_with_plus), "1e+3 remains valid");


  // An unconstrained numeric type must still enforce JSON lexeme grammar.
  // Previously these invalid Value objects passed without range bounds.
  val ValidationReport unbounded_leading_zero = validate_value(
    value_number_lexeme(new List<int>(48, 49)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unbounded_leading_zero),
    "unbounded number must reject leading zero");

  val ValidationReport unbounded_fraction = validate_value(
    value_number_lexeme(new List<int>(49, 46)),
    any_rule(),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unbounded_fraction),
    "any_rule cannot admit malformed direct numeric Value");

  val ValidationReport unbounded_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 101, 43)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unbounded_exponent),
    "unbounded numeric rule must reject missing exponent digits");

  // Correct JSON numbers need not fit a float when there is NO float range.
  val ValidationReport unbounded_large = validate_value(
    value_number_lexeme(new List<int>(57, 101, 51, 48, 56)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow unbounded_large),
    "valid large JSON number accepted by type-only validator");

  val ValidationReport unbounded_negative_zero = validate_value(
    value_number_lexeme(new List<int>(45, 48)),
    any_rule(),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow unbounded_negative_zero),
    "negative zero remains canonical for unconstrained numbers");

  val ValidationReport unbounded_full_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 69, 45, 48, 48, 51)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow unbounded_full_exponent),
    "exponent leading zeroes and E-003 remain lexical JSON numbers");

  // Direct Value construction bypasses the JSON decoder. Object admission
  // must reject malformed keys even if unknown field names are allowed.
  val ObjectSchema open_schema = object_schema(new List<FieldRule>(), false);
  val List<WireMember> bad_utf8_members = new List<WireMember>();
  bad_utf8_members.add(new WireMember(
    new Utf8Text(new List<int>(255)), value_int(1)
  ));
  val ValidationReport bad_key_report = validate_object(
    value_object(bad_utf8_members), rt borrow open_schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow bad_key_report),
    "direct object rejects invalid UTF-8 keys");

  val List<int> oversized_key_bytes = new List<int>();
  let int key_index = 0;
  loop do
    if key_index > max_schema_key_bytes() then break; fi
    oversized_key_bytes.add(97);
    key_index = key_index + 1;
  done
  val List<WireMember> oversized_key_members = new List<WireMember>();
  oversized_key_members.add(new WireMember(
    new Utf8Text(oversized_key_bytes), value_int(1)
  ));
  val ValidationReport too_long_key_report = validate_object(
    value_object(oversized_key_members), rt borrow open_schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow too_long_key_report),
    "direct object rejects oversized key before UTF-8 scan");

  val List<WireMember> oversized_value_members = new List<WireMember>();
  let int member_index = 0;
  loop do
    if member_index > max_schema_fields() then break; fi
    oversized_value_members.add(new WireMember(
      new Utf8Text(int_to_decimal_bytes(member_index)), value_int(member_index)
    ));
    member_index = member_index + 1;
  done
  val ValidationReport too_many_members_report = validate_object(
    value_object(oversized_value_members), rt borrow open_schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow too_many_members_report),
    "direct object rejects excessive distinct member count");
  // Object schemas must detach caller-owned field lists AND UTF-8 key
  // buffers. Mutating the builder after object_schema() must not rewrite
  // which field the schema requires, nor add a new required field.
  val List<int> caller_key_bytes = new List<int>(97);
  val List<FieldRule> caller_fields = new List<FieldRule>();
  caller_fields.add(field_rule(
    new Utf8Text(caller_key_bytes), true, false,
    number_rule(false, 0.0, false, false, 0.0, false)
  ));
  val ObjectSchema detached_schema = object_schema(caller_fields, true);
  caller_key_bytes[0] = 98;
  caller_fields.add(field_rule(
    new Utf8Text(new List<int>(121)), true, false,
    number_rule(false, 0.0, false, false, 0.0, false)
  ));
  require_int(detached_schema.fields.length, 1,
    "object schema must snapshot field count");
  require_int(detached_schema.fields[0].key.bytes[0], 97,
    "object schema must snapshot nested field-key bytes");
  val List<WireMember> detached_members = new List<WireMember>();
  detached_members.add(new WireMember(
    new Utf8Text(new List<int>(97)), value_int(1)
  ));
  val ValidationReport detached_report = validate_object(
    value_object(detached_members), rt borrow detached_schema,
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow detached_report),
    "original required key must still validate after builder mutation");

  // A refused oversized builder must not return a usable empty/partial
  // schema. A deliberately malformed sentinel remains invalid at parse.
  val List<FieldRule> oversized_key_schema_fields = new List<FieldRule>();
  oversized_key_schema_fields.add(field_rule(
    new Utf8Text(oversized_key_bytes), false, false, any_rule()
  ));
  val ObjectSchema refused_snapshot = object_schema(oversized_key_schema_fields, false);
  val ValidationReport refused_snapshot_report = validate_object(
    value_object(new List<WireMember>()), rt borrow refused_snapshot,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow refused_snapshot_report),
    "oversized key must not be converted into a permissive empty schema");

  // Checked dynamic APIs return plain Value, never authoritative proof.
  val Result<Value, ValidationReport> accepted_dynamic = validate_value_checked(
    value_string(new Utf8Text(new List<int>(111, 107))),
    string_rule(2, 2, false, false, false, false),
    default_validation_options()
  );
  require_true(!accepted_dynamic.is_err(), "dynamic checked string accepts valid input");
  val Result<Value, ValidationReport> denied_dynamic = validate_value_checked(
    value_string(new Utf8Text(new List<int>(111, 107))),
    string_rule(3, 3, false, false, false, false),
    default_validation_options()
  );
  require_true(denied_dynamic.is_err(), "dynamic checked string rejects invalid input");
  val Result<Value, ValidationReport> denied_duplicate = validate_object_checked(
    value_object(duplicate_members), rt borrow schema, default_validation_options()
  );
  require_true(denied_duplicate.is_err(), "dynamic checked object rejects duplicate keys");
  // Contradictory schema bounds must fail closed before validating values.
  val ValidationReport impossible_length = validate_value(
    value_string(new Utf8Text(new List<int>(97, 98, 99, 100, 101))),
    string_rule(4, 3, false, false, false, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow impossible_length),
    "min_length > max_length must reject even a valid-looking string");

  // This basic validator deliberately disallows userinfo and ambiguous hosts.
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 56, 48, 56, 48, 47, 97, 63, 113, 61, 49))), "valid URL authority: http://example.com:8080/a?q=1");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 115, 58, 47, 47, 91, 58, 58, 49, 93, 47, 120))), "valid URL authority: https://[::1]/x");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 58, 56, 48))), "ambiguous URL authority: http://:80");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 115, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58))), "ambiguous URL authority: https://example.com:");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 117, 115, 101, 114, 64, 104, 111, 115, 116))), "ambiguous URL authority: http://user@host");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 104, 111, 115, 116, 92, 64, 111, 116, 104, 101, 114))), "ambiguous URL authority: http://host\\@other");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47))), "ambiguous URL authority: http://");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 63, 113, 117, 101, 114, 121))), "ambiguous URL authority: http://?query");

  // Restricted authority parser: numeric port bounds and explicit IPv6
  // brackets; intentionally no DNS lookup or SSRF authorization.
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 108, 111, 99, 97, 108, 104, 111, 115, 116))), "URL accept http://localhost");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 115, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 54, 53, 53, 51, 53, 47, 112, 97, 116, 104))), "URL accept https://example.com:65535/path");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 49, 93, 58, 56, 48, 56, 48, 47, 120))), "URL accept http://[::1]:8080/x");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 115, 58, 47, 47, 97, 112, 105, 45, 50, 46, 101, 120, 97, 109, 112, 108, 101, 46, 111, 114, 103, 63, 97, 61, 49))), "URL accept https://api-2.example.org?a=1");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 54, 53, 53, 51, 54))), "URL reject http://example.com:65536");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 48))), "URL reject http://example.com:0");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 97, 98, 99))), "URL reject http://example.com:abc");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 49, 50, 120))), "URL reject http://example.com:12x");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 49, 58, 50))), "URL reject http://example.com:1:2");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 46, 46, 111, 114, 103))), "URL reject http://example.com..org");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109))), "URL reject http://.example.com");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 46))), "URL reject http://example.com.");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 45, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109))), "URL reject http://-example.com");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 45, 46, 99, 111, 109))), "URL reject http://example-.com");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 102, 111, 111, 95, 98, 97, 114, 46, 99, 111, 109))), "URL reject http://foo_bar.com");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 110, 111, 116, 105, 112, 118, 54, 93))), "URL reject http://[notipv6]");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 49))), "URL reject http://[::1");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 49, 93, 111, 111, 112, 115))), "URL reject http://[::1]oops");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 58, 58, 49))), "URL reject http://::1");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 104, 111, 115, 116, 37, 52, 48, 101, 118, 105, 108, 46, 99, 111, 109))), "URL reject http://host%40evil.com");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 97, 46, 99, 111, 109, 47, 92, 101, 118, 105, 108))), "URL reject http://a.com/\\evil");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 100, 111, 109, 97, 105, 110, 46, 99, 111, 109, 58, 57, 57, 57, 57, 57, 57))), "URL reject http://domain.com:999999");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 97, 46, 46, 98))), "URL reject http://a..b");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 49, 93, 58))), "URL reject http://[::1]:");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 97, 46, 99, 111, 109, 58, 52, 52, 51, 58, 56, 48))), "URL reject http://a.com:443:80");
  require_true(!is_url(new Utf8Text(new List<int>(72, 84, 84, 80, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109))), "URL reject HTTP://example.com");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 115, 58, 47, 47, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 58, 48, 48, 48, 56, 48))), "URL accept https://example.com:00080");
  let List<int> oversized_url = new List<int>(104, 116, 116, 112, 58, 47, 47);
  let int url_bytes = 0;
  loop do
    if url_bytes >= 8192 then break; fi
    oversized_url.push(97);
    url_bytes = url_bytes + 1;
  done
  require_true(!is_url(new Utf8Text(oversized_url)), "URL above 8192-byte bound must reject");

  // A 8192-byte ASCII HTTP URL is accepted; 8193 is refused before
  // any O(n) ASCII validation, irrespective of boolean evaluation semantics.
  val List<int> boundary_url = new List<int>(104,116,116,112,58,47,47,97,47);
  url_bytes = 0;
  loop do
    if url_bytes >= 8183 then break; fi
    boundary_url.add(120);
    url_bytes = url_bytes + 1;
  done
  require_true(is_url(new Utf8Text(boundary_url)),
    "exactly 8192-byte valid URL shape remains accepted");
  boundary_url.add(120);
  require_true(!is_url(new Utf8Text(boundary_url)),
    "8193-byte URL input must fail before its ASCII scan");
  boundary_url.add(255);
  require_true(!is_url(new Utf8Text(boundary_url)),
    "oversized non-ASCII URL input fails the same byte gate");

  // IPv6 literal group validation and total DNS authority bounds.
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 93))), "URL IPv6/host case 1");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 115, 58, 47, 47, 91, 50, 48, 48, 49, 58, 100, 98, 56, 58, 58, 49, 93, 58, 52, 52, 51, 47))), "URL IPv6/host case 2");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 50, 58, 51, 58, 52, 58, 53, 58, 54, 58, 55, 58, 56, 93))), "URL IPv6/host case 3");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 50, 58, 51, 58, 52, 58, 53, 58, 54, 58, 55, 58, 58, 93))), "URL IPv6/host case 4");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 102, 102, 102, 102, 93))), "URL IPv6/host case 5");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 115, 58, 47, 47, 91, 97, 98, 99, 100, 58, 48, 58, 49, 50, 51, 52, 58, 102, 102, 102, 102, 58, 58, 49, 93))), "URL IPv6/host case 6");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 50, 58, 51, 58, 52, 58, 53, 58, 54, 58, 55, 93))), "URL IPv6/host case 7");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 50, 58, 51, 58, 52, 58, 53, 58, 54, 58, 55, 58, 56, 58, 57, 93))), "URL IPv6/host case 8");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 50, 58, 51, 58, 52, 58, 53, 58, 54, 58, 55, 58, 58, 56, 93))), "URL IPv6/host case 9");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 58, 93))), "URL IPv6/host case 10");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 58, 50, 58, 58, 51, 93))), "URL IPv6/host case 11");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 50, 51, 52, 53, 58, 58, 49, 93))), "URL IPv6/host case 12");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 93))), "URL IPv6/host case 13");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 49, 93))), "URL IPv6/host case 14");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 93))), "URL IPv6/host case 15");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 102, 102, 102, 102, 58, 49, 50, 55, 46, 48, 46, 48, 46, 49, 93))), "URL IPv6/host case 16");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 102, 101, 56, 48, 58, 58, 49, 37, 101, 116, 104, 48, 93))), "URL IPv6/host case 17");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 103, 103, 103, 103, 58, 58, 49, 93))), "URL IPv6/host case 18");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 49, 58, 50, 58, 51, 58, 52, 58, 53, 58, 54, 58, 55, 58, 56, 58, 93))), "URL IPv6/host case 19");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 91, 58, 58, 49, 93, 93))), "URL IPv6/host case 20");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 108, 111, 99, 97, 108, 104, 111, 115, 116, 58, 54, 53, 53, 51, 53))), "URL IPv6/host case 21");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 102, 111, 111, 46, 97))), "URL IPv6/host case 22");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 46, 99, 111, 109))), "URL IPv6/host case 23");
  require_true(is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 46, 99, 111, 109))), "URL IPv6/host case 24");
  require_true(!is_url(new Utf8Text(new List<int>(104, 116, 116, 112, 58, 47, 47, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97, 46, 97))), "URL IPv6/host case 25");

  return;
}
