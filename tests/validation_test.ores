import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember, MapEntry from '../src/core/value';
import fnc value_int, value_number_lexeme, value_string, value_bytes, value_extension, value_array, value_object, value_map, value_deep_equal, int_to_decimal_bytes from '../src/core/value';
import class ValidationOptions, ValidationReport, ValidationError, ValueRule, FieldRule, ObjectSchema from '../src/validation/validation';
import class DecodeOptions from '../src/core/options';
import fnc default_decode_options from '../src/core/options';
import class JsonPayloadError, ValidatedDecodedValue from '../src/json/validated';
import fnc decode_and_validate_object from '../src/json/validated';
import fnc default_validation_options, any_rule, string_rule, number_rule, array_rule, field_rule, object_schema, max_schema_fields, max_schema_key_bytes, max_unique_validation_items, max_unique_candidate_checks, max_unique_validation_work, max_checked_value_nodes, max_checked_value_depth, max_checked_value_bytes from '../src/validation/validation';
import fnc validate_value, validate_object, validate_value_checked, validate_object_checked, report_is_valid, is_uuid, is_email from '../src/validation/validation';

pub fnc run_validation_tests(): void {
  val Utf8Text username_key = new Utf8Text(new List<int>(117, 115, 101, 114, 110, 97, 109, 101));
  val Utf8Text age_key = new Utf8Text(new List<int>(97, 103, 101));

  let List<WireMember> members = new List<WireMember>();
  members.push(new WireMember(rt borrow username_key, value_string(new Utf8Text(new List<int>(97, 98)))));
  members.push(new WireMember(rt borrow age_key, value_int(151)));

  let List<FieldRule> fields = new List<FieldRule>();
  fields.push(field_rule(rt borrow username_key, true, false, string_rule(3, 64, false, false, false, false)));
  fields.push(field_rule(rt borrow age_key, true, false, number_rule(true, 0.0, false, true, 150.0, false)));
  val ObjectSchema schema = object_schema(fields, true);

  val List<int> valid_json = new List<int>(
    123,
    34, 117, 115, 101, 114, 110, 97, 109, 101, 34, 58, 34, 97, 98, 99, 100, 34,
    44, 34, 97, 103, 101, 34, 58, 51, 48, 125
  );

  val Result<ValidatedDecodedValue, JsonPayloadError> checked_json = decode_and_validate_object(
    valid_json,
    default_decode_options(),
    rt borrow schema,
    default_validation_options()
  );
  require_true(checked_json.is_err() == false, "valid JSON payload must cross decode+validation boundary");

  // Schema-bound entry points cannot silently normalize duplicate wire keys.
  // Ordinary JSON decode may offer these policies for non-security callers.
  val DecodeOptions first_wins_options = new DecodeOptions(
    1, false, 128, 64, 64, 64, 64, 16, 16);
  val DecodeOptions last_wins_options = new DecodeOptions(
    2, false, 128, 64, 64, 64, 64, 16, 16);
  val DecodeOptions trailing_options = new DecodeOptions(
    0, true, 128, 64, 64, 64, 64, 16, 16);
  require_true(decode_and_validate_object(
    rt borrow valid_json, rt borrow first_wins_options,
    rt borrow schema, default_validation_options()
  ).is_err(), "schema-bound JSON must refuse first-wins admission");
  require_true(decode_and_validate_object(
    rt borrow valid_json, rt borrow last_wins_options,
    rt borrow schema, default_validation_options()
  ).is_err(), "schema-bound JSON must refuse last-wins admission");
  require_true(decode_and_validate_object(
    rt borrow valid_json, rt borrow trailing_options,
    rt borrow schema, default_validation_options()
  ).is_err(), "schema-bound JSON must refuse trailing-data policy");

  val List<int> duplicate_wire = new List<int>(
    123, 34, 97, 34, 58, 49, 44, 34, 97, 34, 58, 50, 125
  );
  val ObjectSchema open_schema_for_wire = object_schema(new List<FieldRule>(), false);
  require_true(decode_and_validate_object(
    rt borrow duplicate_wire, default_decode_options(),
    rt borrow open_schema_for_wire, default_validation_options()
  ).is_err(), "strict schema-bound JSON must reject duplicate keys on the wire");

  val ValidationReport invalid = validate_object(
    value_object(members),
    rt borrow schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow invalid), "invalid object must fail validation");
  require_int(invalid.errors.length, 2, "validation must collect both field errors");

  require_true(
    is_uuid(new Utf8Text(new List<int>(
      53, 53, 48, 101, 56, 52, 48, 48, 45, 101, 50, 57, 98, 45, 52, 49, 100, 52,
      45, 97, 55, 49, 54, 45, 52, 52, 54, 54, 53, 53, 52, 52, 48, 48, 48, 48
    ))),
    "canonical UUID must validate"
  );

  let List<WireMember> object_a_members = new List<WireMember>();
  object_a_members.push(new WireMember(new Utf8Text(new List<int>(97)), value_int(1)));
  object_a_members.push(new WireMember(new Utf8Text(new List<int>(98)), value_int(2)));
  let List<WireMember> object_b_members = new List<WireMember>();
  object_b_members.push(new WireMember(new Utf8Text(new List<int>(98)), value_int(2)));
  object_b_members.push(new WireMember(new Utf8Text(new List<int>(97)), value_int(1)));
  val Value object_a = value_object(object_a_members);
  val Value object_b = value_object(object_b_members);
  require_true(
    value_deep_equal(rt borrow object_a, rt borrow object_b),
    "object equality must ignore member order"
  );

  val List<MapEntry> map_a_entries = new List<MapEntry>();
  map_a_entries.add(new MapEntry(value_int(1), value_int(10)));
  map_a_entries.add(new MapEntry(value_int(2), value_int(20)));
  val List<MapEntry> map_b_entries = new List<MapEntry>();
  map_b_entries.add(new MapEntry(value_int(2), value_int(20)));
  map_b_entries.add(new MapEntry(value_int(1), value_int(10)));
  require_true(
    value_deep_equal(value_map(map_a_entries), value_map(map_b_entries)),
    "general map equality must ignore entry order"
  );

  val List<Value> duplicate_objects = new List<Value>();
  duplicate_objects.add(object_a);
  duplicate_objects.add(object_b);
  val ValidationReport unique_report = validate_value(
    value_array(duplicate_objects),
    array_rule(-1, -1, true),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unique_report), "unique_items must reject reordered-equivalent objects");

  // A direct Value caller may omit max_items. Uniqueness still needs its own
  // fail-closed admission budget before any value hashing/deep comparison.
  require_true(max_unique_validation_items() == 4096,
    "unique-items budget is a deterministic cross-backend contract");
  require_true(max_unique_candidate_checks() == 16384,
    "unique-items collision comparison budget is deterministic");
  val List<Value> small_unique_items = new List<Value>();
  let int unique_index = 0;
  loop do
    if unique_index >= 32 then break; fi
    small_unique_items.add(value_int(unique_index));
    unique_index = unique_index + 1;
  done
  val ValidationReport small_unique_report = validate_value(
    value_array(small_unique_items),
    array_rule(-1, -1, true),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow small_unique_report),
    "small valid unique arrays remain accepted");

  val List<Value> over_unique_budget = new List<Value>();
  let int over_index = 0;
  loop do
    if over_index > max_unique_validation_items() then break; fi
    over_unique_budget.add(value_int(over_index));
    over_index = over_index + 1;
  done
  val ValidationReport unique_limit_report = validate_value(
    value_array(over_unique_budget),
    array_rule(-1, -1, true),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unique_limit_report),
    "unbounded unique-items rule refuses 4097 items before hashing");
  val ValidationReport zero_error_budget_report = validate_value(
    value_array(over_unique_budget),
    array_rule(-1, -1, true),
    new ValidationOptions(false, 0)
  );
  require_true(zero_error_budget_report.truncated &&
    !report_is_valid(rt borrow zero_error_budget_report),
    "zero diagnostic capacity must not turn uniqueness budget denial into success");

  // Deliberately invalid public Value discriminants used to share the
  // fallback hash. The unified graph preflight must now deny them *before*
  // uniqueness hashing. Actual valid-key hash collision behavior is covered
  // by separate source-free reference-model tests pending native execution.
  val List<Value> collision_values = new List<Value>();
  let int collision_index = 0;
  loop do
    if collision_index >= 200 then break; fi
    collision_values.add(new Value(
      9, false, new List<int>(), new Utf8Text(new List<int>()),
      new List<int>(), new List<Value>(), new List<WireMember>(),
      new List<MapEntry>(), collision_index
    ));
    collision_index = collision_index + 1;
  done
  val ValidationReport collision_report = validate_value(
    value_array(collision_values),
    array_rule(-1, -1, true),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow collision_report),
    "collision-heavy or malformed unique-items input must fail closed");


  require_true(
    is_email(new Utf8Text(new List<int>(97, 64, 98, 46, 99, 111, 109))),
    "basic email must validate"
  );

  let List<WireMember> duplicate_members = new List<WireMember>();
  duplicate_members.push(new WireMember(rt borrow username_key, value_int(1)));
  duplicate_members.push(new WireMember(rt borrow username_key, value_int(2)));
  val ValidationReport duplicate_object = validate_object(
    value_object(duplicate_members),
    rt borrow schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow duplicate_object), "direct object validation must reject duplicate field names");

  let List<FieldRule> oversized_schema_fields = new List<FieldRule>();
  let int schema_index = 0;
  loop do
    if schema_index > max_schema_fields() then break; fi
    oversized_schema_fields.push(field_rule(rt borrow username_key, false, false, any_rule()));
    schema_index = schema_index + 1;
  done
  val ValidationReport oversized_schema = validate_object(
    value_object(new List<WireMember>()),
    object_schema(oversized_schema_fields, false),
    default_validation_options()
  );
  require_true(
    !report_is_valid(rt borrow oversized_schema),
    "object schema field ceiling must fail closed before expensive validation"
  );

  let List<int> huge_fraction = new List<int>(48, 46);
  let int fraction_digit = 0;
  loop do
    if fraction_digit >= 400 then break; fi
    huge_fraction.push(57);
    fraction_digit = fraction_digit + 1;
  done
  val ValidationReport non_finite_conversion = validate_value(
    value_number_lexeme(huge_fraction),
    number_rule(false, 0.0, false, true, 1.0, false),
    default_validation_options()
  );
  require_true(
    !report_is_valid(rt borrow non_finite_conversion),
    "numeric range validation must reject NaN-producing decimal conversion"
  );

  // Direct Value construction must not bypass JSON-number lexical rules.
  val ValidationReport leading_zero = validate_value(
    value_number_lexeme(new List<int>(48, 49)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow leading_zero), "01 must fail numeric range validation");

  val ValidationReport negative_leading_zero = validate_value(
    value_number_lexeme(new List<int>(45, 48, 49)),
    number_rule(false, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow negative_leading_zero), "-01 must fail numeric range validation");

  // 9e308 and -9e308 convert to infinities on IEEE double. Infinity must
  // not bypass a one-sided minimum or maximum numeric constraint.
  val ValidationReport positive_infinity = validate_value(
    value_number_lexeme(new List<int>(57, 101, 51, 48, 56)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow positive_infinity), "overflowed +Infinity must not pass a minimum-only bound");

  val ValidationReport negative_infinity = validate_value(
    value_number_lexeme(new List<int>(45, 57, 101, 51, 48, 56)),
    number_rule(false, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow negative_infinity), "overflowed -Infinity must not pass a maximum-only bound");

  // Nonzero decimal underflow to zero would otherwise satisfy an inclusive
  // minimum of zero. Preserve exact nonzero/zero distinction at admission.
  let List<int> underflow_lexeme = new List<int>(48, 46);
  let int tiny_index = 0;
  loop do
    if tiny_index >= 400 then break; fi
    underflow_lexeme.push(48);
    tiny_index = tiny_index + 1;
  done
  underflow_lexeme.push(49);
  val ValidationReport positive_underflow = validate_value(
    value_number_lexeme(underflow_lexeme),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow positive_underflow), "nonzero decimal rounded to zero must fail numeric range admission");

  // The validation boundary must bound work even when bypassing the decoder.
  let List<int> oversized_number = new List<int>();
  let int lexeme_index = 0;
  loop do
    if lexeme_index >= 1025 then break; fi
    oversized_number.push(49);
    lexeme_index = lexeme_index + 1;
  done
  val ValidationReport oversized_lexeme = validate_value(
    value_number_lexeme(oversized_number),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow oversized_lexeme), "number lexeme size ceiling must fail closed");

  // Valid canonical zeros and finite exponents must continue to work.
  val ValidationReport zero_lexeme = validate_value(
    value_number_lexeme(new List<int>(48, 46, 48)),
    number_rule(true, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow zero_lexeme), "canonical decimal zero must remain accepted");

  val ValidationReport finite_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 101, 51)),
    number_rule(true, 999.0, false, true, 1001.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow finite_exponent), "finite canonical exponent must remain accepted");


  // Direct lexeme constructors must obey the same strict JSON number grammar
  // even if only one numeric bound is configured.
  val ValidationReport no_integer_part = validate_value(
    value_number_lexeme(new List<int>(46, 49)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow no_integer_part), ".1 must fail closed");

  val ValidationReport missing_fraction = validate_value(
    value_number_lexeme(new List<int>(49, 46)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow missing_fraction), "1. must fail closed");

  val ValidationReport missing_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 101, 43)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow missing_exponent), "1e+ must fail closed");

  val ValidationReport leading_plus = validate_value(
    value_number_lexeme(new List<int>(43, 49)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow leading_plus), "+1 must fail closed");

  val ValidationReport non_ascii_lexeme = validate_value(
    value_number_lexeme(new List<int>(49, 194, 160)),
    number_rule(true, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow non_ascii_lexeme), "numeric lexemes are ASCII-only");

  val ValidationReport signed_zero = validate_value(
    value_number_lexeme(new List<int>(45, 48)),
    number_rule(true, 0.0, false, true, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow signed_zero), "canonical negative zero remains valid");

  val ValidationReport finite_exponent_with_plus = validate_value(
    value_number_lexeme(new List<int>(49, 101, 43, 51)),
    number_rule(true, 999.0, false, true, 1001.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow finite_exponent_with_plus), "1e+3 remains valid");


  // An unconstrained numeric type must still enforce JSON lexeme grammar.
  // Previously these invalid Value objects passed without range bounds.
  val ValidationReport unbounded_leading_zero = validate_value(
    value_number_lexeme(new List<int>(48, 49)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unbounded_leading_zero),
    "unbounded number must reject leading zero");

  val ValidationReport unbounded_fraction = validate_value(
    value_number_lexeme(new List<int>(49, 46)),
    any_rule(),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unbounded_fraction),
    "any_rule cannot admit malformed direct numeric Value");

  val ValidationReport unbounded_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 101, 43)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow unbounded_exponent),
    "unbounded numeric rule must reject missing exponent digits");

  // Correct JSON numbers need not fit a float when there is NO float range.
  val ValidationReport unbounded_large = validate_value(
    value_number_lexeme(new List<int>(57, 101, 51, 48, 56)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow unbounded_large),
    "valid large JSON number accepted by type-only validator");

  val ValidationReport unbounded_negative_zero = validate_value(
    value_number_lexeme(new List<int>(45, 48)),
    any_rule(),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow unbounded_negative_zero),
    "negative zero remains canonical for unconstrained numbers");

  val ValidationReport unbounded_full_exponent = validate_value(
    value_number_lexeme(new List<int>(49, 69, 45, 48, 48, 51)),
    number_rule(false, 0.0, false, false, 0.0, false),
    default_validation_options()
  );
  require_true(report_is_valid(rt borrow unbounded_full_exponent),
    "exponent leading zeroes and E-003 remain lexical JSON numbers");

  // Direct Value construction bypasses the JSON decoder. Object admission
  // must reject malformed keys even if unknown field names are allowed.
  val ObjectSchema open_schema = object_schema(new List<FieldRule>(), false);
  val List<WireMember> bad_utf8_members = new List<WireMember>();
  bad_utf8_members.add(new WireMember(
    new Utf8Text(new List<int>(255)), value_int(1)
  ));
  val ValidationReport bad_key_report = validate_object(
    value_object(bad_utf8_members), rt borrow open_schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow bad_key_report),
    "direct object rejects invalid UTF-8 keys");

  val List<int> oversized_key_bytes = new List<int>();
  let int key_index = 0;
  loop do
    if key_index > max_schema_key_bytes() then break; fi
    oversized_key_bytes.add(97);
    key_index = key_index + 1;
  done
  val List<WireMember> oversized_key_members = new List<WireMember>();
  oversized_key_members.add(new WireMember(
    new Utf8Text(oversized_key_bytes), value_int(1)
  ));
  val ValidationReport too_long_key_report = validate_object(
    value_object(oversized_key_members), rt borrow open_schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow too_long_key_report),
    "direct object rejects oversized key before UTF-8 scan");

  val List<WireMember> oversized_value_members = new List<WireMember>();
  let int member_index = 0;
  loop do
    if member_index > max_schema_fields() then break; fi
    oversized_value_members.add(new WireMember(
      new Utf8Text(int_to_decimal_bytes(member_index)), value_int(member_index)
    ));
    member_index = member_index + 1;
  done
  val ValidationReport too_many_members_report = validate_object(
    value_object(oversized_value_members), rt borrow open_schema,
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow too_many_members_report),
    "direct object rejects excessive distinct member count");
  // Checked dynamic APIs return plain Value, never authoritative proof.
  val Result<Value, ValidationReport> accepted_dynamic = validate_value_checked(
    value_string(new Utf8Text(new List<int>(111, 107))),
    string_rule(2, 2, false, false, false, false),
    default_validation_options()
  );
  require_true(!accepted_dynamic.is_err(), "dynamic checked string accepts valid input");
  val Result<Value, ValidationReport> denied_dynamic = validate_value_checked(
    value_string(new Utf8Text(new List<int>(111, 107))),
    string_rule(3, 3, false, false, false, false),
    default_validation_options()
  );
  require_true(denied_dynamic.is_err(), "dynamic checked string rejects invalid input");
  val Result<Value, ValidationReport> denied_duplicate = validate_object_checked(
    value_object(duplicate_members), rt borrow schema, default_validation_options()
  );
  require_true(denied_duplicate.is_err(), "dynamic checked object rejects duplicate keys");

  require_true(max_unique_validation_work() == 1000000 &&
    max_checked_value_nodes() == 65536 &&
    max_checked_value_depth() == 64 &&
    max_checked_value_bytes() == 16777216,
    "unified graph and uniqueness fuel budgets remain deterministic");

  // Both ordinary report-only and Result-based entrypoints must preflight.
  // Programmatic Values bypass JSON parser well-formedness. A checked
  // Result may not admit malformed *nested* payloads under any_rule(),
  // an unconstrained array, or an open object schema.
  val Value invalid_discriminant = new Value(
    9, false, new List<int>(), new Utf8Text(new List<int>()),
    new List<int>(), new List<Value>(), new List<WireMember>(),
    new List<MapEntry>(), 0
  );
  require_true(validate_value_checked(
    invalid_discriminant, any_rule(), default_validation_options()
  ).is_err(), "checked any_rule rejects unknown public Value kind");
  require_true(!report_is_valid(validate_value(
    invalid_discriminant, any_rule(), default_validation_options()
  )), "report-only any_rule also rejects a forged wire discriminant");

  val List<Value> invalid_nested_items = new List<Value>();
  invalid_nested_items.add(value_int(1));
  invalid_nested_items.add(invalid_discriminant);
  require_true(validate_value_checked(
    value_array(invalid_nested_items), any_rule(), default_validation_options()
  ).is_err(), "checked array rejects an unknown nested Value kind");

  val List<Value> invalid_number_items = new List<Value>();
  invalid_number_items.add(value_number_lexeme(new List<int>(48,49)));
  require_true(validate_value_checked(
    value_array(invalid_number_items), any_rule(), default_validation_options()
  ).is_err(), "checked array rejects nested noncanonical numeric lexemes");

  val List<Value> invalid_string_items = new List<Value>();
  invalid_string_items.add(value_string(
    new Utf8Text(new List<int>(192,175))
  ));
  require_true(validate_value_checked(
    value_array(invalid_string_items), any_rule(), default_validation_options()
  ).is_err(), "checked array rejects nested malformed UTF-8");

  val List<WireMember> nested_unknown_members = new List<WireMember>();
  nested_unknown_members.add(new WireMember(
    new Utf8Text(new List<int>(111,112,101,110)),
    value_array(invalid_number_items)
  ));
  require_true(validate_object_checked(
    value_object(nested_unknown_members), rt borrow open_schema,
    default_validation_options()
  ).is_err(), "checked open object cannot hide malformed nested unknown field");

  val List<WireMember> duplicate_inner_members = new List<WireMember>();
  duplicate_inner_members.add(new WireMember(
    new Utf8Text(new List<int>(120)), value_int(1)));
  duplicate_inner_members.add(new WireMember(
    new Utf8Text(new List<int>(120)), value_int(2)));
  val List<Value> nested_duplicate_items = new List<Value>();
  nested_duplicate_items.add(value_object(duplicate_inner_members));
  require_true(validate_value_checked(
    value_array(nested_duplicate_items), any_rule(), default_validation_options()
  ).is_err(), "checked arrays reject duplicate object keys at nested depth");

  // Binary and extension payload lists are List<int>, so bypassing a
  // decoder can inject negative or >255 octets. Both must fail closed.
  val List<Value> invalid_binary_items = new List<Value>();
  invalid_binary_items.add(value_bytes(new List<int>(-1)));
  require_true(validate_value_checked(
    value_array(invalid_binary_items), any_rule(), default_validation_options()
  ).is_err(), "checked binary byte payload rejects a negative octet");
  val List<Value> invalid_extension_items = new List<Value>();
  invalid_extension_items.add(value_extension(1, new List<int>(256)));
  require_true(validate_value_checked(
    value_array(invalid_extension_items), any_rule(), default_validation_options()
  ).is_err(), "checked extension byte payload rejects an octet above 255");
  require_true(!validate_value_checked(
    value_bytes(new List<int>(0,127,128,255)), any_rule(),
    default_validation_options()
  ).is_err(), "valid byte octet boundaries remain admitted");

  val List<MapEntry> invalid_map_entries = new List<MapEntry>();
  invalid_map_entries.add(new MapEntry(
    value_number_lexeme(new List<int>(48,49)), value_int(1)
  ));
  require_true(validate_value_checked(
    value_map(invalid_map_entries), any_rule(), default_validation_options()
  ).is_err(), "checked arbitrary map keys also receive lexical preflight");

  // A 64-level nested tree is admitted, one extra level must fail before
  // stack exhaustion. Native compiler execution is still required.
  let Value at_depth_limit = value_int(7);
  let int depth_index = 0;
  loop do
    if depth_index >= 64 then break; fi
    val List<Value> one_child = new List<Value>();
    one_child.add(at_depth_limit);
    at_depth_limit = value_array(one_child);
    depth_index = depth_index + 1;
  done
  require_true(!validate_value_checked(
    rt borrow at_depth_limit, any_rule(), default_validation_options()
  ).is_err(), "checked dynamic tree accepts its inclusive depth boundary");
  val List<Value> extra_depth = new List<Value>();
  extra_depth.add(at_depth_limit);
  require_true(validate_value_checked(
    value_array(extra_depth), any_rule(), default_validation_options()
  ).is_err(), "checked dynamic tree rejects 65 nested array levels");

  val List<Value> canonical_nested_items = new List<Value>();
  canonical_nested_items.add(value_int(1));
  canonical_nested_items.add(value_string(
    new Utf8Text(new List<int>(111,107))));
  require_true(!validate_value_checked(
    value_array(canonical_nested_items), any_rule(), default_validation_options()
  ).is_err(), "canonical nested values remain accepted");

  // ValidationReport is a caller-constructible diagnostic container. Even
  // this deliberately fabricated empty report cannot mint Valid<T>.
  val ValidationReport forged_empty_report = new ValidationReport(
    new List<ValidationError>(), false);
  require_true(report_is_valid(forged_empty_report),
    "report_is_valid means no reported errors, never proof provenance");

  // Nested object equality can do more work than the sum of raw bytes alone.
  // The conservative nested multiplicity charge must fail before hashing.
  val List<Value> nested_work_values = new List<Value>();
  let int work_index = 0;
  loop do
    if work_index >= 400 then break; fi
    val List<int> padding = new List<int>();
    let int padding_index = 0;
    loop do
      if padding_index >= 1000 then break; fi
      padding.add(97);
      padding_index = padding_index + 1;
    done
    val List<WireMember> one_field = new List<WireMember>();
    one_field.add(new WireMember(
      new Utf8Text(int_to_decimal_bytes(work_index)),
      value_string(new Utf8Text(padding))
    ));
    nested_work_values.add(value_object(one_field));
    work_index = work_index + 1;
  done

  val Value nested_work = value_array(nested_work_values);
  val ValidationReport nested_work_denial = validate_value(
    rt borrow nested_work, array_rule(-1, -1, true),
    default_validation_options()
  );
  require_true(!report_is_valid(rt borrow nested_work_denial),
    "nested object hash/equality work must be charged before uniqueness check");

  val ValidationReport nested_work_zero_errors = validate_value(
    rt borrow nested_work, array_rule(-1, -1, true),
    new ValidationOptions(false, 0)
  );
  require_true(nested_work_zero_errors.truncated &&
    !report_is_valid(rt borrow nested_work_zero_errors),
    "zero error capacity cannot authorize uniqueness work-budget denial");

  val List<Value> simple_work_values = new List<Value>();
  let int simple_index = 0;
  loop do
    if simple_index >= 64 then break; fi
    simple_work_values.add(value_int(simple_index));
    simple_index = simple_index + 1;
  done
  require_true(report_is_valid(validate_value(
    value_array(simple_work_values), array_rule(-1, -1, true),
    default_validation_options()
  )), "ordinary unique scalar values remain valid under structural fuel");

  // Report-only entrypoints must not accept invalid nested objects under
  // a permissive schema (regression for previously unchecked entrypoint).
  require_true(!report_is_valid(validate_object(
    value_object(nested_unknown_members), rt borrow open_schema,
    default_validation_options()
  )), "report-only open object must reject malformed nested values");

  return;
}
