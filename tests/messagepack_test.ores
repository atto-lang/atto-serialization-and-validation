import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember, MapEntry from '../src/core/value';
import fnc value_int, value_bool, value_string, value_array, value_object, value_map, value_deep_equal, value_lookup_path from '../src/core/value';
import class DecodeOptions, EncodeOptions, DecodeError, EncodeError, DecodedValue from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import fnc encode, decode from '../src/messagepack/messagepack';

pub fnc run_messagepack_tests(): void {
  val List<Value> values = new List<Value>();
  values.add(value_int(7));
  values.add(value_bool(true));

  val List<WireMember> members = new List<WireMember>();
  members.add(
    new WireMember(
      new Utf8Text(new List<int>(120)),
      value_array(values)
    )
  );

  val Value source = value_object(members);

  val Result<List<int>, EncodeError> encoded = encode(
    rt borrow source,
    default_encode_options()
  );
  require_true(encoded.is_err() == false, "MessagePack object must encode");

  val Result<DecodedValue, DecodeError> decoded = decode(
    encoded.unwrap(),
    default_decode_options()
  );
  require_true(decoded.is_err() == false, "MessagePack object must decode");
  require_true(
    value_deep_equal(source, decoded.unwrap().value),
    "MessagePack dynamic value must round-trip without consuming source"
  );

  // [1, 2, 3] using fixarray/fixints.
  val Result<DecodedValue, DecodeError> fixed = decode(
    new List<int>(147, 1, 2, 3),
    default_decode_options()
  );
  require_true(fixed.is_err() == false, "MessagePack fixarray should decode");
  require_int(fixed.unwrap().value.array_value.length, 3, "MessagePack fixarray length");

  // { 1: 2 } is a general MessagePack map, not a JSON-shaped object.
  val Result<DecodedValue, DecodeError> general_map = decode(
    new List<int>(129, 1, 2),
    default_decode_options()
  );
  require_true(general_map.is_err() == false, "MessagePack integer-key map must decode");
  val DecodedValue general = general_map.unwrap();
  require_int(general.value.kind, 8, "integer-key MessagePack map kind");
  require_int(general.value.map_value.length, 1, "integer-key MessagePack map size");

  val Result<List<int>, EncodeError> general_map_encoded = encode(
    general.value,
    default_encode_options()
  );
  require_true(general_map_encoded.is_err() == false, "MessagePack general map must re-encode");
  require_int(general_map_encoded.unwrap()[0], 129, "MessagePack general map header");

  // fixmap(2): { 1: 2, 1: 3 }
  val List<int> duplicate_map = new List<int>(130, 1, 2, 1, 3);
  val Result<DecodedValue, DecodeError> duplicate_reject = decode(
    rt borrow duplicate_map,
    default_decode_options()
  );
  require_true(duplicate_reject.is_err(), "MessagePack duplicate general-map keys must reject by default");

  val DecodeOptions duplicate_first = new DecodeOptions(
    1, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> first_wins = decode(rt borrow duplicate_map, duplicate_first);
  require_true(!first_wins.is_err(), "MessagePack first-wins duplicate policy must decode");
  val DecodedValue first_value = first_wins.unwrap();
  require_int(first_value.value.map_value.length, 1, "MessagePack first-wins must keep one entry");
  require_int(first_value.value.map_value[0].value.number_lexeme[0], 50, "MessagePack first-wins must preserve first value");

  val DecodeOptions duplicate_last = new DecodeOptions(
    2, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> last_wins = decode(rt borrow duplicate_map, duplicate_last);
  require_true(!last_wins.is_err(), "MessagePack last-wins duplicate policy must decode");
  val DecodedValue last_value = last_wins.unwrap();
  require_int(last_value.value.map_value.length, 1, "MessagePack last-wins must keep one entry");
  require_int(last_value.value.map_value[0].value.number_lexeme[0], 51, "MessagePack last-wins must preserve last value");

  val int min_int = -9223372036854775807 - 1;
  val int max_int = 9223372036854775807;

  val Result<List<int>, EncodeError> min_encoded = encode(
    value_int(min_int),
    default_encode_options()
  );
  require_true(min_encoded.is_err() == false, "MessagePack int64 minimum must encode");

  val Result<DecodedValue, DecodeError> min_decoded = decode(
    min_encoded.unwrap(),
    default_decode_options()
  );
  require_true(min_decoded.is_err() == false, "MessagePack int64 minimum must decode");
  require_true(
    value_deep_equal(value_int(min_int), min_decoded.unwrap().value),
    "MessagePack int64 minimum must round-trip"
  );

  val Result<List<int>, EncodeError> max_encoded = encode(
    value_int(max_int),
    default_encode_options()
  );
  require_true(max_encoded.is_err() == false, "MessagePack int64 maximum must encode");

  val Result<DecodedValue, DecodeError> max_decoded = decode(
    max_encoded.unwrap(),
    default_decode_options()
  );
  require_true(max_decoded.is_err() == false, "MessagePack int64 maximum must decode");
  require_true(
    value_deep_equal(value_int(max_int), max_decoded.unwrap().value),
    "MessagePack int64 maximum must round-trip"
  );

  val Result<DecodedValue, DecodeError> truncated = decode(
    new List<int>(217, 2, 97),
    default_decode_options()
  );
  require_true(truncated.is_err(), "MessagePack truncated str8 must reject");

  val Result<DecodedValue, DecodeError> declared_length_bomb = decode(
    new List<int>(219, 255, 255, 255, 255),
    default_decode_options()
  );
  require_true(
    declared_length_bomb.is_err(),
    "MessagePack huge declared string length must reject before allocation"
  );

  val DecodeOptions tiny_input = new DecodeOptions(
    0, false, 128, 1, 16, 16, 16, 16, 16
  );
  val Result<DecodedValue, DecodeError> input_limited = decode(
    new List<int>(146, 1, 2),
    tiny_input
  );
  require_true(input_limited.is_err(), "MessagePack max_input_bytes must fail closed");


  val DecodeOptions bounded_map_work = new DecodeOptions(
    1, false, 128, 4096, 32, 64, 64, 16, 16
  );
  let List<int> msgpack_work_below = new List<int>();
  msgpack_work_below.add(134);
  for (let i = 0; i < 6; i++) {
    msgpack_work_below.add(176);
    for (let j = 0; j < 16; j++) { msgpack_work_below.add(97); }
    msgpack_work_below.add(i + 1);
  }
  val Result<DecodedValue, DecodeError> msgpack_work_ok = decode(msgpack_work_below, bounded_map_work);
  require_true(!msgpack_work_ok.is_err(), "MessagePack collision work below budget succeeds");

  let List<int> msgpack_work_over = new List<int>();
  msgpack_work_over.add(135);
  for (let i = 0; i < 7; i++) {
    msgpack_work_over.add(176);
    for (let j = 0; j < 16; j++) { msgpack_work_over.add(97); }
    msgpack_work_over.add(i + 1);
  }
  val Result<DecodedValue, DecodeError> msgpack_work_limited = decode(msgpack_work_over, bounded_map_work);
  require_true(msgpack_work_limited.is_err(), "MessagePack collision work over budget fails closed");

  let List<int> nested_map_work_below = new List<int>();
  nested_map_work_below.add(149);
  for (let i = 0; i < 5; i++) {
    nested_map_work_below.add(130);
    for (let n = 0; n < 2; n++) {
      nested_map_work_below.add(176);
      for (let j = 0; j < 16; j++) { nested_map_work_below.add(97); }
      nested_map_work_below.add(n + 1);
    }
  }
  val Result<DecodedValue, DecodeError> nested_map_work_ok = decode(nested_map_work_below, bounded_map_work);
  require_true(!nested_map_work_ok.is_err(), "nested MessagePack maps below shared budget succeed");

  let List<int> nested_map_work = new List<int>();
  nested_map_work.add(150);
  for (let i = 0; i < 6; i++) {
    nested_map_work.add(130);
    for (let n = 0; n < 2; n++) {
      nested_map_work.add(176);
      for (let j = 0; j < 16; j++) { nested_map_work.add(97); }
      nested_map_work.add(n + 1);
    }
  }
  val Result<DecodedValue, DecodeError> nested_map_limited = decode(nested_map_work, bounded_map_work);
  require_true(nested_map_limited.is_err(), "nested MessagePack maps share one operation budget");

  // Nested general-map keys have their own hash-bucket equality work. Two
  // equal 16-entry map keys with all-colliding duplicate integer keys would
  // outer map comparison must reject them before deep equality starts.
  let List<int> nested_collision_wire = new List<int>();
  nested_collision_wire.add(130);
  for (let outer = 0; outer < 2; outer++) {
    nested_collision_wire.add(222);
    nested_collision_wire.add(0); nested_collision_wire.add(16);
    for (let inner = 0; inner < 16; inner++) {
      nested_collision_wire.add(1);
      nested_collision_wire.add(inner + 1);
    }
    nested_collision_wire.add(outer + 1);
  }
  val Result<DecodedValue, DecodeError> nested_key_collision = decode(
    nested_collision_wire, bounded_map_work
  );
  require_true(nested_key_collision.is_err(),
    "MessagePack nested map-key equality must charge its internal collision scan");
  // Encoder-side preflight must bound nested equality structures too, before
  // hashing a caller-owned map key. 300 colliding inner keys make the
  // conservative structural comparison estimate exceed the hash budget.
  let List<MapEntry> very_large_nested_entries = new List<MapEntry>();
  for (let inner = 0; inner < 300; inner++) {
    very_large_nested_entries.add(new MapEntry(value_int(1), value_int(inner)));
  }
  let Value very_large_nested_key = value_map(very_large_nested_entries);
  let List<MapEntry> very_large_outer_entries = new List<MapEntry>();
  very_large_outer_entries.add(new MapEntry(very_large_nested_key, value_int(1)));
  val Result<List<int>, EncodeError> nested_encoder_work_limited = encode(
    value_map(very_large_outer_entries), new EncodeOptions(128, 16777216)
  );
  require_true(nested_encoder_work_limited.is_err(),
    "MessagePack encoder bounds collision cost inside caller-owned nested map keys");
  let List<int> long_key_bytes = new List<int>();
  for (let i = 0; i < 80; i++) { long_key_bytes.add(97); }
  let List<MapEntry> long_key_entries = new List<MapEntry>();
  long_key_entries.add(new MapEntry(value_string(new Utf8Text(long_key_bytes)), value_int(1)));
  val Result<List<int>, EncodeError> mp_key_hash_limited = encode(
    value_map(long_key_entries), new EncodeOptions(128, 64)
  );
  require_true(mp_key_hash_limited.is_err(), "MessagePack encoder bounds key hashing by output limit");

  let List<Value> depth_two_values = new List<Value>();
  depth_two_values.add(value_int(1));
  let Value depth_two_key = value_array(new List<Value>(value_array(depth_two_values)));
  let List<MapEntry> deep_key_entries = new List<MapEntry>();
  deep_key_entries.add(new MapEntry(depth_two_key, value_int(1)));
  val Result<List<int>, EncodeError> deep_key_limited = encode(
    value_map(deep_key_entries), new EncodeOptions(1, 4096)
  );
  require_true(deep_key_limited.is_err(), "MessagePack encoder rejects over-depth keys before hashing");

  return;
}
