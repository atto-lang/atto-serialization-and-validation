import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember, MapEntry from '../src/core/value';
import fnc value_bytes, value_int, value_bool, value_string, value_array, value_object, value_map, value_deep_equal, value_lookup_path from '../src/core/value';
import class DecodeOptions, EncodeOptions, DecodeError, EncodeError, DecodedValue from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import fnc encode, decode, decode_actor_bounded from '../src/messagepack/messagepack';

fnc codec_work_map(int payload): Value {
  val List<int> bytes = new List<int>();
  let int i = 0;
  loop do
    if i >= payload then break; fi
    bytes.add(97);
    i = i + 1;
  done
  val List<MapEntry> entries = new List<MapEntry>();
  entries.add(new MapEntry(value_bytes(bytes), value_int(1)));
  return value_map(entries);
}

fnc codec_work_graph(int second_payload): Value {
  val List<Value> children = new List<Value>();
  children.add(codec_work_map(499999));
  children.add(codec_work_map(second_payload));
  return value_array(children);
}

fnc codec_work_wire(int second_payload): List<int> {
  val List<int> wire = new List<int>();
  wire.add(146);
  let int j = 0;
  loop do
    if j >= 2 then break; fi
    let int payload = 499999;
    if j == 1 then payload = second_payload; fi
    wire.add(129);
    wire.add(198);
    // All candidate lengths are 0x0007a11f or 0x0007a120.
    wire.add(0);
    wire.add(7);
    wire.add(161);
    if payload == 499999 then wire.add(31); else wire.add(32); fi
    let int k = 0;
    loop do
      if k >= payload then break; fi
      wire.add(97);
      k = k + 1;
    done
    wire.add(1);
    j = j + 1;
  done
  return wire;
}

fnc nested_node_wire(bool over): List<int> {
  val List<int> wire = new List<int>();
  wire.add(146);
  let int group = 0;
  loop do
    if group >= 2 then break; fi
    wire.add(220);
    if group == 0 then
      wire.add(127);
      wire.add(254);
    elseif over then
      wire.add(128);
      wire.add(0);
    else
      wire.add(127);
      wire.add(255);
    fi
    let int count = 32766;
    if group == 1 then count = 32767; fi
    if group == 1 && over then count = count + 1; fi
    let int i = 0;
    loop do
      if i >= count then break; fi
      wire.add(0);
      i = i + 1;
    done
    group = group + 1;
  done
  return wire;
}

fnc actor_profile_options(): DecodeOptions {
  return new DecodeOptions(0, false, 64, 64, 64, 64, 64, 64, 64);
}

fnc actor_nested_wire(): List<int> {
  return new List<int>(146,146,1,2,145,3);
}

pub fnc run_messagepack_tests(): void {
  val Result<DecodedValue, DecodeError> actor_exact =
    decode_actor_bounded(actor_nested_wire(), actor_profile_options(), 992, 24);
  require_true(!actor_exact.is_err(), "actor exact nested cumulative budget");
  require_int(actor_exact.unwrap().value.array_value.length, 2, "actor nested shape");
  require_true(decode_actor_bounded(actor_nested_wire(), actor_profile_options(), 991, 24).is_err(),
    "actor one logical byte under denied");
  require_true(decode_actor_bounded(actor_nested_wire(), actor_profile_options(), 992, 23).is_err(),
    "actor one work credit under denied");
  require_true(decode_actor_bounded(new List<int>(145,129,1,2),
    actor_profile_options(), 4096, 256).is_err(), "nested actor map denied");
  require_true(decode_actor_bounded(new List<int>(212,1,0),
    actor_profile_options(), 4096, 256).is_err(), "actor fixed extension denied");
  require_true(decode_actor_bounded(new List<int>(199,1,1,0),
    actor_profile_options(), 4096, 256).is_err(), "actor variable extension denied");
  require_true(decode_actor_bounded(new List<int>(222,0,0),
    actor_profile_options(), 4096, 256).is_err(), "actor map16 denied");
  require_true(decode_actor_bounded(new List<int>(223,0,0,0,0),
    actor_profile_options(), 4096, 256).is_err(), "actor map32 denied");
  require_true(decode_actor_bounded(new List<int>(145,146,1),
    actor_profile_options(), 4096, 256).is_err(), "actor truncated array denied");
  require_true(decode_actor_bounded(new List<int>(1,2),
    actor_profile_options(), 4096, 256).is_err(), "actor trailing data denied");
  require_true(decode_actor_bounded(new List<int>(161,255),
    actor_profile_options(), 4096, 256).is_err(), "actor malformed UTF8 denied");
  require_true(decode_actor_bounded(new List<int>(220,0,64),
    actor_profile_options(), 512, 256).is_err(), "actor declared array cannot exceed remaining budget");
  require_true(!decode(new List<int>(129,1,2), actor_profile_options()).is_err(),
    "generic dynamic map remains available");
  require_true(!decode_actor_bounded(new List<int>(145,195), actor_profile_options(), 416, 8).is_err(),
    "exact array and boolean control");
  require_true(decode_actor_bounded(new List<int>(1),
    new DecodeOptions(1,false,64,64,64,64,64,64,64), 4096,256).is_err(),
    "actor rejects permissive duplicate policy");
  require_true(decode_actor_bounded(new List<int>(1),
    new DecodeOptions(0,true,64,64,64,64,64,64,64), 4096,256).is_err(),
    "actor rejects trailing-data option");
  require_true(decode_actor_bounded(new List<int>(1),
    new DecodeOptions(0,false,65,64,64,64,64,64,64), 4096,256).is_err(),
    "actor rejects depth policy above 64");

  require_true(!decode(nested_node_wire(false), default_decode_options()).is_err(),
    "messagepack exact cumulative node count across nested arrays");
  require_true(decode(nested_node_wire(true), default_decode_options()).is_err(),
    "messagepack cumulative node count one over across nested arrays");

  require_true(!encode(codec_work_graph(499999), default_encode_options()).is_err(),
    "messagepack writer exact shared key budget");
  require_true(encode(codec_work_graph(500000), default_encode_options()).is_err(),
    "messagepack writer rejects one over shared key budget");
  require_true(!decode(codec_work_wire(499999), default_decode_options()).is_err(),
    "messagepack reader exact shared key budget");
  require_true(decode(codec_work_wire(500000), default_decode_options()).is_err(),
    "messagepack reader rejects one over shared key budget");

  val List<Value> deep_key = new List<Value>();
  deep_key.add(value_int(7));
  val List<MapEntry> deep_entries = new List<MapEntry>();
  deep_entries.add(new MapEntry(value_array(deep_key), value_int(1)));
  require_true(encode(value_map(deep_entries), new EncodeOptions(1,64)).is_err(),
    "messagepack writer denies nested key beyond depth before hashing");
  val List<Value> legal_key = new List<Value>();
  legal_key.add(value_int(7));
  val List<MapEntry> legal_entries = new List<MapEntry>();
  legal_entries.add(new MapEntry(value_array(legal_key), value_int(1)));
  require_true(!encode(value_map(legal_entries), new EncodeOptions(2,64)).is_err(),
    "messagepack writer accepts legal nested key control");

  val List<Value> values = new List<Value>();
  values.add(value_int(7));
  values.add(value_bool(true));

  val List<WireMember> members = new List<WireMember>();
  members.add(
    new WireMember(
      new Utf8Text(new List<int>(120)),
      value_array(values)
    )
  );

  val Value source = value_object(members);

  val Result<List<int>, EncodeError> encoded = encode(
    rt borrow source,
    default_encode_options()
  );
  require_true(encoded.is_err() == false, "MessagePack object must encode");

  val Result<DecodedValue, DecodeError> decoded = decode(
    encoded.unwrap(),
    default_decode_options()
  );
  require_true(decoded.is_err() == false, "MessagePack object must decode");
  require_true(
    value_deep_equal(source, decoded.unwrap().value),
    "MessagePack dynamic value must round-trip without consuming source"
  );

  // [1, 2, 3] using fixarray/fixints.
  val Result<DecodedValue, DecodeError> fixed = decode(
    new List<int>(147, 1, 2, 3),
    default_decode_options()
  );
  require_true(fixed.is_err() == false, "MessagePack fixarray should decode");
  require_int(fixed.unwrap().value.array_value.length, 3, "MessagePack fixarray length");

  // { 1: 2 } is a general MessagePack map, not a JSON-shaped object.
  val Result<DecodedValue, DecodeError> general_map = decode(
    new List<int>(129, 1, 2),
    default_decode_options()
  );
  require_true(general_map.is_err() == false, "MessagePack integer-key map must decode");
  val DecodedValue general = general_map.unwrap();
  require_int(general.value.kind, 8, "integer-key MessagePack map kind");
  require_int(general.value.map_value.length, 1, "integer-key MessagePack map size");

  val Result<List<int>, EncodeError> general_map_encoded = encode(
    general.value,
    default_encode_options()
  );
  require_true(general_map_encoded.is_err() == false, "MessagePack general map must re-encode");
  require_int(general_map_encoded.unwrap()[0], 129, "MessagePack general map header");

  // fixmap(2): { 1: 2, 1: 3 }
  val List<int> duplicate_map = new List<int>(130, 1, 2, 1, 3);
  val Result<DecodedValue, DecodeError> duplicate_reject = decode(
    rt borrow duplicate_map,
    default_decode_options()
  );
  require_true(duplicate_reject.is_err(), "MessagePack duplicate general-map keys must reject by default");

  val DecodeOptions duplicate_first = new DecodeOptions(
    1, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> first_wins = decode(rt borrow duplicate_map, duplicate_first);
  require_true(!first_wins.is_err(), "MessagePack first-wins duplicate policy must decode");
  val DecodedValue first_value = first_wins.unwrap();
  require_int(first_value.value.map_value.length, 1, "MessagePack first-wins must keep one entry");
  require_int(first_value.value.map_value[0].value.number_lexeme[0], 50, "MessagePack first-wins must preserve first value");

  val DecodeOptions duplicate_last = new DecodeOptions(
    2, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> last_wins = decode(rt borrow duplicate_map, duplicate_last);
  require_true(!last_wins.is_err(), "MessagePack last-wins duplicate policy must decode");
  val DecodedValue last_value = last_wins.unwrap();
  require_int(last_value.value.map_value.length, 1, "MessagePack last-wins must keep one entry");
  require_int(last_value.value.map_value[0].value.number_lexeme[0], 51, "MessagePack last-wins must preserve last value");

  val int min_int = -9223372036854775807 - 1;
  val int max_int = 9223372036854775807;

  val Result<List<int>, EncodeError> min_encoded = encode(
    value_int(min_int),
    default_encode_options()
  );
  require_true(min_encoded.is_err() == false, "MessagePack int64 minimum must encode");

  val Result<DecodedValue, DecodeError> min_decoded = decode(
    min_encoded.unwrap(),
    default_decode_options()
  );
  require_true(min_decoded.is_err() == false, "MessagePack int64 minimum must decode");
  require_true(
    value_deep_equal(value_int(min_int), min_decoded.unwrap().value),
    "MessagePack int64 minimum must round-trip"
  );

  val Result<List<int>, EncodeError> max_encoded = encode(
    value_int(max_int),
    default_encode_options()
  );
  require_true(max_encoded.is_err() == false, "MessagePack int64 maximum must encode");

  val Result<DecodedValue, DecodeError> max_decoded = decode(
    max_encoded.unwrap(),
    default_decode_options()
  );
  require_true(max_decoded.is_err() == false, "MessagePack int64 maximum must decode");
  require_true(
    value_deep_equal(value_int(max_int), max_decoded.unwrap().value),
    "MessagePack int64 maximum must round-trip"
  );

  val Result<DecodedValue, DecodeError> truncated = decode(
    new List<int>(217, 2, 97),
    default_decode_options()
  );
  require_true(truncated.is_err(), "MessagePack truncated str8 must reject");

  val Result<DecodedValue, DecodeError> declared_length_bomb = decode(
    new List<int>(219, 255, 255, 255, 255),
    default_decode_options()
  );
  require_true(
    declared_length_bomb.is_err(),
    "MessagePack huge declared string length must reject before allocation"
  );

  val DecodeOptions tiny_input = new DecodeOptions(
    0, false, 128, 1, 16, 16, 16, 16, 16
  );
  val Result<DecodedValue, DecodeError> input_limited = decode(
    new List<int>(146, 1, 2),
    tiny_input
  );
  require_true(input_limited.is_err(), "MessagePack max_input_bytes must fail closed");

  return;
}
