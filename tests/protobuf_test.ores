import fnc require_true, require_int from './assert';

import class ProtoField, ProtoMessage, ProtoError, ProtoDecodeOptions, ProtoEncodeOptions from '../src/protobuf/wire';
import fnc proto_varint, proto_bytes, proto_raw_varint, proto_fixed32, proto_descriptor_field_number_valid, proto_wire_field_valid, proto_field_reencoded_wire_bytes, default_proto_decode_options, default_proto_encode_options from '../src/protobuf/wire';
import fnc encode_message, decode_message, fields_with_number, proto_message_copy_bounded from '../src/protobuf/wire';

pub fnc run_protobuf_tests(): void {
  val List<ProtoField> fields = new List<ProtoField>();
  fields.add(proto_varint(1, 150));
  fields.add(proto_bytes(2, new List<int>(104, 105)));

  val ProtoMessage message = new ProtoMessage(fields);

  val Result<List<int>, ProtoError> encoded = encode_message(
    message,
    default_proto_encode_options()
  );
  require_true(encoded.is_err() == false, "Protobuf message must encode");

  val List<int> expected = new List<int>(8, 150, 1, 18, 2, 104, 105);
  val List<int> actual = encoded.unwrap();

  require_int(actual.length, expected.length, "Protobuf encoded length");
  let int i = 0;
  loop do
    if i >= expected.length then
      break;
    fi
    require_int(actual[i], expected[i], "Protobuf encoded byte mismatch");
    i = i + 1;
  done

  val Result<ProtoMessage, ProtoError> decoded = decode_message(
    actual,
    default_proto_decode_options()
  );
  require_true(decoded.is_err() == false, "Protobuf message must decode");

  val ProtoMessage roundtrip = decoded.unwrap();
  require_int(roundtrip.fields.length, 2, "Protobuf field count");
  require_int(roundtrip.fields[0].field_number, 1, "Protobuf field 1 number");
  require_int(roundtrip.fields[0].varint_value, 150, "Protobuf field 1 value");

  val List<ProtoField> field_two = fields_with_number(roundtrip, 2);
  require_int(field_two.length, 1, "Protobuf field lookup");
  require_int(field_two[0].payload.length, 2, "Protobuf length-delimited payload");
  // A field-number lookup must not hand out the exact nested mutable payload
  // inside the message; callers can modify returned bytes independently.
  field_two[0].payload.add(77);
  require_int(field_two[0].payload.length, 3,
    "field lookup returns a mutable local copy");
  require_int(roundtrip.fields[1].payload.length, 2,
    "field lookup mutation must not corrupt original message");


  // field 1 = uint64 max, encoded as ten varint bytes. It exceeds signed int,
  // so the raw wire bytes must be preserved exactly.
  val List<int> uint64_max = new List<int>(
    8,
    255, 255, 255, 255, 255, 255, 255, 255, 255, 1
  );

  val Result<ProtoMessage, ProtoError> raw_decoded = decode_message(
    rt borrow uint64_max,
    default_proto_decode_options()
  );
  require_true(raw_decoded.is_err() == false, "Protobuf uint64 max must decode as preserved raw varint");

  val ProtoMessage raw_roundtrip = raw_decoded.unwrap();
  val ProtoField raw_field = raw_roundtrip.fields[0];
  require_true(!raw_field.varint_fits_int, "uint64 max must not be narrowed into signed int");
  require_int(raw_field.payload.length, 10, "uint64 max raw varint byte count");

  val Result<List<int>, ProtoError> raw_reencoded = encode_message(
    raw_roundtrip,
    default_proto_encode_options()
  );
  require_true(raw_reencoded.is_err() == false, "preserved uint64 max must re-encode");

  val List<int> raw_bytes = raw_reencoded.unwrap();
  require_int(raw_bytes.length, uint64_max.length, "preserved uint64 max encoded length");

  let int j = 0;
  loop do
    if j >= uint64_max.length then
      break;
    fi
    require_int(raw_bytes[j], uint64_max[j], "preserved uint64 max byte mismatch");
    j = j + 1;
  done

  // A manually forged ProtoField must not claim an integer that disagrees
  // with its separately supplied raw varint bytes. Both the report-only
  // field admission and the actual encoder must refuse the mismatch.
  val ProtoField forged_integer = new ProtoField(
    1, 0, true, 2, new List<int>(1)
  );
  require_true(!proto_wire_field_valid(forged_integer),
    "signed varint metadata must agree with raw bytes");
  require_int(proto_field_reencoded_wire_bytes(forged_integer), -1,
    "forged raw/integer pair must not receive a valid wire-size report");
  val Result<List<int>, ProtoError> forged_encode = encode_message(
    new ProtoMessage(new List<ProtoField>(forged_integer)),
    default_proto_encode_options()
  );
  require_true(forged_encode.is_err(),
    "encoder must reject inconsistent declared integer and raw payload");

  // Nonminimal raw varints remain acceptable when consistent with the
  // declared signed value; re-encoding preserves the two raw value bytes.
  val ProtoField consistent_nonminimal = new ProtoField(
    1, 0, true, 1, new List<int>(129, 0)
  );
  require_true(proto_wire_field_valid(consistent_nonminimal),
    "consistent nonminimal signed varint must remain legal");
  val Result<List<int>, ProtoError> nonminimal_encode = encode_message(
    new ProtoMessage(new List<ProtoField>(consistent_nonminimal)),
    default_proto_encode_options()
  );
  require_true(!nonminimal_encode.is_err(),
    "consistent nonminimal signed varint must encode");
  require_int(nonminimal_encode.unwrap().length, 3,
    "nonminimal signed varint preserves original two value bytes");
  require_int(nonminimal_encode.unwrap()[1], 129,
    "nonminimal signed varint continuation is preserved");
  require_int(nonminimal_encode.unwrap()[2], 0,
    "nonminimal signed varint terminal byte is preserved");

  val ProtoField misclaimed_ten_byte = new ProtoField(
    1, 0, true, 0,
    new List<int>(128, 128, 128, 128, 128, 128, 128, 128, 128, 0)
  );
  require_true(!proto_wire_field_valid(misclaimed_ten_byte),
    "ten-byte varint must never be advertised as signed-int fitting");
  require_true(encode_message(
    new ProtoMessage(new List<ProtoField>(misclaimed_ten_byte)),
    default_proto_encode_options()
  ).is_err(), "encoder must deny forged signed-int fit for ten raw bytes");
  val ProtoField opaque_ten_byte = proto_raw_varint(
    1, new List<int>(128, 128, 128, 128, 128, 128, 128, 128, 128, 0)
  );
  require_true(proto_wire_field_valid(opaque_ten_byte),
    "valid ten-byte raw varint can remain opaque and preserved");

  val Result<ProtoMessage, ProtoError> zero_field = decode_message(
    new List<int>(0),
    default_proto_decode_options()
  );
  require_true(zero_field.is_err(), "Protobuf field number zero must reject");

  val Result<ProtoMessage, ProtoError> overlong_varint = decode_message(
    new List<int>(
      8,
      128, 128, 128, 128, 128,
      128, 128, 128, 128, 128
    ),
    default_proto_decode_options()
  );
  require_true(overlong_varint.is_err(), "Protobuf varint continuation beyond ten bytes must reject");

  val Result<ProtoMessage, ProtoError> length_range = decode_message(
    new List<int>(
      18,
      255, 255, 255, 255, 255,
      255, 255, 255, 255, 1
    ),
    default_proto_decode_options()
  );
  require_true(length_range.is_err(), "Protobuf uint64 length above signed range must reject");

  val ProtoDecodeOptions tiny_input = new ProtoDecodeOptions(1, 16, 16);
  val Result<ProtoMessage, ProtoError> input_limited = decode_message(
    new List<int>(8, 1),
    tiny_input
  );
  require_true(input_limited.is_err(), "Protobuf max_input_bytes must fail closed");


  // Field 16 has a two-byte key (128,1); value 16384 needs three
  // varint bytes (128,128,1). Exercises quotient/remainder lowering
  // without the deprecated modulo operator on all supported backends.
  val List<ProtoField> multi_key_fields = new List<ProtoField>();
  multi_key_fields.add(proto_varint(16, 16384));
  val Result<List<int>, ProtoError> multi_key_encoded = encode_message(
    new ProtoMessage(multi_key_fields), default_proto_encode_options()
  );
  require_true(!multi_key_encoded.is_err(), "two-byte Protobuf tag must encode");
  val List<int> multi_key_wire = multi_key_encoded.unwrap();
  val List<int> multi_key_expected = new List<int>(128, 1, 128, 128, 1);
  require_int(multi_key_wire.length, multi_key_expected.length,
    "multi-byte tag and varint encoded length");
  let int key_index = 0;
  loop do
    if key_index >= multi_key_expected.length then
      break;
    fi
    require_int(multi_key_wire[key_index], multi_key_expected[key_index],
      "exact multi-byte tag/value wire bytes");
    key_index = key_index + 1;
  done
  val Result<ProtoMessage, ProtoError> multi_key_decoded = decode_message(
    multi_key_wire, default_proto_decode_options()
  );
  require_true(!multi_key_decoded.is_err(), "multi-byte tag/value must decode");
  require_int(multi_key_decoded.unwrap().fields[0].field_number, 16,
    "multi-byte field key must preserve numeric field number");

  // Constructor byte lists are snapshots, not aliases of mutable caller input.
  val List<int> mutable_source = new List<int>(3, 7, 9, 11);
  val ProtoField copied_fixed = proto_fixed32(4, mutable_source);
  mutable_source.add(13);
  require_int(copied_fixed.payload.length, 4, "fixed32 constructor must snapshot byte source");
  require_int(copied_fixed.payload[3], 11, "fixed32 snapshot must not change");

  val List<int> raw_source = new List<int>(128, 1);
  val ProtoField copied_varint = proto_raw_varint(5, raw_source);
  raw_source.add(1);
  require_int(copied_varint.payload.length, 2, "raw varint constructor must snapshot byte source");

  // Mutable ProtoMessage.fields can alias caller lists. An explicit bounded
  // copy must isolate the parent list AND nested byte payloads in both directions.
  val List<ProtoField> copy_source_fields = new List<ProtoField>();
  copy_source_fields.add(proto_bytes(1, new List<int>(20, 30)));
  val ProtoMessage copy_source = new ProtoMessage(copy_source_fields);
  val Result<ProtoMessage, ProtoError> safe_copy_result = proto_message_copy_bounded(
    copy_source, new ProtoDecodeOptions(4, 2, 2)
  );
  require_true(!safe_copy_result.is_err(),
    "bounded Protobuf independent message copy must succeed");
  val ProtoMessage isolated_copy = safe_copy_result.unwrap();
  copy_source_fields[0].payload.add(77);
  copy_source_fields.add(proto_varint(2, 1));
  require_int(isolated_copy.fields.length, 1,
    "subsequent parent-list mutation must not modify bounded copy");
  require_int(isolated_copy.fields[0].payload.length, 2,
    "subsequent original payload mutation must not modify bounded copy");
  isolated_copy.fields[0].payload.add(88);
  require_int(copy_source_fields[0].payload[2], 77,
    "bounded copy payload mutation must not modify original bytes");
  require_int(isolated_copy.fields[0].payload[2], 88,
    "bounded copy independently retains its own mutation");

  val Result<ProtoMessage, ProtoError> over_budget_copy = proto_message_copy_bounded(
    new ProtoMessage(new List<ProtoField>(
      proto_bytes(1, new List<int>(20, 30))
    )), new ProtoDecodeOptions(3, 2, 2)
  );
  require_true(over_budget_copy.is_err(),
    "bounded copy must count field key plus length prefix and payload");
  // The payload exactly fills max_input_bytes: the required tag cannot fit.
  // Reject before scanning the two content bytes or allocating a copy.
  val Result<ProtoMessage, ProtoError> no_tag_space_copy = proto_message_copy_bounded(
    new ProtoMessage(new List<ProtoField>(
      proto_bytes(1, new List<int>(20, 30))
    )), new ProtoDecodeOptions(2, 2, 2)
  );
  require_true(no_tag_space_copy.is_err(),
    "bounded copy must fail when payload leaves zero bytes for field key");
  val Result<ProtoMessage, ProtoError> over_length_copy = proto_message_copy_bounded(
    new ProtoMessage(new List<ProtoField>(
      proto_bytes(1, new List<int>(20, 30))
    )), new ProtoDecodeOptions(4, 2, 1)
  );
  require_true(over_length_copy.is_err(),
    "bounded copy must reject length-delimited payload over limit");
  val Result<ProtoMessage, ProtoError> invalid_byte_copy = proto_message_copy_bounded(
    new ProtoMessage(new List<ProtoField>(
      proto_bytes(1, new List<int>(20, 256))
    )), new ProtoDecodeOptions(4, 2, 2)
  );
  require_true(invalid_byte_copy.is_err(),
    "bounded copy must reject malformed bytes without projecting");

  // A new copy must reject post-copy mutation of the original. The old
  // detached copy must remain independently valid data.
  copy_source_fields[0].payload.add(256);
  val Result<ProtoMessage, ProtoError> modified_source_copy = proto_message_copy_bounded(
    copy_source, new ProtoDecodeOptions(12, 3, 10)
  );
  require_true(modified_source_copy.is_err(),
    "new copy must reject invalid source bytes added after earlier copy");
  require_int(isolated_copy.fields[0].payload.length, 3,
    "old detached copy remains unaffected by modified original");

  val List<ProtoField> invalid_raw_copy_fields = new List<ProtoField>();
  invalid_raw_copy_fields.add(proto_raw_varint(1, new List<int>(128)));
  val Result<ProtoMessage, ProtoError> invalid_raw_copy = proto_message_copy_bounded(
    new ProtoMessage(invalid_raw_copy_fields), new ProtoDecodeOptions(4, 1, 4)
  );
  require_true(invalid_raw_copy.is_err(),
    "copy of unterminated raw varint must fail closed");

  // The maximum signed i64 uses exactly nine varint bytes, not ten.
  // This boundary must retain the exact integer, without overflow or narrowing.
  val Result<ProtoMessage, ProtoError> signed_max = decode_message(
    new List<int>(8, 255, 255, 255, 255, 255, 255, 255, 255, 127),
    default_proto_decode_options()
  );
  require_true(!signed_max.is_err(), "signed i64 max varint must decode");
  val ProtoMessage signed_max_message = signed_max.unwrap();
  require_true(signed_max_message.fields[0].varint_fits_int, "signed i64 max must fit int");
  require_int(signed_max_message.fields[0].varint_value, 9223372036854775807,
    "signed i64 max must be decoded exactly");

  // The reserved tag range is forbidden to *schema declarations* but remains
  // syntactically legal for unknown wire fields and must roundtrip.
  require_true(proto_descriptor_field_number_valid(18999),
    "ordinary descriptor number is legal");
  require_true(!proto_descriptor_field_number_valid(19000), "19000 must not be declared");
  require_true(!proto_descriptor_field_number_valid(19999), "19999 must not be declared");
  require_true(proto_descriptor_field_number_valid(20000), "20000 is allowed");
  val List<ProtoField> reserved_fields = new List<ProtoField>();
  reserved_fields.add(proto_varint(19000, 17));
  val Result<List<int>, ProtoError> reserved_wire = encode_message(
    new ProtoMessage(reserved_fields), default_proto_encode_options()
  );
  require_true(!reserved_wire.is_err(), "unknown reserved tag should pass wire-level encoding");
  val Result<ProtoMessage, ProtoError> reserved_parsed = decode_message(
    reserved_wire.unwrap(), default_proto_decode_options()
  );
  require_true(!reserved_parsed.is_err(), "unknown reserved tag should survive wire decoding");
  require_int(reserved_parsed.unwrap().fields[0].field_number, 19000,
    "unknown reserved tag must retain numeric identity");

  val Result<ProtoMessage, ProtoError> bad_tenth = decode_message(
    new List<int>(8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 2),
    default_proto_decode_options()
  );
  require_true(bad_tenth.is_err(), "tenth varint byte greater than 1 is overflow");

  val Result<ProtoMessage, ProtoError> bad_wire_type = decode_message(
    new List<int>(11, 1), default_proto_decode_options()
  );
  require_true(bad_wire_type.is_err(), "deprecated group wire type must reject");

  // Re-encoded wire size is tag + optional length varint + content.
  // Boundary 15->16 increases key size from one to two bytes.
  require_int(proto_field_reencoded_wire_bytes(proto_varint(15, 1)), 2,
    "one-byte key plus one-byte varint");
  require_int(proto_field_reencoded_wire_bytes(proto_varint(16, 1)), 3,
    "two-byte key plus one-byte varint");
  require_int(proto_field_reencoded_wire_bytes(proto_varint(19000, 1)), 4,
    "reserved unknown wire tag retains three-byte key");
  require_int(proto_field_reencoded_wire_bytes(raw_field), 11,
    "uint64-max preserved varint is ten bytes plus key");
  require_int(proto_field_reencoded_wire_bytes(proto_varint(536870911, 1)), 6,
    "maximum legal tag uses five key bytes");
  require_int(proto_field_reencoded_wire_bytes(proto_bytes(1, new List<int>(7))), 3,
    "length-delimited byte adds key and length prefix");

  val List<int> long_payload = new List<int>();
  let int k = 0;
  loop do
    if k >= 128 then
      break;
    fi
    long_payload.add(7);
    k = k + 1;
  done
  val ProtoField long_field = proto_bytes(1, long_payload);
  require_int(proto_field_reencoded_wire_bytes(long_field), 131,
    "128 content bytes require a two-byte length prefix");
  val List<ProtoField> long_fields = new List<ProtoField>();
  long_fields.add(long_field);
  val Result<List<int>, ProtoError> encoded_long = encode_message(
    new ProtoMessage(long_fields), default_proto_encode_options()
  );
  require_true(!encoded_long.is_err(), "128-byte payload should encode");
  require_int(encoded_long.unwrap().length, 131,
    "computed canonical byte count must match real encoded size");

  val List<ProtoField> bad_fixed_fields = new List<ProtoField>();
  bad_fixed_fields.add(proto_fixed32(1, new List<int>(1, 2, 3)));
  val Result<List<int>, ProtoError> bad_fixed = encode_message(
    new ProtoMessage(bad_fixed_fields), default_proto_encode_options()
  );
  require_true(bad_fixed.is_err(), "fixed32 must reject non-four-byte payload");

  val List<ProtoField> bad_raw_fields = new List<ProtoField>();
  bad_raw_fields.add(proto_raw_varint(1, new List<int>(128)));
  val Result<List<int>, ProtoError> bad_raw = encode_message(
    new ProtoMessage(bad_raw_fields), default_proto_encode_options()
  );
  require_true(bad_raw.is_err(), "unterminated raw varint must reject");

  val List<ProtoField> non_byte_fields = new List<ProtoField>();
  non_byte_fields.add(proto_bytes(1, new List<int>(20, 256)));
  val Result<List<int>, ProtoError> non_byte_encoded = encode_message(
    new ProtoMessage(non_byte_fields), default_proto_encode_options()
  );
  require_true(non_byte_encoded.is_err(), "non-byte payload must fail closed");

  val List<ProtoField> too_large_fields = new List<ProtoField>();
  too_large_fields.add(proto_bytes(1, new List<int>(1, 2, 3, 4)));
  val Result<List<int>, ProtoError> too_large_encoded = encode_message(
    new ProtoMessage(too_large_fields), new ProtoEncodeOptions(3)
  );
  require_true(too_large_encoded.is_err(), "payload budget must reject before output exposure");

  val Result<ProtoMessage, ProtoError> truncated_length = decode_message(
    new List<int>(10, 5, 1, 2), default_proto_decode_options()
  );
  require_true(truncated_length.is_err(), "truncated length-delimited input must reject");

  return;
}
