import fnc require_true, require_int from './assert';

import class ProtoField, ProtoMessage, ProtoError, ProtoDecodeOptions, ProtoEncodeOptions from '../src/protobuf/wire';
import fnc proto_varint, proto_bytes, proto_raw_varint, proto_fixed32, proto_descriptor_field_number_valid, default_proto_decode_options, default_proto_encode_options from '../src/protobuf/wire';
import fnc encode_message, decode_message, fields_with_number from '../src/protobuf/wire';

pub fnc run_protobuf_tests(): void {
  val List<ProtoField> fields = new List<ProtoField>();
  fields.add(proto_varint(1, 150));
  fields.add(proto_bytes(2, new List<int>(104, 105)));

  val ProtoMessage message = new ProtoMessage(fields);

  val Result<List<int>, ProtoError> encoded = encode_message(
    message,
    default_proto_encode_options()
  );
  require_true(encoded.is_err() == false, "Protobuf message must encode");

  val List<int> expected = new List<int>(8, 150, 1, 18, 2, 104, 105);
  val List<int> actual = encoded.unwrap();

  require_int(actual.length, expected.length, "Protobuf encoded length");
  let int i = 0;
  loop do
    if i >= expected.length then
      break;
    fi
    require_int(actual[i], expected[i], "Protobuf encoded byte mismatch");
    i = i + 1;
  done

  val Result<ProtoMessage, ProtoError> decoded = decode_message(
    actual,
    default_proto_decode_options()
  );
  require_true(decoded.is_err() == false, "Protobuf message must decode");

  val ProtoMessage roundtrip = decoded.unwrap();
  require_int(roundtrip.fields.length, 2, "Protobuf field count");
  require_int(roundtrip.fields[0].field_number, 1, "Protobuf field 1 number");
  require_int(roundtrip.fields[0].varint_value, 150, "Protobuf field 1 value");

  val List<ProtoField> field_two = fields_with_number(roundtrip, 2);
  require_int(field_two.length, 1, "Protobuf field lookup");
  require_int(field_two[0].payload.length, 2, "Protobuf length-delimited payload");

  // field 1 = uint64 max, encoded as ten varint bytes. It exceeds signed int,
  // so the raw wire bytes must be preserved exactly.
  val List<int> uint64_max = new List<int>(
    8,
    255, 255, 255, 255, 255, 255, 255, 255, 255, 1
  );

  val Result<ProtoMessage, ProtoError> raw_decoded = decode_message(
    rt borrow uint64_max,
    default_proto_decode_options()
  );
  require_true(raw_decoded.is_err() == false, "Protobuf uint64 max must decode as preserved raw varint");

  val ProtoMessage raw_roundtrip = raw_decoded.unwrap();
  val ProtoField raw_field = raw_roundtrip.fields[0];
  require_true(!raw_field.varint_fits_int, "uint64 max must not be narrowed into signed int");
  require_int(raw_field.payload.length, 10, "uint64 max raw varint byte count");

  val Result<List<int>, ProtoError> raw_reencoded = encode_message(
    raw_roundtrip,
    default_proto_encode_options()
  );
  require_true(raw_reencoded.is_err() == false, "preserved uint64 max must re-encode");

  val List<int> raw_bytes = raw_reencoded.unwrap();
  require_int(raw_bytes.length, uint64_max.length, "preserved uint64 max encoded length");

  let int j = 0;
  loop do
    if j >= uint64_max.length then
      break;
    fi
    require_int(raw_bytes[j], uint64_max[j], "preserved uint64 max byte mismatch");
    j = j + 1;
  done

  val Result<ProtoMessage, ProtoError> zero_field = decode_message(
    new List<int>(0),
    default_proto_decode_options()
  );
  require_true(zero_field.is_err(), "Protobuf field number zero must reject");

  val Result<ProtoMessage, ProtoError> overlong_varint = decode_message(
    new List<int>(
      8,
      128, 128, 128, 128, 128,
      128, 128, 128, 128, 128
    ),
    default_proto_decode_options()
  );
  require_true(overlong_varint.is_err(), "Protobuf varint continuation beyond ten bytes must reject");

  val Result<ProtoMessage, ProtoError> length_range = decode_message(
    new List<int>(
      18,
      255, 255, 255, 255, 255,
      255, 255, 255, 255, 1
    ),
    default_proto_decode_options()
  );
  require_true(length_range.is_err(), "Protobuf uint64 length above signed range must reject");

  val ProtoDecodeOptions tiny_input = new ProtoDecodeOptions(1, 16, 16);
  val Result<ProtoMessage, ProtoError> input_limited = decode_message(
    new List<int>(8, 1),
    tiny_input
  );
  require_true(input_limited.is_err(), "Protobuf max_input_bytes must fail closed");


  // Constructor byte lists are snapshots, not aliases of mutable caller input.
  val List<int> mutable_source = new List<int>(3, 7, 9, 11);
  val ProtoField copied_fixed = proto_fixed32(4, mutable_source);
  mutable_source.add(13);
  require_int(copied_fixed.payload.length, 4, "fixed32 constructor must snapshot byte source");
  require_int(copied_fixed.payload[3], 11, "fixed32 snapshot must not change");

  val List<int> raw_source = new List<int>(128, 1);
  val ProtoField copied_varint = proto_raw_varint(5, raw_source);
  raw_source.add(1);
  require_int(copied_varint.payload.length, 2, "raw varint constructor must snapshot byte source");

  // The maximum signed i64 uses exactly nine varint bytes, not ten.
  // This boundary must retain the exact integer, without overflow or narrowing.
  val Result<ProtoMessage, ProtoError> signed_max = decode_message(
    new List<int>(8, 255, 255, 255, 255, 255, 255, 255, 255, 127),
    default_proto_decode_options()
  );
  require_true(!signed_max.is_err(), "signed i64 max varint must decode");
  val ProtoMessage signed_max_message = signed_max.unwrap();
  require_true(signed_max_message.fields[0].varint_fits_int, "signed i64 max must fit int");
  require_int(signed_max_message.fields[0].varint_value, 9223372036854775807,
    "signed i64 max must be decoded exactly");

  // The reserved tag range is forbidden to *schema declarations* but remains
  // syntactically legal for unknown wire fields and must roundtrip.
  require_true(proto_descriptor_field_number_valid(18999),
    "ordinary descriptor number is legal");
  require_true(!proto_descriptor_field_number_valid(19000), "19000 must not be declared");
  require_true(!proto_descriptor_field_number_valid(19999), "19999 must not be declared");
  require_true(proto_descriptor_field_number_valid(20000), "20000 is allowed");
  val List<ProtoField> reserved_fields = new List<ProtoField>();
  reserved_fields.add(proto_varint(19000, 17));
  val Result<List<int>, ProtoError> reserved_wire = encode_message(
    new ProtoMessage(reserved_fields), default_proto_encode_options()
  );
  require_true(!reserved_wire.is_err(), "unknown reserved tag should pass wire-level encoding");
  val Result<ProtoMessage, ProtoError> reserved_parsed = decode_message(
    reserved_wire.unwrap(), default_proto_decode_options()
  );
  require_true(!reserved_parsed.is_err(), "unknown reserved tag should survive wire decoding");
  require_int(reserved_parsed.unwrap().fields[0].field_number, 19000,
    "unknown reserved tag must retain numeric identity");

  val Result<ProtoMessage, ProtoError> bad_tenth = decode_message(
    new List<int>(8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 2),
    default_proto_decode_options()
  );
  require_true(bad_tenth.is_err(), "tenth varint byte greater than 1 is overflow");

  val Result<ProtoMessage, ProtoError> bad_wire_type = decode_message(
    new List<int>(11, 1), default_proto_decode_options()
  );
  require_true(bad_wire_type.is_err(), "deprecated group wire type must reject");

  val List<ProtoField> bad_fixed_fields = new List<ProtoField>();
  bad_fixed_fields.add(proto_fixed32(1, new List<int>(1, 2, 3)));
  val Result<List<int>, ProtoError> bad_fixed = encode_message(
    new ProtoMessage(bad_fixed_fields), default_proto_encode_options()
  );
  require_true(bad_fixed.is_err(), "fixed32 must reject non-four-byte payload");

  val List<ProtoField> bad_raw_fields = new List<ProtoField>();
  bad_raw_fields.add(proto_raw_varint(1, new List<int>(128)));
  val Result<List<int>, ProtoError> bad_raw = encode_message(
    new ProtoMessage(bad_raw_fields), default_proto_encode_options()
  );
  require_true(bad_raw.is_err(), "unterminated raw varint must reject");

  val List<ProtoField> non_byte_fields = new List<ProtoField>();
  non_byte_fields.add(proto_bytes(1, new List<int>(20, 256)));
  val Result<List<int>, ProtoError> non_byte_encoded = encode_message(
    new ProtoMessage(non_byte_fields), default_proto_encode_options()
  );
  require_true(non_byte_encoded.is_err(), "non-byte payload must fail closed");

  val List<ProtoField> too_large_fields = new List<ProtoField>();
  too_large_fields.add(proto_bytes(1, new List<int>(1, 2, 3, 4)));
  val Result<List<int>, ProtoError> too_large_encoded = encode_message(
    new ProtoMessage(too_large_fields), new ProtoEncodeOptions(3)
  );
  require_true(too_large_encoded.is_err(), "payload budget must reject before output exposure");

  val Result<ProtoMessage, ProtoError> truncated_length = decode_message(
    new List<int>(10, 5, 1, 2), default_proto_decode_options()
  );
  require_true(truncated_length.is_err(), "truncated length-delimited input must reject");

  return;
}
