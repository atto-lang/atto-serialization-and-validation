import fnc require_true from './assert';
import class Utf8Text from '../src/core/value';
import fnc value_string, value_int from '../src/core/value';
import class ValidationOptions, ValidationReport from '../src/validation/validation';
import fnc report_is_valid from '../src/validation/validation';
import fnc refined_string_accepts, validate_refined_string, refined_string_schema_valid from '../src/validation/refined_string';

pub fnc run_refined_string_zorde_tests(): void {
  // Policy 1 = ASCII English letters [A-Za-z], length 2 through 4 inclusive.
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(65, 98))), 2, 4, 1),
    "A+b lowercase allowed by English letter policy");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(65, 49))), 2, 4, 1),
    "ASCII English letters must reject digits");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(65))), 2, 4, 1),
    "one letter shorter than minimum");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(65, 66, 67, 68, 69))), 2, 4, 1),
    "five letters longer than maximum");
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(65, 66))), 1, 4, 2),
    "ASCII uppercase");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(65, 98))), 1, 4, 2),
    "uppercase rejects lowercase");
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(97, 98))), 1, 4, 3),
    "ASCII lowercase");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(97, 66))), 1, 4, 3),
    "lowercase rejects uppercase");

  // Unicode length counts scalar values, not UTF-8 bytes or grapheme clusters.
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(240, 159, 152, 128))), 1, 1, 0),
    "emoji is one Unicode scalar, four bytes");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(240, 159, 152, 128))), 2, 2, 0),
    "emoji not two Unicode scalars");
  val List<int> decomposed_accent = new List<int>(101, 204, 129);
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(decomposed_accent)), 2, 2, 0),
    "e plus combining acute is two scalars");
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(228, 184, 173))), 1, 1, 0),
    "Han scalar counts as one");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(228, 184, 173))), 1, 1, 1),
    "ASCII letters reject Han");

  // Official Unicode 18.0 Script=Han ranges, including the non-BMP
  // extensions and precise gaps. No locale-based Chinese detection.
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(228, 184, 173))), 1, 1, 6),
    "Han 中 accepted exactly");
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(228, 184, 173, 230, 150, 135))), 2, 2, 6),
    "Han 中文 accepted as two scalars");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(228, 184, 173, 65))), 2, 2, 6),
    "Han rejects Latin letters");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(228, 184, 173, 239, 188, 140))), 2, 2, 6),
    "Han rejects fullwidth punctuation");
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(240, 160, 128, 128))), 1, 1, 6),
    "Han accepts first CJK Extension B scalar");
  imports::require_true(imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(240, 179, 145, 185))), 1, 1, 6),
    "Han includes upper end of last CJK range");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(240, 170, 155, 160))), 1, 1, 6),
    "Han must exclude gap after Extension B");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(240, 179, 145, 186))), 1, 1, 6),
    "Han must exclude scalar after last range");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(65, 66))), 1, 2, 4),
    "Unicode uppercase policy not approximated by ASCII");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(97, 98))), 1, 2, 5),
    "Unicode lowercase policy not approximated by ASCII");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(240, 159, 152, 128))), 1, 1, 6),
    "Han excludes emoji");

  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(192, 175))), 0, 5, 0),
    "overlong invalid UTF-8 rejected");
  imports::require_true(!imports::refined_string_accepts(imports::value_string(new Utf8Text(new List<int>(237, 160, 128))), 0, 5, 0),
    "UTF-8 surrogate codepoint rejected");
  imports::require_true(!imports::refined_string_accepts(imports::value_int(65), 0, 3, 0),
    "numeric value is not a string");
  imports::require_true(!imports::refined_string_schema_valid(4, 3, 1), "unsatisfiable interval");
  imports::require_true(!imports::refined_string_schema_valid(-1, 4, 0), "negative length");
  imports::require_true(!imports::refined_string_schema_valid(0, 4, 7), "unknown character policy");
  val ValidationReport zero_error_budget = imports::validate_refined_string(
    imports::value_string(new Utf8Text(new List<int>(65, 49))), 2, 4, 1, new ValidationOptions(true, 0)
  );
  imports::require_true(!imports::report_is_valid(zero_error_budget) && zero_error_budget.truncated,
    "zero error budget fails closed");
  return;
}
