import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, run_suite, require_success, fail from "ores.std/testing";
import fnc utf8_scalar_count from "../src/core/utf8_scalar";
fnc rejects_overlong_null_encoding(): TestOutcome {
  return imports::expect_equal_int(imports::utf8_scalar_count(arr[192, 128]), -1,
    "overlong UTF-8 NUL must be rejected");
}
fnc rejects_utf8_surrogate(): TestOutcome {
  return imports::expect_equal_int(imports::utf8_scalar_count(arr[237, 160, 128]), -1,
    "UTF-8 encoding of a surrogate scalar must be rejected");
}
fnc valid_utf8_four_byte_scalar(): TestOutcome {
  return imports::expect_equal_int(imports::utf8_scalar_count(arr[240, 159, 152, 128]), 1,
    "one valid four-byte Unicode code point is one scalar");
}

fnc rejects_truncated_multibyte_scalar(): TestOutcome {
  return imports::expect_equal_int(imports::utf8_scalar_count(arr[226, 130]), -1,
    "incomplete three-byte UTF-8 sequence must fail closed");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("utf8-scalar", arr[
    new TestCase("rejects_overlong_null_encoding", rejects_overlong_null_encoding, false, ""),
    new TestCase("rejects_utf8_surrogate", rejects_utf8_surrogate, false, ""),
    new TestCase("valid_utf8_four_byte_scalar", valid_utf8_four_byte_scalar, false, ""),
    new TestCase("rejects_truncated_multibyte_scalar", rejects_truncated_multibyte_scalar, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = imports::run_suite(rt borrow suite, rt borrow options);
  imports::require_success(rt borrow summary);
  return;
}
