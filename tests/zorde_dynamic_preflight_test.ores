// Dynamic Zorde admission must not accept malformed nested Values.
import fnc require_true from './assert';
import class Value, Utf8Text, WireMember, MapEntry from '../src/core/value';
import fnc value_int, value_string, value_array, value_object, value_map from '../src/core/value';
import class FieldRule, ObjectSchema, ValidationReport from '../src/validation/validation';
import fnc any_rule, object_schema, validate_value, validate_object, report_is_valid from '../src/validation/validation';
import fnc default_validation_options, max_validation_tree_depth, max_validation_collection_items from '../src/validation/validation';

pub fnc run_zorde_dynamic_preflight_tests(): void {
  val List<Value> good_values = new List<Value>();
  good_values.add(value_int(1));
  good_values.add(value_string(new Utf8Text(new List<int>(111, 107))));
  val ValidationReport good_report = validate_value(
    value_array(good_values), any_rule(), default_validation_options()
  );
  require_true(report_is_valid(rt borrow good_report),
    "valid nested data must remain admitted");

  val List<Value> bad_strings = new List<Value>();
  bad_strings.add(value_string(new Utf8Text(new List<int>(255))));
  val Value invalid_nested = value_array(bad_strings);
  require_true(!report_is_valid(validate_value(
    rt borrow invalid_nested, any_rule(), default_validation_options()
  )), "any_rule must not admit malformed nested UTF-8");

  val List<WireMember> open_members = new List<WireMember>();
  open_members.add(new WireMember(
    new Utf8Text(new List<int>(117, 110, 107, 110, 111, 119, 110)),
    invalid_nested
  ));
  val ObjectSchema open_schema = object_schema(new List<FieldRule>(), false);
  require_true(!report_is_valid(validate_object(
    value_object(open_members), rt borrow open_schema, default_validation_options()
  )), "open schema must reject malformed unknown field values");

  val List<WireMember> duplicate = new List<WireMember>();
  duplicate.add(new WireMember(new Utf8Text(new List<int>(97)), value_int(1)));
  duplicate.add(new WireMember(new Utf8Text(new List<int>(97)), value_int(2)));
  val List<Value> nested_duplicates = new List<Value>();
  nested_duplicates.add(value_object(duplicate));
  require_true(!report_is_valid(validate_value(
    value_array(nested_duplicates), any_rule(), default_validation_options()
  )), "any_rule must not admit duplicate keys in nested objects");

  val List<MapEntry> map_entries = new List<MapEntry>();
  map_entries.add(new MapEntry(
    value_string(new Utf8Text(new List<int>(255))), value_int(7)
  ));
  require_true(!report_is_valid(validate_value(
    value_map(map_entries), any_rule(), default_validation_options()
  )), "general-map keys must also pass nested UTF-8 checks");

  val List<Value> wide = new List<Value>();
  let int count = 0;
  loop do
    if count > max_validation_collection_items() then break; fi
    wide.add(value_int(count));
    count = count + 1;
  done
  require_true(!report_is_valid(validate_value(
    value_array(wide), any_rule(), default_validation_options()
  )), "oversized collection must fail before visiting all children");

  let Value deep = value_int(1);
  let int depth = 0;
  loop do
    if depth > max_validation_tree_depth() then break; fi
    val List<Value> next = new List<Value>();
    next.add(deep);
    deep = value_array(next);
    depth = depth + 1;
  done
  require_true(!report_is_valid(validate_value(
    deep, any_rule(), default_validation_options()
  )), "nested dynamic graph must obey a finite depth budget");
  return;
}
