import fnc require_true, require_int from './assert';

import class Utf8Text from '../src/core/value';
import fnc any_rule, string_rule, default_validation_options from '../src/validation/validation';
import class CodecFieldMeta, CodecTypeMeta, MetadataError from '../src/schema/metadata';
import fnc codec_field, codec_type from '../src/schema/metadata';
import class DecodeOptions from '../src/core/options';
import fnc default_decode_options from '../src/core/options';
import class DecodedObject, ObjectCodecError, ObjectDecodeAttempt from '../src/schema/object_codec';
import fnc decode_json_object, decode_json_object_attempt from '../src/schema/object_codec';

pub fnc run_object_codec_tests(): void {
  val List<CodecFieldMeta> fields = new List<CodecFieldMeta>();
  fields.add(
    codec_field(
      new Utf8Text(new List<int>(100, 105, 115, 112, 108, 97, 121, 95, 110, 97, 109, 101)),
      new Utf8Text(new List<int>(100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101)),
      1,
      true,
      string_rule(1, 120, false, false, false, false)
    )
  );
  fields.add(
    codec_field(
      new Utf8Text(new List<int>(97, 103, 101)),
      new Utf8Text(new List<int>(97, 103, 101)),
      2,
      true,
      any_rule()
    )
  );

  val CodecTypeMeta metadata = codec_type(
    new Utf8Text(new List<int>(85, 115, 101, 114)),
    fields,
    1
  );

  val List<int> input = new List<int>(
    123,
    34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34,
    58,
    34, 65, 108, 101, 120, 34,
    44,
    34, 97, 103, 101, 34,
    58,
    52, 50,
    125
  );

  val Result<DecodedObject, ObjectCodecError> decoded = decode_json_object(
    input,
    default_decode_options(),
    rt borrow metadata,
    default_validation_options()
  );
  require_true(decoded.is_err() == false, "metadata-driven JSON object must decode");
  val DecodedObject object = decoded.unwrap();
  require_int(object.source_object.object_value.length, 2, "source object field count");
  require_int(
    object.source_object.object_value[0].key.bytes[7],
    95,
    "wire displayName must rewrite to source display_name"
  );

  val List<int> unknown = new List<int>(
    123,
    34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34,
    58,
    34, 65, 108, 101, 120, 34,
    44,
    34, 97, 103, 101, 34,
    58,
    52, 50,
    44,
    34, 120, 34,
    58,
    49,
    125
  );

  val Result<DecodedObject, ObjectCodecError> rejected = decode_json_object(
    unknown,
    default_decode_options(),
    rt borrow metadata,
    default_validation_options()
  );
  require_true(rejected.is_err(), "reject-unknown metadata must reject unknown JSON fields");

  // A generic JSON decoder may resolve duplicate keys. The typed metadata
  // boundary must never silently discard conflicting bytes before validation.
  val List<int> duplicate_age = new List<int>(
    123,
    34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34,
    58, 34, 65, 108, 101, 120, 34,
    44, 34, 97, 103, 101, 34, 58, 52, 50,
    44, 34, 97, 103, 101, 34, 58, 52, 51,
    125
  );
  val ObjectDecodeAttempt strict_duplicate = decode_json_object_attempt(
    duplicate_age, default_decode_options(), rt borrow metadata,
    default_validation_options()
  );
  require_int(strict_duplicate.status, 2, "duplicate key must reject under strict policy");

  // JSON escape spellings must be compared after string decoding: "age"
  // and "ag\\u0065" are the same logical object key.
  val List<int> escaped_duplicate_age = new List<int>(
    123,
    34, 100, 105, 115, 112, 108, 97, 121, 78, 97, 109, 101, 34,
    58, 34, 65, 108, 101, 120, 34,
    44, 34, 97, 103, 101, 34, 58, 52, 50,
    44, 34, 97, 103, 92, 117, 48, 48, 54, 53, 34, 58, 52, 51,
    125
  );
  val ObjectDecodeAttempt escaped_duplicate = decode_json_object_attempt(
    escaped_duplicate_age, default_decode_options(), rt borrow metadata,
    default_validation_options()
  );
  require_int(escaped_duplicate.status, 2,
    "escaped-equivalent duplicate JSON keys must reject");
  require_int(escaped_duplicate.error.kind, 1,
    "escaped-equivalent duplicate is a parse failure");

  val DecodeOptions first_wins = new DecodeOptions(
    1, false, 128, 512, 512, 512, 512, 16, 16
  );
  val ObjectDecodeAttempt unsafe_first = decode_json_object_attempt(
    duplicate_age, first_wins, rt borrow metadata, default_validation_options()
  );
  require_int(unsafe_first.status, 2, "typed object admission must reject first-wins");
  require_int(unsafe_first.error.kind, 1, "unsafe policy is a decode failure");

  val DecodeOptions last_wins = new DecodeOptions(
    2, false, 128, 512, 512, 512, 512, 16, 16
  );
  val ObjectDecodeAttempt unsafe_last = decode_json_object_attempt(
    duplicate_age, last_wins, rt borrow metadata, default_validation_options()
  );
  require_int(unsafe_last.status, 2, "typed object admission must reject last-wins");

  // A valid JSON prefix followed by another token must not be admitted.
  let List<int> trailing_content = new List<int>();
  for const byte of input do
    trailing_content.push(byte);
  done
  trailing_content.push(32);
  trailing_content.push(116);
  trailing_content.push(114);
  trailing_content.push(117);
  trailing_content.push(101);

  val DecodeOptions allow_trailing = new DecodeOptions(
    0, true, 128, 512, 512, 512, 512, 16, 16
  );
  val ObjectDecodeAttempt unsafe_trailing = decode_json_object_attempt(
    trailing_content, allow_trailing, rt borrow metadata,
    default_validation_options()
  );
  require_int(unsafe_trailing.status, 2, "typed object admission must reject trailing-data policy");

  val Result<DecodedObject, ObjectCodecError> wrapper_reject = decode_json_object(
    input, allow_trailing, rt borrow metadata, default_validation_options()
  );
  require_true(wrapper_reject.is_err(), "Result wrapper must preserve unsafe-policy rejection");

  // Admission rejects unsafe policy configuration even when the payload
  // itself contains no duplicate fields or trailing bytes.
  val ObjectDecodeAttempt valid_first = decode_json_object_attempt(
    input, first_wins, rt borrow metadata, default_validation_options()
  );
  require_int(valid_first.status, 2, "first-wins must reject clean JSON too");
  require_int(valid_first.decoded.consumed, 0, "unsafe first-wins must not admit bytes");

  val ObjectDecodeAttempt valid_last = decode_json_object_attempt(
    input, last_wins, rt borrow metadata, default_validation_options()
  );
  require_int(valid_last.status, 2, "last-wins must reject clean JSON too");
  require_int(valid_last.error.kind, 1, "unsafe last-wins is a decode failure");

  val ObjectDecodeAttempt valid_trailing = decode_json_object_attempt(
    input, allow_trailing, rt borrow metadata, default_validation_options()
  );
  require_int(valid_trailing.status, 2, "allow-trailing must reject clean JSON too");

  // Strict full-message parsing must also refuse actual trailing tokens.
  val ObjectDecodeAttempt strict_trailing = decode_json_object_attempt(
    trailing_content, default_decode_options(), rt borrow metadata,
    default_validation_options()
  );
  require_int(strict_trailing.status, 2, "strict JSON parser rejects trailing token");
  require_int(strict_trailing.error.kind, 1, "trailing token is a decode failure");

  // Ordinary trailing JSON whitespace remains valid, fully consumed input.
  let List<int> whitespace_only = new List<int>();
  for const byte of input do
    whitespace_only.push(byte);
  done
  whitespace_only.push(32);
  whitespace_only.push(10);
  whitespace_only.push(13);
  whitespace_only.push(9);
  val ObjectDecodeAttempt strict_whitespace = decode_json_object_attempt(
    whitespace_only, default_decode_options(), rt borrow metadata,
    default_validation_options()
  );
  require_int(strict_whitespace.status, 0, "strict JSON permits trailing whitespace");
  require_int(strict_whitespace.decoded.consumed, whitespace_only.length,
    "strict JSON must consume all trailing whitespace");

  return;
}
