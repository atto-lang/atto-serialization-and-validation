// Regression coverage for the shared decimal serializer used by JSON,
// MessagePack and CBOR; must not overflow while encoding signed i64 minima.
import fnc require_true from './assert';
import fnc int_to_decimal_bytes, value_int, bytes_equal from '../src/core/value';

pub fnc run_decimal_codec_tests(): void {
  val int max_int = 9223372036854775807;
  val int min_int = 0 - max_int - 1;

  require_true(
    bytes_equal(int_to_decimal_bytes(0), new List<int>(48)),
    "decimal zero must be ASCII 0"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(7), new List<int>(55)),
    "positive single digit must be preserved"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(-7), new List<int>(45, 55)),
    "negative single digit must have one minus sign"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(12003), new List<int>(49, 50, 48, 48, 51)),
    "decimal conversion must preserve interior zero digits"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(-12003), new List<int>(45, 49, 50, 48, 48, 51)),
    "negative decimal conversion must preserve interior zero digits"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(max_int), new List<int>(
      57, 50, 50, 51, 51, 55, 50, 48, 51, 54,
      56, 53, 52, 55, 55, 53, 56, 48, 55
    )),
    "max int64 must encode as exact decimal digits"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(min_int), new List<int>(
      45, 57, 50, 50, 51, 51, 55, 50, 48, 51, 54,
      56, 53, 52, 55, 55, 53, 56, 48, 56
    )),
    "min int64 must encode without signed overflow"
  );
  require_true(
    bytes_equal(value_int(min_int).number_lexeme, int_to_decimal_bytes(min_int)),
    "dynamic Value integer must preserve the same decimal representation"
  );
  return;
}
