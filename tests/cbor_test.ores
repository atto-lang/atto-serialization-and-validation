import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember from '../src/core/value';
import fnc value_int, value_string, value_object, value_deep_equal, value_lookup_path from '../src/core/value';
import class DecodeOptions, DecodeError, EncodeError, DecodedValue from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import fnc encode, decode from '../src/cbor/cbor';

pub fnc run_cbor_tests(): void {
  val Result<DecodedValue, DecodeError> composite_dup = imports::decode(new List<int>(162,129,1,2,129,1,3), imports::default_decode_options());
  imports::require_true(composite_dup.is_err(), "equal composite keys must reject");
  imports::require_true(composite_dup.unwrap_err().code == "duplicate_key", "composite duplicate diagnostic");
  val Result<DecodedValue, DecodeError> composite_distinct = imports::decode(new List<int>(162,129,1,2,129,4,3), imports::default_decode_options());
  imports::require_true(!composite_distinct.is_err(), "distinct same-arity composite keys must decode");

  val List<WireMember> members = new List<WireMember>();
  members.add(
    new WireMember(
      new Utf8Text(new List<int>(110)),
      imports::value_int(-17)
    )
  );
  members.add(
    new WireMember(
      new Utf8Text(new List<int>(115)),
      imports::value_string(new Utf8Text(new List<int>(111, 107)))
    )
  );

  val Value source = imports::value_object(members);

  val Result<List<int>, EncodeError> encoded = imports::encode(
    rt borrow source,
    imports::default_encode_options()
  );
  imports::require_true(encoded.is_err() == false, "CBOR object must encode");

  val Result<DecodedValue, DecodeError> decoded = imports::decode(
    encoded.unwrap(),
    imports::default_decode_options()
  );
  imports::require_true(decoded.is_err() == false, "CBOR object must decode");
  imports::require_true(
    imports::value_deep_equal(source, decoded.unwrap().value),
    "CBOR dynamic value must round-trip without consuming source"
  );

  // 0x18 0x2a = unsigned integer 42.
  val Result<DecodedValue, DecodeError> forty_two = imports::decode(
    new List<int>(24, 42),
    imports::default_decode_options()
  );
  imports::require_true(forty_two.is_err() == false, "CBOR uint8 argument should decode");
  imports::require_int(forty_two.unwrap().value.kind, 2, "CBOR integer kind");

  // { 1: 2 } is a general CBOR map, not a JSON-shaped object.
  val Result<DecodedValue, DecodeError> general_map = imports::decode(
    new List<int>(161, 1, 2),
    imports::default_decode_options()
  );
  imports::require_true(general_map.is_err() == false, "CBOR integer-key map must decode");
  val DecodedValue general = general_map.unwrap();
  imports::require_int(general.value.kind, 8, "integer-key CBOR map kind");
  imports::require_int(general.value.map_value.length, 1, "integer-key CBOR map size");

  val Result<List<int>, EncodeError> general_map_encoded = imports::encode(
    general.value,
    imports::default_encode_options()
  );
  imports::require_true(general_map_encoded.is_err() == false, "CBOR general map must re-encode");
  imports::require_int(general_map_encoded.unwrap()[0], 161, "CBOR general map header");

  // map(2): { 1: 2, 1: 3 }
  val List<int> duplicate_map = new List<int>(162, 1, 2, 1, 3);
  val Result<DecodedValue, DecodeError> duplicate_reject = imports::decode(
    rt borrow duplicate_map,
    imports::default_decode_options()
  );
  imports::require_true(duplicate_reject.is_err(), "CBOR duplicate general-map keys must reject by default");

  val DecodeOptions duplicate_first = new DecodeOptions(
    1, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> first_wins = imports::decode(rt borrow duplicate_map, duplicate_first);
  imports::require_true(!first_wins.is_err(), "CBOR first-wins duplicate policy must decode");
  val DecodedValue first_value = first_wins.unwrap();
  imports::require_int(first_value.value.map_value.length, 1, "CBOR first-wins must keep one entry");
  imports::require_int(first_value.value.map_value[0].value.number_lexeme[0], 50, "CBOR first-wins must preserve first value");

  val DecodeOptions duplicate_last = new DecodeOptions(
    2, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> last_wins = imports::decode(rt borrow duplicate_map, duplicate_last);
  imports::require_true(!last_wins.is_err(), "CBOR last-wins duplicate policy must decode");
  val DecodedValue last_value = last_wins.unwrap();
  imports::require_int(last_value.value.map_value.length, 1, "CBOR last-wins must keep one entry");
  imports::require_int(last_value.value.map_value[0].value.number_lexeme[0], 51, "CBOR last-wins must preserve last value");

  val int min_int = -9223372036854775807 - 1;
  val int max_int = 9223372036854775807;

  val Result<List<int>, EncodeError> min_encoded = imports::encode(
    imports::value_int(min_int),
    imports::default_encode_options()
  );
  imports::require_true(min_encoded.is_err() == false, "CBOR int64 minimum must encode");
  val Result<DecodedValue, DecodeError> min_decoded = imports::decode(
    min_encoded.unwrap(),
    imports::default_decode_options()
  );
  imports::require_true(min_decoded.is_err() == false, "CBOR int64 minimum must decode");
  imports::require_true(
    imports::value_deep_equal(imports::value_int(min_int), min_decoded.unwrap().value),
    "CBOR int64 minimum must round-trip"
  );

  val Result<List<int>, EncodeError> max_encoded = imports::encode(
    imports::value_int(max_int),
    imports::default_encode_options()
  );
  imports::require_true(max_encoded.is_err() == false, "CBOR int64 maximum must encode");
  val Result<DecodedValue, DecodeError> max_decoded = imports::decode(
    max_encoded.unwrap(),
    imports::default_decode_options()
  );
  imports::require_true(max_decoded.is_err() == false, "CBOR int64 maximum must decode");
  imports::require_true(
    imports::value_deep_equal(imports::value_int(max_int), max_decoded.unwrap().value),
    "CBOR int64 maximum must round-trip"
  );

  val Result<DecodedValue, DecodeError> truncated = imports::decode(
    new List<int>(121, 0, 2, 97),
    imports::default_decode_options()
  );
  imports::require_true(truncated.is_err(), "CBOR truncated text must reject");

  val Result<DecodedValue, DecodeError> declared_length_bomb = imports::decode(
    new List<int>(122, 255, 255, 255, 255),
    imports::default_decode_options()
  );
  imports::require_true(
    declared_length_bomb.is_err(),
    "CBOR huge declared text length must reject before allocation"
  );

  val Result<DecodedValue, DecodeError> indefinite = imports::decode(
    new List<int>(159),
    imports::default_decode_options()
  );
  imports::require_true(indefinite.is_err(), "CBOR indefinite-length baseline must fail closed");

  val DecodeOptions tiny_input = new DecodeOptions(
    0, false, 128, 1, 16, 16, 16, 16, 16
  );
  val Result<DecodedValue, DecodeError> input_limited = imports::decode(
    new List<int>(24, 42),
    tiny_input
  );
  imports::require_true(input_limited.is_err(), "CBOR max_input_bytes must fail closed");

  return;
}
