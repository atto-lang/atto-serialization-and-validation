import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember from '../src/core/value';
import fnc bytes_equal, value_deep_equal, value_lookup_path, value_string, value_int, int_to_decimal_bytes from '../src/core/value';
import class DecodeOptions, EncodeOptions, DecodeError, EncodeError, DecodedValue, DecodeStep from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import class JsonIncrementalDecoder from '../src/json/json';
import fnc decode, decode_default, encode, new_incremental_decoder from '../src/json/json';
import fnc utf8_is_valid, utf8_codepoint_count from '../src/core/utf8';

// Freshly decoded fixtures ensure no ownership transfer of one nested Value
// is reused by a subsequent path lookup.
fnc new_nested_json_root(): Value {
  let Result<DecodedValue, DecodeError> decoded = decode_default(
    new List<int>(
      123, 34, 105, 116, 101, 109, 115, 34, 58, 91,
      123, 34, 109, 101, 116, 97, 34, 58, 91,
      123, 34, 102, 108, 97, 103, 34, 58, 116, 114, 117, 101, 125,
      93, 125, 93, 125
    )
  );
  return decoded.unwrap().value;
}

pub fnc run_json_tests(): void {
  // Regression for three-way merge corruption in decimal integer emission.
  require_true(
    bytes_equal(int_to_decimal_bytes(0), new List<int>(48)),
    "decimal 0 emits exactly one zero"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(-17), new List<int>(45, 49, 55)),
    "negative decimal preserves sign and digit order"
  );
  require_true(
    bytes_equal(
      int_to_decimal_bytes(9223372036854775807),
      new List<int>(57, 50, 50, 51, 51, 55, 50, 48, 51, 54, 56, 53, 52, 55, 55, 53, 56, 48, 55)
    ),
    "signed int64 maximum emits every digit"
  );
  require_true(
    bytes_equal(
      int_to_decimal_bytes(-9223372036854775807 - 1),
      new List<int>(45, 57, 50, 50, 51, 51, 55, 50, 48, 51, 54, 56, 53, 52, 55, 55, 56, 48, 56)
    ),
    "signed int64 minimum does not overflow on absolute value"
  );

  val List<int> input = new List<int>(
    123,
    34, 120, 34,
    58,
    91,
    49,
    44,
    116, 114, 117, 101,
    44,
    110, 117, 108, 108,
    93,
    125
  );

  val Result<DecodedValue, DecodeError> decoded_result = decode_default(rt borrow input);
  require_true(decoded_result.is_err() == false, "JSON object should decode");

  val DecodedValue decoded = decoded_result.unwrap();
  require_int(decoded.value.kind, 6, "JSON root must be object");
  require_int(decoded.value.object_value.size, 1, "JSON object must have one field");
  require_int(decoded.value.object_value[0].value.kind, 5, "x must decode as array");
  require_int(decoded.value.object_value[0].value.array_value.size, 3, "x array length");

  val Result<List<int>, EncodeError> encoded_result = encode(
    decoded.value,
    default_encode_options()
  );
  require_true(encoded_result.is_err() == false, "decoded JSON should re-encode");
  require_true(
    bytes_equal(
      encoded_result.unwrap(),
      new List<int>(123, 34, 120, 34, 58, 91, 49, 44,
        116, 114, 117, 101, 44, 110, 117, 108, 108, 93, 125)
    ),
    "canonical JSON should round-trip byte-for-byte"
  );

  val List<int> duplicate = new List<int>(
    123,
    34, 120, 34, 58, 49,
    44,
    34, 120, 34, 58, 50,
    125
  );
  val Result<DecodedValue, DecodeError> duplicate_result = decode_default(rt borrow duplicate);
  require_true(duplicate_result.is_err(), "duplicate JSON keys must reject by default");

  val DecodeOptions duplicate_first = new DecodeOptions(
    1, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> first_wins = decode(rt borrow duplicate, duplicate_first);
  require_true(!first_wins.is_err(), "JSON first-wins duplicate policy must decode");
  val DecodedValue first_value = first_wins.unwrap();
  require_int(first_value.value.object_value.size, 1, "JSON first-wins must keep one member");
  require_int(first_value.value.object_value[0].value.number_lexeme[0], 49, "JSON first-wins must preserve first value");

  val DecodeOptions duplicate_last = new DecodeOptions(
    2, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> last_wins = decode(rt borrow duplicate, duplicate_last);
  require_true(!last_wins.is_err(), "JSON last-wins duplicate policy must decode");
  val DecodedValue last_value = last_wins.unwrap();
  require_int(last_value.value.object_value.size, 1, "JSON last-wins must keep one member");
  require_int(last_value.value.object_value[0].value.number_lexeme[0], 50, "JSON last-wins must preserve last value");

  let mut JsonIncrementalDecoder decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep first = decoder.feed(new List<int>(123, 34, 120));
  require_int(first.status, 0, "partial JSON must request more input");

  val DecodeStep second = decoder.feed(
    new List<int>(34, 58, 49, 125)
  );
  require_int(second.status, 1, "completed incremental JSON must yield a value");
  require_int(second.value.kind, 6, "incremental JSON root kind");

  let mut JsonIncrementalDecoder number_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep number_partial = number_decoder.feed(new List<int>(49));
  require_int(number_partial.status, 0, "chunk-terminal JSON number must wait for finish or a delimiter");

  val DecodeStep number_finished = number_decoder.finish();
  require_int(number_finished.status, 1, "finish must publish a complete terminal JSON number");

  let mut JsonIncrementalDecoder bad_utf8_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep bad_utf8 = bad_utf8_decoder.feed(
    new List<int>(34, 226, 40)
  );
  require_int(
    bad_utf8.status,
    2,
    "invalid UTF-8 continuation must fail immediately even at a chunk boundary"
  );

  require_true(
    utf8_is_valid(new List<int>(240, 159, 152, 128)),
    "valid four-byte UTF-8 scalar must be accepted"
  );
  require_true(
    !utf8_is_valid(new List<int>(192, 128)),
    "overlong UTF-8 must be rejected"
  );
  require_int(
    utf8_codepoint_count(new List<int>(65, 240, 159, 152, 128)),
    2,
    "UTF-8 scan must count ASCII and multibyte scalar values once"
  );
  require_int(
    utf8_codepoint_count(new List<int>(237, 160, 128)),
    -1,
    "UTF-8 scan must reject a surrogate encoding"
  );
  require_true(
    !utf8_is_valid(new List<int>(244, 144, 128, 128)),
    "UTF-8 scan must reject codepoints above U+10FFFF"
  );
  require_true(
    !utf8_is_valid(new List<int>(240, 159, 152)),
    "UTF-8 scan must reject truncated four-byte sequences"
  );

  val DecodeOptions shallow = new DecodeOptions(
    0, false, 1, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> too_deep = decode(
    new List<int>(91, 91, 48, 93, 93),
    shallow
  );
  require_true(too_deep.is_err(), "JSON max_depth must reject before unbounded recursion");

  val DecodeOptions tiny_input = new DecodeOptions(
    0, false, 128, 1, 16, 16, 16, 16, 16
  );
  val Result<DecodedValue, DecodeError> input_limited = decode(
    new List<int>(91, 48, 93),
    tiny_input
  );
  require_true(input_limited.is_err(), "JSON max_input_bytes must fail closed");

  val DecodeOptions one_number_byte = new DecodeOptions(
    0, false, 128, 64, 64, 64, 1, 16, 16
  );
  val Result<DecodedValue, DecodeError> number_exact = decode(
    new List<int>(49),
    rt borrow one_number_byte
  );
  require_true(!number_exact.is_err(), "JSON number at max_number_bytes must succeed");

  val Result<DecodedValue, DecodeError> number_over = decode(
    new List<int>(49, 50),
    one_number_byte
  );
  require_true(number_over.is_err(), "JSON number over max_number_bytes must reject before growth");

  val DecodeOptions one_string_byte = new DecodeOptions(
    0, false, 128, 64, 1, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> string_exact = decode(
    new List<int>(34, 97, 34),
    rt borrow one_string_byte
  );
  require_true(!string_exact.is_err(), "JSON string at max_string_bytes must succeed");

  val Result<DecodedValue, DecodeError> utf8_over = decode(
    new List<int>(34, 195, 169, 34),
    rt borrow one_string_byte
  );
  require_true(utf8_over.is_err(), "JSON multibyte UTF-8 must preflight max_string_bytes");

  val Result<DecodedValue, DecodeError> escaped_utf8_over = decode(
    new List<int>(34, 92, 117, 48, 48, 101, 57, 34),
    one_string_byte
  );
  require_true(escaped_utf8_over.is_err(), "JSON Unicode escape must preflight encoded string bytes");

  // Unknown-schema objects remain navigable at arbitrary heterogeneous depths:
  // {"items":[{"meta":[{"flag":true}]}]}
  val Result<DecodedValue, DecodeError> deep_dynamic = decode_default(
    new List<int>(
      123, 34, 105, 116, 101, 109, 115, 34, 58, 91,
      123, 34, 109, 101, 116, 97, 34, 58, 91,
      123, 34, 102, 108, 97, 103, 34, 58, 116, 114, 117, 101, 125,
      93, 125, 93, 125
    )
  );
  require_true(!deep_dynamic.is_err(), "nested JSON dynamic tree must decode");
  val Value deep_root = deep_dynamic.unwrap().value;

  val List<Value> deep_path = new List<Value>();
  deep_path.add(value_string(new Utf8Text(new List<int>(105, 116, 101, 109, 115))));
  deep_path.add(value_int(0));
  deep_path.add(value_string(new Utf8Text(new List<int>(109, 101, 116, 97))));
  deep_path.add(value_int(0));
  deep_path.add(value_string(new Utf8Text(new List<int>(102, 108, 97, 103))));

  val Result<Value, String> dynamic_leaf = value_lookup_path(
    deep_root,
    deep_path
  );
  require_true(!dynamic_leaf.is_err(), "nested JSON path must resolve");
  require_true(dynamic_leaf.unwrap().bool_value, "nested JSON boolean payload");

  val List<Value> missing_path = new List<Value>();
  missing_path.add(value_string(new Utf8Text(new List<int>(109, 105, 115, 115, 105, 110, 103))));
  val Result<Value, String> missing = value_lookup_path(
    new_nested_json_root(),
    missing_path
  );
  require_true(missing.is_err(), "missing unknown-schema path must not panic");

  val List<Value> bad_index_path = new List<Value>();
  bad_index_path.add(value_string(new Utf8Text(new List<int>(105, 116, 101, 109, 115))));
  bad_index_path.add(value_int(-1));
  val Result<Value, String> bad_index = value_lookup_path(
    new_nested_json_root(),
    bad_index_path
  );
  require_true(bad_index.is_err(), "negative nested array index must reject");

  val List<Value> overlong_path = new List<Value>();
  let int path_index = 0;
  loop do
    if path_index >= 129 then
      break;
    fi
    overlong_path.add(value_int(0));
    path_index = path_index + 1;
  done
  val Result<Value, String> overlong = value_lookup_path(
    new_nested_json_root(),
    overlong_path
  );
  require_true(overlong.is_err(), "unbounded dynamic path must reject");


  // TJSV-facing negative wire corpus: an Oreslang decoder must never
  // silently accept malformed JSON that a Draft 2020-12 peer rejects.
  // These reject at the JSON syntax/Unicode boundary before schema validation.
  val Result<DecodedValue, DecodeError> trailing_array_comma =
    decode_default(new List<int>(91, 49, 44, 93));
  require_true(
    trailing_array_comma.is_err(),
    "array trailing comma must reject"
  );

  val Result<DecodedValue, DecodeError> trailing_object_comma =
    decode_default(new List<int>(123, 34, 120, 34, 58, 49, 44, 125));
  require_true(
    trailing_object_comma.is_err(),
    "object trailing comma must reject"
  );

  val Result<DecodedValue, DecodeError> leading_zero =
    decode_default(new List<int>(48, 49));
  require_true(leading_zero.is_err(), "JSON leading zero must reject");

  val Result<DecodedValue, DecodeError> non_finite_literal =
    decode_default(new List<int>(78, 97, 78));
  require_true(non_finite_literal.is_err(), "NaN token is not JSON");

  val Result<DecodedValue, DecodeError> invalid_escape =
    decode_default(new List<int>(34, 92, 113, 34));
  require_true(invalid_escape.is_err(), "unknown JSON escape must reject");

  val Result<DecodedValue, DecodeError> unpaired_high_surrogate =
    decode_default(new List<int>(34, 92, 117, 68, 56, 48, 48, 34));
  require_true(
    unpaired_high_surrogate.is_err(),
    "unpaired high surrogate must reject"
  );

  val Result<DecodedValue, DecodeError> unpaired_low_surrogate =
    decode_default(new List<int>(34, 92, 117, 68, 67, 48, 48, 34));
  require_true(
    unpaired_low_surrogate.is_err(),
    "unpaired low surrogate must reject"
  );

  val Result<DecodedValue, DecodeError> invalid_unicode_hex =
    decode_default(new List<int>(34, 92, 117, 90, 90, 90, 90, 34));
  require_true(
    invalid_unicode_hex.is_err(),
    "non-hex Unicode escape must reject"
  );

  val Result<DecodedValue, DecodeError> unescaped_control =
    decode_default(new List<int>(34, 10, 34));
  require_true(
    unescaped_control.is_err(),
    "raw control byte inside JSON string must reject"
  );

  val Result<DecodedValue, DecodeError> valid_surrogate_pair =
    decode_default(
      new List<int>(
        34, 92, 117, 68, 56, 51, 68,
        92, 117, 68, 69, 48, 48, 34
      )
    );
  require_true(
    !valid_surrogate_pair.is_err(),
    "valid UTF-16 surrogate pair escape must decode"
  );


  // UTF-8 scan state must resume precisely across arbitrary chunk boundaries.
  let mut JsonIncrementalDecoder unicode_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep unicode_prefix = unicode_decoder.feed(new List<int>(34, 240));
  require_int(unicode_prefix.status, 0, "split four-byte Unicode scalar needs more bytes");
  val DecodeStep unicode_middle = unicode_decoder.feed(new List<int>(159, 152));
  require_int(unicode_middle.status, 0, "split Unicode continuation remains incomplete");
  val DecodeStep unicode_end = unicode_decoder.feed(new List<int>(128, 34));
  require_int(unicode_end.status, 1, "valid split UTF-8 string must decode");

  let mut JsonIncrementalDecoder invalid_lead_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep invalid_lead = invalid_lead_decoder.feed(new List<int>(34, 192));
  require_int(invalid_lead.status, 2, "overlong UTF-8 lead byte must reject immediately");

  let mut JsonIncrementalDecoder invalid_surrogate_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep surrogate_prefix = invalid_surrogate_decoder.feed(new List<int>(34, 237));
  require_int(surrogate_prefix.status, 0, "split surrogate prefix awaits second byte");
  val DecodeStep surrogate_invalid = invalid_surrogate_decoder.feed(new List<int>(160));
  require_int(surrogate_invalid.status, 2, "UTF-8 surrogate must reject across chunks");

  let mut JsonIncrementalDecoder nested_invalid_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep nested_invalid = nested_invalid_decoder.feed(new List<int>(123, 34, 107, 34, 58, 34, 226, 40)
  );
  require_int(nested_invalid.status, 2, "malformed UTF-8 in nested string must reject early");

  let mut JsonIncrementalDecoder raw_control_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep raw_control = raw_control_decoder.feed(new List<int>(34, 10));
  require_int(raw_control.status, 2, "unescaped JSON control byte must reject immediately");
  return;
}
