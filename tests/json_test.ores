import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember from '../src/core/value';
import fnc bytes_equal, value_deep_equal, value_lookup_path, value_string, value_int, value_array, int_to_decimal_bytes from '../src/core/value';
import class DecodeOptions, EncodeOptions, DecodeError, EncodeError, DecodedValue, DecodeStep from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import class JsonIncrementalDecoder from '../src/json/json';
import fnc decode, decode_default, encode, new_incremental_decoder from '../src/json/json';
import fnc utf8_is_valid, utf8_codepoint_count from '../src/core/utf8';

// Freshly decoded fixtures ensure no ownership transfer of one nested Value
// is reused by a subsequent path lookup.
fnc new_nested_json_root(): Value {
  let Result<DecodedValue, DecodeError> decoded = decode_default(
    new List<int>(
      123, 34, 105, 116, 101, 109, 115, 34, 58, 91,
      123, 34, 109, 101, 116, 97, 34, 58, 91,
      123, 34, 102, 108, 97, 103, 34, 58, 116, 114, 117, 101, 125,
      93, 125, 93, 125
    )
  );
  return decoded.unwrap().value;
}

fnc json_work_object(int size): Value {
  val List<int> key = new List<int>();
  let int i = 0;
  loop do
    if i >= size then break; fi
    key.add(97);
    i = i + 1;
  done
  val List<WireMember> members = new List<WireMember>();
  members.add(new WireMember(new Utf8Text(key), value_int(1)));
  return value_object(members);
}

fnc json_work_graph(int second_size): Value {
  val List<Value> values = new List<Value>();
  values.add(json_work_object(499999));
  values.add(json_work_object(second_size));
  return value_array(values);
}

// Two object chunks, neither can be treated as its own independent frame.
fnc json_work_chunk(int size, bool first): List<int> {
  val List<int> chunk = new List<int>();
  if first then chunk.add(91); else chunk.add(44); fi
  chunk.add(123);
  chunk.add(34);
  let int i = 0;
  loop do
    if i >= size then break; fi
    chunk.add(97);
    i = i + 1;
  done
  chunk.add(34);
  chunk.add(58);
  chunk.add(49);
  chunk.add(125);
  if !first then chunk.add(93); fi
  return chunk;
}

fnc json_work_wire(int second_size): List<int> {
  val List<int> wire = json_work_chunk(499999, true);
  for const byte of json_work_chunk(second_size, false) do wire.add(byte); done
  return wire;
}

fnc json_nested_node_wire(bool over): List<int> {
  val List<int> wire = new List<int>();
  wire.add(91);
  let int group = 0;
  loop do
    if group >= 2 then break; fi
    if group > 0 then wire.add(44); fi
    wire.add(91);
    let int count = 32766;
    if group == 1 then count = 32767; fi
    if group == 1 && over then count = count + 1; fi
    let int i = 0;
    loop do
      if i >= count then break; fi
      if i > 0 then wire.add(44); fi
      wire.add(48);
      i = i + 1;
    done
    wire.add(93);
    group = group + 1;
  done
  wire.add(93);
  return wire;
}

fnc duplicate_occurrence_options(int policy): DecodeOptions {
  return new DecodeOptions(policy, false, 8, 256, 64, 64, 16, 16, 2);
}

pub fnc run_json_tests(): void {
  require_true(!decode_default(json_nested_node_wire(false)).is_err(),
    "JSON exact cumulative node count across nested arrays");
  require_true(decode_default(json_nested_node_wire(true)).is_err(),
    "JSON cumulative node count one over across nested arrays");
  // Two retained or discarded wire occurrences fit; a third must not evade
  // max_map_entries just because the repeated name has one retained slot.
  require_true(!decode(new List<int>(123,34,97,34,58,49,44,34,97,34,58,50,125),
    duplicate_occurrence_options(1)).is_err(), "first-wins exact occurrence limit");
  require_true(decode(new List<int>(123,34,97,34,58,49,44,34,97,34,58,50,44,34,97,34,58,51,125),
    duplicate_occurrence_options(1)).is_err(), "first-wins cannot evade occurrence limit");
  require_true(!decode(new List<int>(123,34,97,34,58,49,44,34,97,34,58,50,125),
    duplicate_occurrence_options(2)).is_err(), "last-wins exact occurrence limit");
  require_true(decode(new List<int>(123,34,97,34,58,49,44,34,97,34,58,50,44,34,97,34,58,51,125),
    duplicate_occurrence_options(2)).is_err(), "last-wins cannot evade occurrence limit");

  let JsonIncrementalDecoder sealed_decoder = new_incremental_decoder(default_decode_options());
  require_int(sealed_decoder.received_bytes(), 0, "fresh decoder has zero received bytes");
  require_int(sealed_decoder.feed(new List<int>(123)).status, 0, "partial sealed frame");
  require_int(sealed_decoder.received_bytes(), 1, "scalar received-byte observation");
  require_int(sealed_decoder.feed(new List<int>(125,32)).status, 1, "sealed frame completes");
  require_int(sealed_decoder.received_bytes(), 3, "received bytes include trailing whitespace");
  require_int(sealed_decoder.feed(new List<int>(123,125)).status, 2, "sealed terminal decoder rejects reuse");

  require_true(!encode(json_work_graph(499999), default_encode_options()).is_err(),
    "JSON writer exact shared key fuel");
  require_true(encode(json_work_graph(500000), default_encode_options()).is_err(),
    "JSON writer one over shared key fuel");
  require_true(!decode_default(json_work_wire(499999)).is_err(),
    "JSON reader exact shared key fuel");
  require_true(decode_default(json_work_wire(500000)).is_err(),
    "JSON reader one over shared key fuel");
  let JsonIncrementalDecoder budget_decoder = new_incremental_decoder(default_decode_options());
  require_int(budget_decoder.feed(json_work_chunk(499999, true)).status, 0,
    "first chunk is incomplete");
  val DecodeStep budget_error = budget_decoder.feed(json_work_chunk(500000, false));
  require_int(budget_error.status, 2, "second chunk cannot reset shared fuel");
  require_true(budget_error.error.code == "key_work_limit", "incremental error is budget refusal");
  val DecodeStep retry_error = budget_decoder.feed(new List<int>());
  require_true(retry_error.status == 2 && retry_error.error.code == "decoder_complete",
    "budget refusal is terminal, even on empty retry");
  require_int(budget_decoder.finish().status, 2, "finish cannot retry rejected frame");
  let JsonIncrementalDecoder exact_decoder = new_incremental_decoder(default_decode_options());
  require_int(exact_decoder.feed(json_work_chunk(499999, true)).status, 0,
    "exact split control begins incomplete");
  require_int(exact_decoder.feed(json_work_chunk(499999, false)).status, 1,
    "exact split control admits complete frame");

  val List<Value> nested_graph = new List<Value>();
  nested_graph.add(value_int(7));
  require_true(encode(value_array(nested_graph), new EncodeOptions(0,64)).is_err(),
    "JSON writer rejects child beyond depth");
  val List<Value> legal_graph = new List<Value>();
  legal_graph.add(value_int(7));
  require_true(!encode(value_array(legal_graph), new EncodeOptions(1,64)).is_err(),
    "JSON writer accepts legal depth control");

  // Regression for three-way merge corruption in decimal integer emission.
  require_true(
    bytes_equal(int_to_decimal_bytes(0), new List<int>(48)),
    "decimal 0 emits exactly one zero"
  );
  require_true(
    bytes_equal(int_to_decimal_bytes(-17), new List<int>(45, 49, 55)),
    "negative decimal preserves sign and digit order"
  );
  require_true(
    bytes_equal(
      int_to_decimal_bytes(9223372036854775807),
      new List<int>(57, 50, 50, 51, 51, 55, 50, 48, 51, 54, 56, 53, 52, 55, 55, 53, 56, 48, 55)
    ),
    "signed int64 maximum emits every digit"
  );
  require_true(
    bytes_equal(
      int_to_decimal_bytes(-9223372036854775807 - 1),
      new List<int>(45, 57, 50, 50, 51, 51, 55, 50, 48, 51, 54, 56, 53, 52, 55, 55, 56, 48, 56)
    ),
    "signed int64 minimum does not overflow on absolute value"
  );

  val List<int> input = new List<int>(
    123,
    34, 120, 34,
    58,
    91,
    49,
    44,
    116, 114, 117, 101,
    44,
    110, 117, 108, 108,
    93,
    125
  );

  val Result<DecodedValue, DecodeError> decoded_result = decode_default(rt borrow input);
  require_true(decoded_result.is_err() == false, "JSON object should decode");

  val DecodedValue decoded = decoded_result.unwrap();
  require_int(decoded.value.kind, 6, "JSON root must be object");
  require_int(decoded.value.object_value.length, 1, "JSON object must have one field");
  require_int(decoded.value.object_value[0].value.kind, 5, "x must decode as array");
  require_int(decoded.value.object_value[0].value.array_value.length, 3, "x array length");

  val Result<List<int>, EncodeError> encoded_result = encode(
    decoded.value,
    default_encode_options()
  );
  require_true(encoded_result.is_err() == false, "decoded JSON should re-encode");
  require_true(
    bytes_equal(
      encoded_result.unwrap(),
      new List<int>(123, 34, 120, 34, 58, 91, 49, 44,
        116, 114, 117, 101, 44, 110, 117, 108, 108, 93, 125)
    ),
    "canonical JSON should round-trip byte-for-byte"
  );

  val List<int> duplicate = new List<int>(
    123,
    34, 120, 34, 58, 49,
    44,
    34, 120, 34, 58, 50,
    125
  );
  val Result<DecodedValue, DecodeError> duplicate_result = decode_default(rt borrow duplicate);
  require_true(duplicate_result.is_err(), "duplicate JSON keys must reject by default");

  val DecodeOptions duplicate_first = new DecodeOptions(
    1, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> first_wins = decode(rt borrow duplicate, duplicate_first);
  require_true(!first_wins.is_err(), "JSON first-wins duplicate policy must decode");
  val DecodedValue first_value = first_wins.unwrap();
  require_int(first_value.value.object_value.length, 1, "JSON first-wins must keep one member");
  require_int(first_value.value.object_value[0].value.number_lexeme[0], 49, "JSON first-wins must preserve first value");

  val DecodeOptions duplicate_last = new DecodeOptions(
    2, false, 128, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> last_wins = decode(rt borrow duplicate, duplicate_last);
  require_true(!last_wins.is_err(), "JSON last-wins duplicate policy must decode");
  val DecodedValue last_value = last_wins.unwrap();
  require_int(last_value.value.object_value.length, 1, "JSON last-wins must keep one member");
  require_int(last_value.value.object_value[0].value.number_lexeme[0], 50, "JSON last-wins must preserve last value");

  let JsonIncrementalDecoder decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep first = decoder.feed(new List<int>(123, 34, 120));
  require_int(first.status, 0, "partial JSON must request more input");

  val DecodeStep second = decoder.feed(
    new List<int>(34, 58, 49, 125)
  );
  require_int(second.status, 1, "completed incremental JSON must yield a value");
  require_int(second.value.kind, 6, "incremental JSON root kind");

  let JsonIncrementalDecoder number_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep number_partial = number_decoder.feed(new List<int>(49));
  require_int(number_partial.status, 0, "chunk-terminal JSON number must wait for finish or a delimiter");

  val DecodeStep number_finished = number_decoder.finish();
  require_int(number_finished.status, 1, "finish must publish a complete terminal JSON number");

  val JsonIncrementalDecoder bad_utf8_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep bad_utf8 = bad_utf8_decoder.feed(
    new List<int>(34, 226, 40)
  );
  require_int(
    bad_utf8.status,
    2,
    "invalid UTF-8 continuation must fail immediately even at a chunk boundary"
  );

  require_true(
    utf8_is_valid(new List<int>(240, 159, 152, 128)),
    "valid four-byte UTF-8 scalar must be accepted"
  );
  require_true(
    !utf8_is_valid(new List<int>(192, 128)),
    "overlong UTF-8 must be rejected"
  );
  require_int(
    utf8_codepoint_count(new List<int>(65, 240, 159, 152, 128)),
    2,
    "UTF-8 scan must count ASCII and multibyte scalar values once"
  );
  require_int(
    utf8_codepoint_count(new List<int>(237, 160, 128)),
    -1,
    "UTF-8 scan must reject a surrogate encoding"
  );
  require_true(
    !utf8_is_valid(new List<int>(244, 144, 128, 128)),
    "UTF-8 scan must reject codepoints above U+10FFFF"
  );
  require_true(
    !utf8_is_valid(new List<int>(240, 159, 152)),
    "UTF-8 scan must reject truncated four-byte sequences"
  );

  val DecodeOptions shallow = new DecodeOptions(
    0, false, 1, 64, 64, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> too_deep = decode(
    new List<int>(91, 91, 48, 93, 93),
    shallow
  );
  require_true(too_deep.is_err(), "JSON max_depth must reject before unbounded recursion");

  val DecodeOptions tiny_input = new DecodeOptions(
    0, false, 128, 1, 16, 16, 16, 16, 16
  );
  val Result<DecodedValue, DecodeError> input_limited = decode(
    new List<int>(91, 48, 93),
    tiny_input
  );
  require_true(input_limited.is_err(), "JSON max_input_bytes must fail closed");

  val DecodeOptions one_number_byte = new DecodeOptions(
    0, false, 128, 64, 64, 64, 1, 16, 16
  );
  val Result<DecodedValue, DecodeError> number_exact = decode(
    new List<int>(49),
    rt borrow one_number_byte
  );
  require_true(!number_exact.is_err(), "JSON number at max_number_bytes must succeed");

  val Result<DecodedValue, DecodeError> number_over = decode(
    new List<int>(49, 50),
    one_number_byte
  );
  require_true(number_over.is_err(), "JSON number over max_number_bytes must reject before growth");

  val DecodeOptions one_string_byte = new DecodeOptions(
    0, false, 128, 64, 1, 64, 64, 16, 16
  );
  val Result<DecodedValue, DecodeError> string_exact = decode(
    new List<int>(34, 97, 34),
    rt borrow one_string_byte
  );
  require_true(!string_exact.is_err(), "JSON string at max_string_bytes must succeed");

  val Result<DecodedValue, DecodeError> utf8_over = decode(
    new List<int>(34, 195, 169, 34),
    rt borrow one_string_byte
  );
  require_true(utf8_over.is_err(), "JSON multibyte UTF-8 must preflight max_string_bytes");

  val Result<DecodedValue, DecodeError> escaped_utf8_over = decode(
    new List<int>(34, 92, 117, 48, 48, 101, 57, 34),
    one_string_byte
  );
  require_true(escaped_utf8_over.is_err(), "JSON Unicode escape must preflight encoded string bytes");

  // Native UTF-8 boundary cases independent of the JSON decoder.
  require_true(!utf8_is_valid(new List<int>(128)), "isolated continuation byte must reject");
  require_int(utf8_codepoint_count(new List<int>()), 0, "empty UTF-8 contains zero scalars");
  require_int(utf8_codepoint_count(new List<int>(195, 169)), 1, "two-byte UTF-8 counts as one scalar");
  require_true(!utf8_is_valid(new List<int>(255)), "0xFF is not a valid Unicode lead byte");
  require_int(utf8_codepoint_count(new List<int>(65, 66, 67)), 3, "three ASCII code points");
  return;
}
