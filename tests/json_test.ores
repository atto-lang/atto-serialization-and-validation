import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember from '../src/core/value';
import fnc bytes_equal, value_deep_equal, value_lookup_path, value_string, value_int from '../src/core/value';
import class DecodeOptions, EncodeOptions, DecodeError, EncodeError, DecodedValue, DecodeStep from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import class JsonIncrementalDecoder from '../src/json/json';
import fnc decode_default, encode, new_incremental_decoder, feed, finish from '../src/json/json';
import fnc utf8_is_valid from '../src/core/utf8';

// Freshly decoded fixtures ensure no ownership transfer of one nested Value
// is reused by a subsequent path lookup.
fnc new_nested_json_root(): Value {
  let Result<DecodedValue, DecodeError> decoded = decode_default(
    new List<int>(
      123, 34, 105, 116, 101, 109, 115, 34, 58, 91,
      123, 34, 109, 101, 116, 97, 34, 58, 91,
      123, 34, 102, 108, 97, 103, 34, 58, 116, 114, 117, 101, 125,
      93, 125, 93, 125
    )
  );
  return decoded.unwrap().value;
}

pub fnc run_json_tests(): void {
  val List<int> input = new List<int>(
    123,
    34, 120, 34,
    58,
    91,
    49,
    44,
    116, 114, 117, 101,
    44,
    110, 117, 108, 108,
    93,
    125
  );

  val Result<DecodedValue, DecodeError> decoded_result = decode_default(input);
  require_true(decoded_result.is_err() == false, "JSON object should decode");

  val DecodedValue decoded = decoded_result.unwrap();
  require_int(decoded.value.kind, 6, "JSON root must be object");
  require_int(decoded.value.object_value.length, 1, "JSON object must have one field");
  require_int(decoded.value.object_value[0].value.kind, 5, "x must decode as array");
  require_int(decoded.value.object_value[0].value.array_value.length, 3, "x array length");

  val Result<List<int>, EncodeError> encoded_result = encode(
    decoded.value,
    default_encode_options()
  );
  require_true(encoded_result.is_err() == false, "decoded JSON should re-encode");
  require_true(
    bytes_equal(
      encoded_result.unwrap(),
      new List<int>(123, 34, 120, 34, 58, 91, 49, 44, 116, 114, 117, 101, 44, 110, 117, 108, 108, 93, 125)
    ),
    "canonical JSON should round-trip byte-for-byte"
  );

  val List<int> duplicate = new List<int>(
    123,
    34, 120, 34, 58, 49,
    44,
    34, 120, 34, 58, 50,
    125
  );
  val Result<DecodedValue, DecodeError> duplicate_result = decode_default(duplicate);
  require_true(duplicate_result.is_err(), "duplicate JSON keys must reject by default");

  val JsonIncrementalDecoder decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep first = feed(rt borrow mut decoder, new List<int>(123, 34, 120));
  require_int(first.status, 0, "partial JSON must request more input");

  val DecodeStep second = feed(
    rt borrow mut decoder,
    new List<int>(34, 58, 49, 125)
  );
  require_int(second.status, 1, "completed incremental JSON must yield a value");
  require_int(second.value.kind, 6, "incremental JSON root kind");

  val JsonIncrementalDecoder number_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep number_partial = feed(rt borrow mut number_decoder, new List<int>(49));
  require_int(number_partial.status, 0, "chunk-terminal JSON number must wait for finish or a delimiter");

  val DecodeStep number_finished = finish(rt borrow mut number_decoder);
  require_int(number_finished.status, 1, "finish must publish a complete terminal JSON number");

  val JsonIncrementalDecoder bad_utf8_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep bad_utf8 = feed(
    rt borrow mut bad_utf8_decoder,
    new List<int>(34, 226, 40)
  );
  require_int(
    bad_utf8.status,
    2,
    "invalid UTF-8 continuation must fail immediately even at a chunk boundary"
  );

  require_true(
    utf8_is_valid(new List<int>(240, 159, 152, 128)),
    "valid four-byte UTF-8 scalar must be accepted"
  );
  require_true(
    !utf8_is_valid(new List<int>(192, 128)),
    "overlong UTF-8 must be rejected"
  );


  // Unknown-schema objects remain navigable at arbitrary heterogeneous depths:
  // {"items":[{"meta":[{"flag":true}]}]}
  val Result<DecodedValue, DecodeError> deep_dynamic = decode_default(
    new List<int>(
      123, 34, 105, 116, 101, 109, 115, 34, 58, 91,
      123, 34, 109, 101, 116, 97, 34, 58, 91,
      123, 34, 102, 108, 97, 103, 34, 58, 116, 114, 117, 101, 125,
      93, 125, 93, 125
    )
  );
  require_true(!deep_dynamic.is_err(), "nested JSON dynamic tree must decode");
  val Value deep_root = deep_dynamic.unwrap().value;

  let List<Value> deep_path = new List<Value>();
  deep_path.add(value_string(new Utf8Text(new List<int>(105, 116, 101, 109, 115))));
  deep_path.add(value_int(0));
  deep_path.add(value_string(new Utf8Text(new List<int>(109, 101, 116, 97))));
  deep_path.add(value_int(0));
  deep_path.add(value_string(new Utf8Text(new List<int>(102, 108, 97, 103))));

  val Result<Value, String> dynamic_leaf = value_lookup_path(
    deep_root,
    deep_path
  );
  require_true(!dynamic_leaf.is_err(), "nested JSON path must resolve");
  require_true(dynamic_leaf.unwrap().bool_value, "nested JSON boolean payload");

  let List<Value> missing_path = new List<Value>();
  missing_path.add(value_string(new Utf8Text(new List<int>(109, 105, 115, 115, 105, 110, 103))));
  val Result<Value, String> missing = value_lookup_path(
    new_nested_json_root(),
    missing_path
  );
  require_true(missing.is_err(), "missing unknown-schema path must not panic");

  let List<Value> bad_index_path = new List<Value>();
  bad_index_path.add(value_string(new Utf8Text(new List<int>(105, 116, 101, 109, 115))));
  bad_index_path.add(value_int(-1));
  val Result<Value, String> bad_index = value_lookup_path(
    new_nested_json_root(),
    bad_index_path
  );
  require_true(bad_index.is_err(), "negative nested array index must reject");

  let List<Value> overlong_path = new List<Value>();
  let int path_index = 0;
  loop do
    if path_index >= 129 then
      break;
    fi
    overlong_path.add(value_int(0));
    path_index = path_index + 1;
  done
  val Result<Value, String> overlong = value_lookup_path(
    new_nested_json_root(),
    overlong_path
  );
  require_true(overlong.is_err(), "unbounded dynamic path must reject");


  // UTF-8 scan state must resume precisely across arbitrary chunk boundaries.
  val JsonIncrementalDecoder unicode_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep unicode_prefix = feed(rt borrow mut unicode_decoder, new List<int>(34, 240));
  require_int(unicode_prefix.status, 0, "split four-byte Unicode scalar needs more bytes");
  val DecodeStep unicode_middle = feed(rt borrow mut unicode_decoder, new List<int>(159, 152));
  require_int(unicode_middle.status, 0, "split Unicode continuation remains incomplete");
  val DecodeStep unicode_end = feed(rt borrow mut unicode_decoder, new List<int>(128, 34));
  require_int(unicode_end.status, 1, "valid split UTF-8 string must decode");

  val JsonIncrementalDecoder invalid_lead_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep invalid_lead = feed(rt borrow mut invalid_lead_decoder, new List<int>(34, 192));
  require_int(invalid_lead.status, 2, "overlong UTF-8 lead byte must reject immediately");

  val JsonIncrementalDecoder invalid_surrogate_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep surrogate_prefix = feed(rt borrow mut invalid_surrogate_decoder, new List<int>(34, 237));
  require_int(surrogate_prefix.status, 0, "split surrogate prefix awaits second byte");
  val DecodeStep surrogate_invalid = feed(rt borrow mut invalid_surrogate_decoder, new List<int>(160));
  require_int(surrogate_invalid.status, 2, "UTF-8 surrogate must reject across chunks");

  val JsonIncrementalDecoder nested_invalid_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep nested_invalid = feed(
    rt borrow mut nested_invalid_decoder,
    new List<int>(123, 34, 107, 34, 58, 34, 226, 40)
  );
  require_int(nested_invalid.status, 2, "malformed UTF-8 in nested string must reject early");

  val JsonIncrementalDecoder raw_control_decoder = new_incremental_decoder(default_decode_options());
  val DecodeStep raw_control = feed(rt borrow mut raw_control_decoder, new List<int>(34, 10));
  require_int(raw_control.status, 2, "unescaped JSON control byte must reject immediately");
  return;
}
